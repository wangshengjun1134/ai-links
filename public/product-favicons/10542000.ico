                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item"><a class="nav-link" href="#features">Características</a></li>
                                <li class="nav-item"><a class="nav-link" href="#what-is">¿Qué Es?</a></li>
                                <li class="nav-item"><a class="nav-link" href="#how-to">Cómo Usar</a></li>
                                <li class="nav-item"><a class="nav-link" href="#why">¿Por qué?</a></li>
                                <li class="nav-item"><a class="nav-link" href="#faq">FAQ</a></li>
                                <li class="nav-item"><a class="nav-link btn btn-primary text-white ms-2" href="#demo-section">Probar Gratis</a></li>
