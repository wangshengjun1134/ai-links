9c.js\",\"3793\",\"static/chunks/3793-687622c695853b29.js\",\"454\",\"static/chunks/454-d3ca665f7be6a7af.js\",\"3185\",\"static/chunks/app/layout-fdd95225dd8ecc98.js\"],\"OutboundLinkTracker\"]\n14:I[6361,[],\"\"]\n"])</script><script>self.__next_f.push([1,"4:[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/9b7325e077167e96.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\"}]],[\"$\",\"$L5\",null,{\"buildId\":\"oYdLKF6lBSpsaE-7iwG-p\",\"assetPrefix\":\"\",\"initialCanonicalUrl\":\"/articles/amazing-photos-with-nextjs\",\"initialTree\":[\"\",{\"children\":[\"articles\",{\"children\":[\"amazing-photos-with-nextjs\",{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",true],\"initialSeedData\":[\"\",{\"children\":[\"articles\",{\"children\":[\"amazing-photos-with-nextjs\",{\"children\":[\"__PAGE__\",{},[\"$L6\",[\"$\",\"$L7\",null,{\"article\":{\"author\":\"Tom Dekan\",\"date\":\"2025-07-27T19:15:48.072Z\",\"title\":\"How I built a Next.js app that creates images of you using AI 🎨\",\"description\":\"Fast training, uncensored generation, free to try, open-source.\",\"tags\":[\"ai\",\"nextjs\",\"software\",\"open-source\"]},\"params\":{},\"searchParams\":{},\"children\":[[\"$\",\"p\",null,{\"children\":[\"I'm releasing \",[\"$\",\"a\",null,{\"href\":\"https://amazing.photos/\",\"children\":\"Amazing.photos\"}],\", an AI image generation tool built with Next.js - and completely open-source.  I'm excited to put an open-source project into the world!\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"w-full relative rounded-lg overflow-hidden transition-all duration-300 \",\"children\":[\"$\",\"$L8\",null,{\"height\":null,\"width\":null,\"html\":\"\u003clite-youtube videoid=\\\"hRRLdNYNiyU\\\" style=\\\"margin: 0 auto; width: 100%; border-radius: 1rem;\\\" params=\\\"rel=1\\\"\u003e\u003c/lite-youtube\u003e\",\"dataNtpc\":\"YouTubeEmbed\",\"children\":[[\"$\",\"$L9\",\"https://cdn.jsdelivr.net/gh/paulirish/lite-youtube-embed@master/src/lite-yt-embed.js\",{\"src\":\"https://cdn.jsdelivr.net/gh/paulirish/lite-youtube-embed@master/src/lite-yt-embed.js\",\"strategy\":\"lazyOnload\",\"stylesheets\":[\"https://cdn.jsdelivr.net/gh/paulirish/lite-youtube-embed@master/src/lite-yt-embed.css\"]}]]}]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"But I hear you say: \\\"aren't there \",[\"$\",\"strong\",null,{\"children\":\"loads\"}],\" of AI photo generators out there?\\\"\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Yes there are. Enough to fill a whole gallery of uncanny valley art.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"That said, here are some of \",[\"$\",\"a\",null,{\"href\":\"https://amazing.photos/\",\"children\":\"Amazing.photos\"}],\" distinguishing features:\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"distinguishing-features\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Distinguishing features\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"distinguishing-features\"}]]}],\"\\n\",[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":[\"📖 \",[\"$\",\"strong\",null,{\"children\":\"Open-source\"}],\": Completely open-source, MIT license. \",[\"$\",\"$Lb\",null,{\"id\":\"amazing-photos-github\",\"variant\":\"minimal\",\"url\":\"https://github.com/tomdekan/amazing_photos\",\"label\":\"See Amazing.photos on GitHub\"}]]}],[\"$\",\"p\",null,{\"children\":[\"💰 \",[\"$\",\"strong\",null,{\"children\":\"Free image generation\"}],\" using a full model (trained on me - so you can see what I'd look like as a taco 🌮)\"]}],[\"$\",\"p\",null,{\"children\":[\"🚀 \",[\"$\",\"strong\",null,{\"children\":\"Fast AI Training\"}],\": Personalized model in ~2 minutes using H100 GPUs\"]}],[\"$\",\"p\",null,{\"children\":[\"🔓 \",[\"$\",\"strong\",null,{\"children\":\"Uncensored\"}],\": No content restrictions on image generation. You decide what you want to generate.\"]}],[\"$\",\"p\",null,{\"children\":[\"💻 \",[\"$\",\"strong\",null,{\"children\":\"Run cloud or locally\"}],\": Try the cloud platform with pre-trained models without paying, or run it locally\"]}]]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"the-tech-stack\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"The Tech Stack 🥩\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"the-tech-stack\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Let’s get into the meat of the tech. Here's the complete technology stack I used:\\nThis stack is relatively simple, quick to host, and cheap to run.\"}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"my-6 overflow-x-auto\",\"children\":[\"$\",\"table\",null,{\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"children\":\"Category\"}],[\"$\",\"th\",null,{\"children\":\"Technology\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Frontend\"}]}],[\"$\",\"td\",null,{\"children\":\"Next.js, TypeScript, Tailwind CSS\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Authentication\"}]}],[\"$\",\"td\",null,{\"children\":\"Better Auth\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Payments\"}]}],[\"$\",\"td\",null,{\"children\":\"Stripe (because money is important)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"AI Training\"}]}],[\"$\",\"td\",null,{\"children\":\"Flux models (via Replicate)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Storage\"}]}],[\"$\",\"td\",null,{\"children\":\"Vercel Blob (sounds ugly, works well)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Database\"}]}],[\"$\",\"td\",null,{\"children\":\"Prisma\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Hosting\"}]}],[\"$\",\"td\",null,{\"children\":\"Vercel\"}]]}]]}]]}]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"The tech stack as a diagram:\\n\",[\"$\",\"$Lc\",null,{\"src\":\"/media/amazing-photos-with-nextjs/tech_stack_diagram.webp\",\"alt\":\"Tech stack diagram\",\"width\":800,\"height\":600,\"className\":\"mx-auto h-auto w-full max-w-2xl\",\"quality\":90}]]}],\"\\n\",[\"$\",\"h3\",null,{\"id\":\"a-criticism-of-next-js\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"A criticism of Next.js\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"a-criticism-of-next-js\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"I'm critical of Next.js at the moment (App Router).\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"I've spent a lot of time building with Next.js (App Router), including our startup's app over the past year. I'm now unenthusiastic about using Next.js for future products.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Even in my small amazing.photos codebase, the developer experience worsened quickly after my app grew and Next's hot-module reloading started to slow.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"This led to 5 second delays on most page loads in my very small codebase when developing.\\nDev environment speed is a very important factor for me. Next.js is not the best for this.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"For next time, I'll likely use Django Ninja + Pyright for strong typed python + React.\\nMy free guide to create an app using this stack (excluding the typing) is here: \",[\"$\",\"a\",null,{\"href\":\"https://www.photondesigner.com/articles/ninja-react\",\"children\":\"Use React with Django Ninja (including Auth) in 15 mins ⚡️\"}],\".\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"how-does-amazing-photos-work\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"How does amazing.photos work?\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"how-does-amazing-photos-work\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The workflow is straightforward:\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"$\",\"$Lc\",null,{\"src\":\"/media/amazing-photos-with-nextjs/user_flow_sequence_diagram.webp\",\"alt\":\"User flow sequence diagram\",\"width\":800,\"height\":600,\"className\":\"mx-auto h-auto w-full max-w-2xl\",\"quality\":90}]}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"User uploads photos\"}],\": A user logs in using Google sign-in and uploads at least 5 photos of themselves (\u003e20 photos is better - the AI needs choices, like a picky art critic)\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"AI model training\"}],\": I send the photos to Replicate to train the Flux fast trainer model (where the magic happens, aka expensive GPU time)\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Training completion webhook\"}],\": Once training is finished, Replicate sends a webhook to my backend\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Sample generation\"}],\": The backend generates about 12 free images of the user as samples\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Email notification\"}],\": The backend emails the user with these sample images and a link to access their personalized model\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Custom generation\"}],\": Users can view the initial images and generate new ones using any custom prompts they like\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"To train a different model, users just repeat the process.\"}],\"\\n\",[\"$\",\"h3\",null,{\"id\":\"how-does-payment-work\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"How does payment work?\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"how-does-payment-work\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"The app uses Stripe for payments. I created a tutorial here: \",[\"$\",\"a\",null,{\"href\":\"https://www.photondesigner.com/articles/stripe-with-nextjs\",\"children\":\"How to add Stripe to Next.js in 5 minutes 💰\"}],\".\"]}],\"\\n\",[\"$\",\"h3\",null,{\"id\":\"how-does-authentication-work\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"How does authentication work?\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"how-does-authentication-work\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"The app uses Google sign-in for auth, with Better Auth (which I highly recommend). See my guide here: \",[\"$\",\"a\",null,{\"href\":\"https://www.photondesigner.com/articles/google-sign-in-nextjs\",\"children\":\"The simplest way to add Google sign-in to your Next.js app\"}],\".\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"current-limitations-and-improvements\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Current limitations and improvements\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"current-limitations-and-improvements\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Things to improve:\"}]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Parallelize generation\"}],\": Generation is currently synchronous, meaning users can only generate one image at a time, which takes about 20 seconds (close to eternity in internet time, I know - it's on the list)\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"development-notes\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Development notes\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"development-notes\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The UI was built with a mix of my own coding and AI assistance. While AI coding is very fast, it can make significant mistakes, so it's important to act as the architect guiding the process rather than blindly accepting its output.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"As it's open source, feel free to fork it and submit a pull request for any cool features.\"}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"app-and-code\",\"className\":\"group flex items-center\",\"children\":[[\"$\",\"span\",null,{\"children\":\"App and code\"}],[\"$\",\"$La\",null,{\"textToCopy\":\"app-and-code\"}]]}],\"\\n\",[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":[\"Try the app here:\\n\",[\"$\",\"a\",null,{\"href\":\"https://amazing.photos/\",\"children\":\"https://amazing.photos/\"}]]}],[\"$\",\"p\",null,{\"children\":[\"See the code here: \",[\"$\",\"$Lb\",null,{\"variant\":\"minimal\",\"url\":\"https://github.com/tomdekan/amazing_photos\",\"label\":\"View Amazing.photos GitHub\"}]]}]]}]]}],null]]},[\"$\",\"$Ld\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"articles\",\"children\",\"amazing-photos-with-nextjs\",\"children\"],\"loading\":\"$undefined\",\"loadingStyles\":\"$undefined\",\"loadingScripts\":\"$undefined\",\"hasLoading\":false,\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$Le\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\",\"styles\":null}]]},[\"$\",\"$Ld\",null,{\"parallelRouterKey\":\"children\",\