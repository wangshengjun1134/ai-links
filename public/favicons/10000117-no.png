<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="OneStory" />
    <link rel="icon" type="images/svg+xml" href="/createone.ico" />
    <meta name="theme-color" content="#7F56D9" />
    <meta name="keywords" content="创壹，OneStory，AI故事生成助手">
    <meta name="description" content="OneStory 是一款创新的AI故事生成助手，用AI快速生成连续性、一致性的角色和故事。">
    <title>OneStory</title>
    <style>
      .loader {
          border: 2px solid #f3f3f3; /* Light grey */
          border-top: 2px solid #7F56D9; /* Blue */
          border-radius: 50%;
          width: 20px;
          height: 20px;
          animation: spin 2s linear infinite;
        }

        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
    </style>
    <script type="text/javascript" src="https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js"></script>
    <!-- 百度统计 -->
    <script>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?26f513fb9586da8472f4b91c21144515";
        var s = document.getElementsByTagName("script")[0]; 
        s.parentNode.insertBefore(hm, s);
      })();
      </script>
    <script type="module" crossorigin src="/assets/index-BYW3aTQ5.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-lF3cfRNp.css">
  </head>
  <body>
    <div id="loading" style="position:fixed;top:0;left:0;width:100%;height:100%;background-color:white;z-index:99;display:flex;justify-content:center;align-items:center;">
      <div class="loader"></div>
    </div>
    
    <div id="root"></div>

    <script>
      // 当React加载完成后，隐藏加载指示器
      document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('loading').style.display = 'none';
      });
    </script>
  </body>
</html>
