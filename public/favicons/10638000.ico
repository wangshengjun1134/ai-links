="12" x="2" y="6" rx="2" ry="2"></rect></svg>Text to Video</button><button type="button" role="radio" aria-checked="false" class="flex-1 flex items-center justify-center px-3 py-3 rounded-lg border transition-all text-sm min-h-[44px] border-airbnb-border bg-white text-airbnb-medium hover:border-airbnb-primary/50"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image w-4 h-4 mr-1.5" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>Image to Video</button></div></fieldset><div class="space-y-2"><label for="video-prompt" class="block text-xs font-medium text-airbnb-dark text-left">Video Description</label><textarea id="video-prompt" placeholder="Describe the video you want to generate..." rows="3" class="w-full px-3 py-2 bg-white border border-airbnb-border rounded-lg focus:ring-2 focus:ring-airbnb-primary focus:border-transparent text-sm text-airbnb-dark placeholder-airbnb-medium resize-none shadow-sm"></textarea><div class="text-left text-xs text-airbnb-medium">0<!-- -->/500 characters</div></div><div class="border border-airbnb-border rounded-lg"><button type="button" class="w-full flex items-center justify-between px-3 py-3 text-left transition-colors min-h-[44px] cursor-pointer bg-white hover:bg-neutral-50"><div class="flex items-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings w-4 h-4 mr-1.5 text-airbnb-dark"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.