 Tip\",\"proTipContent\":\"For best results, use a high-quality product image with a clean background. The AI will automatically blend it into the scene.\",\"required\":\"Required\",\"fileSizeError\":\"File size must be less than 10MB\",\"fileTypeError\":\"Only JPG, PNG, and WEBP images are supported\",\"uploadError\":\"Failed to upload image. Please try again.\",\"generateSuccess\":\"Generation started! Assets added to canvas.\",\"generateError\":\"Failed to start generation. Please try again.\",\"noAssetsWarning\":\"No assets returned from generation.\",\"productImage\":\"Product Image\"},\"errors\":{\"loadConfigFailed\":\"Failed to load AI App configuration\",\"parseConfigFailed\":\"Failed to parse template configuration, please contact administrator\",\"configMissing\":\"Template configuration is missing, please select another template\",\"missingRequired\":\"Please fill in required fields: {fields}\"},\"upload\":{\"success\":\"Image uploaded successfully\",\"failed\":\"Image upload failed, please retry\",\"invalidFileType\":\"Please select a valid image file (JPEG, PNG, WebP)\",\"fileTooLarge\":\"Image size cannot exceed 10MB\"},\"aiApp\":{\"badge\":\"AI App\",\"inputPlaceholder\":\"Enter {label}\",\"selectPlaceholder\":\"Select {label}\",\"execute\":\"Execute\",\"executing\":\"Executing...\",\"failed\":\"Execution failed, please retry\",\"completed\":\"Execution completed, added to canvas\",\"submitSuccess\":\"AI App submitted, please wait...\",\"noConfigFound\":\"Configuration not found\",\"selectOptionPlaceholder\":\"Select an option\"},\"carousel\":{\"previousCover\":\"Previous cover\",\"nextCover\":\"Next cover\",\"jumpToCover\":\"Jump to cover {index}\",\"noPreview\":\"No Preview\"}},\"Landing\":{\"Hero\":{\"titlePrefix\":\"Great Creative, \",\"titleHighlight\":\"Growing Great Business\",\"subtitle\":\"An AI creative and compliance workspace for global ad asset creation, review and management.\",\"cta\":\"Start for Free\"},\"Header\":{\"home\":\"Home\",\"features\":\"Features\",\"tools\":\"Tools\",\"scenarios\":\"Use Cases\",\"cases\":\"Showcase\",\"login\":\"Login / Sign Up\",\"menu\":\"Menu\"},\"Feature\":{\"title\":\"Check · Optimize · Create\",\"description\":\"FastGrow provides a full-link solution from asset production and compliance pre-check to violation repair.\",\"compliance\":{\"title\":\"Compliance Check Layer\",\"description\":\"Pre-check anytime. Know risks in 3 mins. Scan all assets, locate risks by policy, get PDF reports.\"},\"optimization\":{\"title\":\"Smart Optimization Layer\",\"description\":\"Violations found? Quick fix with tool matrix. Generate compliant versions while keeping selling points.\"},\"creative\":{\"title\":\"Creative Collaboration Layer\",\"description\":\"Production with built-in compliance guardrails. Complete creative toolchain considering platform rules.\"},\"cta\":\"Try Now\"},\"Tool\":{\"title\":\"Tool Matrix · Modular \u0026 Flexible\",\"description\":\"FastGrow breaks down complex workflows into three professional layers. Use them individually or combine them to build your automated pipeline.\",\"groups\":{\"detection\":{\"title\":\"Detection\",\"description\":\"Pre-check Anytime · Risk Check in 3 Mins\",\"items\":{\"0\":{\"name\":\"Pre-Launch Check\",\"description\":\"Compliance check for ad copy, images, and videos with suggestions based on major platform policies.\"},\"1\":{\"name\":\"DTC Search \u0026 Social Ads\",\"description\":\"DTC search ads and social ads optimization and promotion analysis.\"},\"2\":{\"name\":\"Pre-Launch Check\",\"description\":\"Simulate real review process, predict approval probability.\"},\"3\":{\"name\":\"Video Optimization\",\"description\":\"Frame-level analysis, pinpointing violating segments.\"}}},\"optimization\":{\"title\":\"Optimization\",\"description\":\"Fix Violations · One-click Repair\",\"items\":{\"0\":{\"name\":\"AI Image Gen\",\"description\":\"Generate high-quality, copyright-free commercial assets.\"},\"1\":{\"name\":\"Video Generation\",\"description\":\"One-click short video generation, avoiding sensitive visuals.\"},\"2\":{\"name\":\"Multilingual Translation\",\"description\":\"Precise translation, adapting to cultural taboos.\"},\"3\":{\"name\":\"AI Copy Rewrite\",\"description\":\"Smart replacement of sensitive words, keeping selling points.\"}}},\"creative\":{\"title\":\"Creative\",\"description\":\"Source Production · Built-in Guardrails\",\"items\":{\"0\":{\"name\":\"AI Script Gen\",\"description\":\"Generate high-conversion scripts with built-in compliance.\"},\"1\":{\"name\":\"TTS Voiceover\",\"description\":\"Natural, realistic multilingual voiceovers with emotion.\"},\"2\":{\"name\":\"Voice Cloning\",\"description\":\"Clone brand voices, maintaining global consistency.\"},\"3\":{\"name\":\"Creative Studio\",\"description\":\"Full-featured online editor for real-time team collaboration.\"}}}}},\"Trust\":{\"title\":\"Data Speaks · Trusted by Leaders\",\"description\":\"Proven by real business data, fully compliant with GDPR, SOC2, and global privacy standards.\",\"items\":{\"0\":{\"title\":\"10M+\",\"subtitle\":\"Assets Checked\",\"description\":\"Over 10 million ad assets checked for global enterprises, covering images, videos, copy, and landing pages.\"},\"1\":{\"title\":\"99.2%\",\"subtitle\":\"Accuracy Rate\",\"description\":\"Trained on millions of real audit cases with real-time policy updates. Results highly consistent with platform reviews.\"},\"2\":{\"title\":\"50+\",\"subtitle\":\"Platforms Supported\",\"description\":\"Covering Meta, Google, TikTok, Snapchat, and 200+ regional policy sets.\"}}},\"Model\":{\"title\":\"Top AI Models\",\"subtitle\":\"Driving Compliant Creativity\",\"description\":\"We integrate the world's best AI models, including Sora 2, Veo 3.1, GPT. From fixing violations to generating compliant creatives from scratch, we handle it all.\",\"items\":{\"0\":{\"description\":\"OpenAI's strongest video model, cinematic quality, ideal for high-end brand ads.\",\"badge\":\"Hot\"},\"1\":{\"description\":\"Google multimodal video model, audio-visual sync, perfect for voiced ad assets.\"},\"2\":{\"description\":\"Image editing with GPT reasoning, precisely fixing violations while keeping creative integrity.\"},\"3\":{\"description\":\"Context-aware image generation, automatically adapting to brand tone.\"},\"4\":{\"description\":\"Professional camera movement control, consistent multi-style output for series ads.\"},\"5\":{\"description\":\"Coherent multi-shot storytelling, high character/scene consistency for brand stories.\"},\"6\":{\"description\":\"Complex action sequence generation, strong dynamic consistency for product demos.\"},\"7\":{\"description\":\"Modular all-round video model, fine-grained control for professional output.\"},\"8\":{\"description\":\"High-precision image editing, local modification without distortion.\"},\"9\":{\"description\":\"Style transfer \u0026 reconstruction expert, avoiding copyright risks.\"}}},\"Agent\":{\"title\":\"Who Uses FastGrow\",\"description\":\"Whether you are an e-commerce seller, agency, or brand, find your compliance solution.\",\"items\":{\"0\":{\"title\":\"Cross-border E-commerce / DTC Teams\",\"description\":\"Localization before launch. Ensure assets meet local culture and laws, avoiding takedowns due to cultural conflicts.\"},\"1\":{\"title\":\"Agencies / Ad Service Providers\",\"description\":\"Batch pre-check \u0026 fix. Provide value-added services, reducing account bans and boosting client satisfaction.\"},\"2\":{\"title\":\"Enterprise Growth / Compliance Teams\",\"description\":\"Unified management for multi-brand/account. Establish enterprise risk standards and manage assets across lines.\"}}},\"Template\":{\"title\":\"Platform-Friendly Creative Wall\",\"description\":\"Showcasing compliant creative examples in real ad contexts, covering TikTok, Meta, Google Ads, and various industries.\",\"industries\":{\"AppInstall\":\"App Install\",\"Education\":\"Education\",\"SaaS\":\"SaaS\",\"Tools\":\"Tools\",\"Beauty\":\"Beauty\",\"Ecommerce\":\"E-commerce\",\"Fashion\":\"Fashion\",\"Game\":\"Gaming\",\"Home\":\"Home\",\"Fitness\":\"Fitness\"},\"goals\":{\"AppInstall\":\"App Install\",\"LeadGen\":\"Lead Gen\",\"Conversion\":\"Conversion\",\"AddToCart\":\"Add to Cart\",\"SignUp\":\"Sign Up\"},\"verified\":\"Approved by {platform}\"},\"Testimonial\":{\"title\":\"They Are All Using FastGrow\",\"description\":\"Hear what e-commerce sellers, agencies, and brand teams say about our compliance and creative tools.\",\"items\":{\"0\":{\"name\":\"Chen Ming\",\"role\":\"Head of E-commerce\",\"content\":\"Ad rejection rate dropped from 35% to 5% after using FastGrow. We used to spend hours on rejected assets, now one-click check finds issues early.\"},\"1\":{\"name\":\"Wang Xue\",\"role\":\"Agency Operations Director\",\"content\":\"Batch pre-check is powerful! Checked hundreds of assets in 3 mins. Client satisfaction maxed out, renewal rate up 40%.\"},\"2\":{\"name\":\"Wu Kai\",\"role\":\"Brand Compliance Manager\",\"content\":\"Most complete rule library I've seen. Meta, Google, TikTok updates are synced immediately. No more manual tracking.\"},\"3\":{\"name\":\"Zhang Lin\",\"role\":\"DTC Seller\",\"content\":\"Launching in new markets used to be risky with cultural taboos. FastGrow's localization check helps me avoid many pitfalls.\"},\"4\":{\"name\":\"Li Tao\",\"role\":\"Creative Director\",\"content\":\"Platform recommends compliant alternatives and AI tools right after detection. The fix flow shortened by 80%.\"},\"5\":{\"name\":\"Zhao Min\",\"role\":\"E-com Ops Expert\",\"content\":\"AI script generation has built-in guardrails. Content is ready to use. No more worries about stepping on red lines, 3x efficiency.\"},\"6\":{\"name\":\"Liu Yang\",\"role\":\"Agency Founder\",\"content\":\"Offering FastGrow as a value-add clearly differentiated us. Now clients ask us for compliance reports proactively.\"},\"7\":{\"name\":\"Zhou Ting\",\"role\":\"Brand Overseas Head\",\"content\":\"Unified management is so useful. Assets from 5 brand lines are audited in one platform. Risk standards finally unified.\"},\"8\":{\"name\":\"Sun Lei\",\"role\":\"Growth Lead\",\"content\":\"3x efficiency is real. Assets take half a day from production to launch now, with compliance endorsement.\"},\"9\":{\"name\":\"Lin Yuan\",\"role\":\"Tech Marketing Head\",\"content\":\"Compliance was the biggest headache. FastGrow's multi-region check lets us scale ads confidently. ROI up 60%.\"},\"10\":{\"name\":\"Huang Lei\",\"role\":\"Game Publishing Lead\",\"content\":\"Game ad audits are strict. FastGrow pre-check doubled our success rate. Team finally stopped working overtime on fixes.\"},\"11\":{\"name\":\"Yang Wei\",\"role\":\"Brand CMO\",\"content\":\"FastGrow helped us establish a global unified brand compliance standard. Consistent quality control across 5 markets.\"}}},\"Footer\":{\"description\":\"Compliance-First AI Creative Platform. From asset check, violation repair to creative generation, we solve ad compliance end-to-end.\",\"contact\":\"Contact Us\",\"columns\":{\"compliance\":\"Compliance Check\",\"creative\":\"AI Creative Tools\",\"about\":\"About Us\"},\"links\":{\"adText\":\"Pre-Launch Check\",\"landingPage\":\"DTC Search \u0026 Social Ads\",\"preLaunch\":\"Pre-Launch Check\",\"videoOpt\":\"Video Optimization\",\"policyLib\":\"Multi-Platform Policy\",\"imageGen\":\"AI Image Gen\",\"videoGen\":\"AI Video Gen\",\"scriptGen\":\"AI Script Gen\",\"translation\":\"Multilingual Translation\",\"tts\":\"TTS Voiceover\",\"company\":\"Company\",\"help\":\"Help Center\",\"terms\":\"Terms of Service\",\"privacy\":\"Privacy Policy\"},\"copyright\":\"© 2025 FastGrow. All rights reserved.\",\"social\":{\"wechat\":\"WeChat\",\"weibo\":\"Weibo\",\"zhihu\":\"Zhihu\"}}},\"Navigation\":{\"assets\":{\"myAssets\":\"My Assets\"},\"check\":{\"checkHistory\":\"Check History\",\"landingPageCheck\":\"DTC Search \u0026 Social Ads\",\"