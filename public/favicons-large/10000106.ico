                    "适合制作高质量的动画内容 ",
                ],
                theme: "blue",
                url: "daoying",
                to: "https://agent.daoying.studio/",
                iconSrc: "https://deeplor.oss-cn-hangzhou.aliyuncs.com/site/promeai/config/web/shutdown/images/daoying.png"
            },
            {
                name: "图可丽",
                subtitle: "专业图像处理",
                bullets: [
                    "AI 驱动的在线视觉处理平台，主打图片与视频的智能编辑，操作简单",
                    "功能涵盖智能抠图、画质修复、艺术化创作、证件照制作等，支持批量处理",
                    "适配电商、设计、摄影等多行业需求，还提供 API 接口赋能开发者，兼具稳定性与数据安全保障",
                ],
                theme: "pink",
                url: "tukeli",
                to: "https://www.tukeli.net/",
                iconSrc: "https://deeplor.oss-cn-hangzhou.aliyuncs.com/site/promeai/config/web/shutdown/images/tukeli.png"
            },
        ];

        function getColors(theme) {
            return themeColors[theme];
        }

        function openUrl(url) {
            // window.open(url);
        }

        // Render function
        function renderServices() {
            const container = document.getElementById('services-grid');
            let html = '';

            services.forEach(service => {
                const colors = getColors(service.theme);
                
                // Bullets HTML
                const bulletsHtml = service.bullets.map(bullet => `
                    <li class="flex items-start gap-2.5" style="font-size: 14px; line-height: 1.7">
                        <span class="mt-2 w-1 h-1 rounded-full flex-shrink-0 ${colors.iconColor}"></span>
                        <span class="text-white-64">${bullet}</span>
                    </li>
                `).join('');

                // Card HTML
                html += `
                <div class="group relative bg-white-06 backdrop-blur-xl border border-white-10 rounded-2xl overflow-hidden transition-all duration-500 card-hover cursor-pointer"
                     style="box-shadow: 0 16px 50px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.1);"
                     onclick="openUrl('${service.to}')">
                    
                    <!-- Hover glow effect -->
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                         style="background: radial-gradient(circle at 50% 0%, ${colors.glowColor} 0%, transparent 70%);"></div>

                    <!-- Top accent bar -->
                    <div class="h-2 ${colors.accentBar}"></div>

                    <div class="relative p-6 pb-24 flex-1 h-full">
                        <!-- Icon badge -->
                        <div class="flex gap-4 align-center mb-5">
                            <div class="w-12 h-12 rounded-xl border border-white-05 flex items-center justify-center flex-none ${colors.iconBg}">
                                <img src="${service.iconSrc}" alt="${service.name}" class="w-6 h-6" />
                            </div>
                            <h3 class="text-white-92" style="font-weight: 700; font-size: 18px; line-height: 48px">
                                ${service.name}
                            </h3>
                        </div>

                        <!-- Title and subtitle -->
                        <p class="text-white-64 mb-5 font-[600]" style="font-weight: 600; font-size: 13px; line-height: 18px">
                            ${service.subtitle}
                        </p>

                        <!-- Bullet list -->
                        <ul class="space-y-2.5 mb-6">
                            ${bulletsHtml}
                        </ul>

                        <!-- CTA Button -->
                        <button class="absolute bottom-6 left-6 right-6 bg-gradient-to-r text-white rounded-xl transition-all duration-300 flex items-center justify-center gap-2 group-hover:shadow-lg overflow-hidden ${colors.gradient}"
                                style="height: 48px; font-weight: 600; font-size: 15px; box-shadow: 0 0 20px ${colors.glowColor};"
                                onclick="event.stopPropagation(); openUrl('${service.to}')">
                            <span class="relative z-10">访问服务</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 relative z-10">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                <polyline points="15 3 21 3 21 9" />
                                <line x1="10" y1="14" x2="21" y2="3" />
                            </svg>
                            <div class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                        </button>
                    </div>
                </div>
                `;
            });

            container.innerHTML = html;
        }

        // Initialize
        // renderServices();
    </script>
</body>
</html>
