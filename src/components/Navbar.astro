---
import { mainNavItems } from '../data/navigation';

// 获取当前页面路径
const url = Astro.url;
const currentPath = url.pathname.replace(/\/$/, '') || '/';

// 判断当前菜单项是否激活
const isActive = (path: string) => {
  // 首页特殊处理
  if (path === '/products' && currentPath === '/') {
    return true;
  }
  // 检查路径是否匹配
  return currentPath.startsWith(path);
};
---

<nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-[#E5E5E5] h-16 flex items-center justify-between px-6 shadow-sm">
  <div class="flex items-center gap-6 flex-1">
    <a href="/" class="flex items-center gap-2.5 text-xl font-extrabold tracking-tight text-[#171717] hover:opacity-80 transition-opacity cursor-pointer">
      <span class="text-2xl">♾️</span> <span>AI Links</span>
    </a>
    <div class="relative w-full max-w-sm group">
      <input type="text" placeholder="搜索 AI 工具、智能体、技能..." class="w-full bg-[#F5F5F5]/80 border border-transparent rounded-full px-11 py-2.5 text-[13.5px] font-medium text-[#171717] placeholder-[#A3A3A3] focus:bg-white focus:border-[#E5E5E5] focus:ring-6 focus:ring-[#171717]/5 outline-none transition-all duration-200 cursor-pointer" />
      <svg class="w-4.5 h-4.5 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#A3A3A3] group-focus-within:text-[#171717] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>
  </div>
  <div class="flex items-center gap-5 text-[13.5px] font-semibold text-[#525252]">
    {mainNavItems.map((item) => (
      <a
        href={item.path}
        class={`transition-all duration-200 cursor-pointer ${
          isActive(item.path)
            ? 'text-[#171717] font-bold'
            : 'text-[#525252] hover:text-[#171717]'
        }`}
      >
        {item.name}
      </a>
    ))}
    <div class="h-4 w-px bg-[#E5E5E5]"></div>
    <a href="#" class="hover:text-[#171717] transition-colors cursor-pointer">Log In</a>
    <a href="#" class="bg-[#171717] hover:bg-[#262626] text-white px-5 py-2.5 rounded-full font-bold transition-all duration-200 shadow-md shadow-[#171717]/10 cursor-pointer">Sign Up</a>
  </div>
</nav>
