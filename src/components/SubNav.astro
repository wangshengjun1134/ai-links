---
const { activeTab } = Astro.props;
const tabs = [
  { name: '提示词', href: '/skills/prompts', id: 'prompts' },
  { name: '插件 Skill', href: '/skills/tools', id: 'tools' },
  { name: 'MCP 协议', href: '/skills/mcp', id: 'mcp' }
];
---
<div class="flex space-x-2 mb-6 bg-gray-100 p-1 rounded-xl w-fit border border-gray-200">
  {tabs.map(tab => (
    <a 
      href={tab.href}
      class={`px-4 py-2 text-sm font-medium rounded-lg transition-all ${
        activeTab === tab.id 
        ? 'bg-white text-blue-600 shadow-sm border border-gray-200' 
        : 'text-gray-600 hover:text-gray-900 hover:bg-gray-200/50'
      }`}
    >
      {tab.name}
    </a>
  ))}
</div>
