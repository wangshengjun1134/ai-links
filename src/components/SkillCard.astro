---
interface Props {
  uid: string;
  subCategory?: string;
  title: string;
  description: string;
  author: string;
  tags: string[];
  icon: string;
}

import BaseCard from './BaseCard.astro';

const { title, description, author, tags, icon, subCategory } = Astro.props;

// 提示词卡片使用 🖉 emoji，技能卡片使用 ⚙ emoji，其他使用传入的 icon
const isPrompt = subCategory === 'prompts';
const isSkill = subCategory === 'tools' || subCategory === 'mcp';
const displayIcon = isPrompt ? '🖉' : (isSkill ? '⚙' : icon);
---

<BaseCard
  title={title}
  description={description}
  author={author}
  icon={displayIcon}
  tags={tags}
/>
