---
interface Props {
  uid?: string;
  id?: string;
  slug?: string;
  subCategory?: string;
  title: string;
  description: string;
  author?: string;
  tags: string[];
  icon?: string;
  modality?: string;
}

import BaseCard from './BaseCard.astro';

const { uid, id, slug, title, description, author, tags, icon, subCategory, modality } = Astro.props;

// 兼容 uid 和 id 字段
const cardId = uid || id;

// 优先使用 slug，如果没有则使用 cardId (uid/id)
const detailSlug = slug && slug.trim() !== '' ? slug : cardId;

// 根据 subCategory 决定跳转路径
const getDetailUrl = () => {
  if (subCategory === 'mcp') {
    return `/skills/mcps/${detailSlug}`;
  }
  const category = subCategory || 'prompts';
  return `/skills/${category}/${detailSlug}`;
};

// 根据模态选择图标图片路径
const modalityIconPaths: Record<string, string> = {
  text: '/prompts/icons/text.png',
  image: '/prompts/icons/image.png',
  video: '/prompts/icons/video.png',
  audio: '/prompts/icons/audio.png',
  multimodal: '/prompts/icons/multimodal.png',
};

// 判断卡片类型
const isPrompt = subCategory === 'prompts' || !subCategory;
const isMcp = subCategory === 'mcp';
const isTools = subCategory === 'tools';

// 提示词：根据 modality 选择图片
// MCP：使用传入的 icon 图片 URL
// Tools：使用 ⚙ emoji
let displayIcon: string | undefined;
let displayLogo: string | undefined;

if (isPrompt) {
  // 提示词卡片使用模态图片
  displayLogo = modality ? modalityIconPaths[modality] || modalityIconPaths.text : modalityIconPaths.text;
} else if (isMcp) {
  // MCP 卡片使用传入的 icon 图片 URL，修正路径中的下划线为连字符
  displayLogo = icon ? `/${icon.replace('mcp_favicons', 'mcp-favicons')}` : undefined;
} else if (isTools) {
  // Tools 卡片使用 emoji
  displayIcon = '⚙';
} else {
  // 其他使用传入的 icon 或默认 emoji
  displayIcon = icon || '📄';
}
---

<BaseCard
  title={title}
  subtitle={author}
  description={description}
  icon={displayIcon}
  logo={displayLogo}
  tags={tags}
  detailUrl={getDetailUrl()}
/>
