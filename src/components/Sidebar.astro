---
const filterGroups = [
  {
    title: "任务分类",
    items: [
      { label: "文本生成", icon: "📝" },
      { label: "图像生成", icon: "🎨" },
      { label: "语音识别", icon: "🎙️" },
      { label: "嵌入模型", icon: "🔗" },
      { label: "对话问答", icon: "💬" },
    ]
  },
  {
    title: "所属公司",
    items: [
      { label: "阿里巴巴", icon: "🏢" },
      { label: "腾讯", icon: "🐧" },
      { label: "百度", icon: "🐾" },
      { label: "字节跳动", icon: "🎵" },
      { label: "智谱AI", icon: "🧠" },
      { label: "月之暗面", icon: "🌙" },
    ]
  },
  {
    title: "收费模式",
    items: [
      { label: "完全免费", icon: "🎁" },
      { label: "按量计费", icon: "⚡" },
      { label: "会员订阅", icon: "💎" },
      { label: "开源商用", icon: "🔓" },
    ]
  }
];
---
<aside class="w-80 shrink-0 flex flex-col gap-5 pr-6 border-r border-gray-100 h-fit sticky top-24">
  
  {filterGroups.map((group) => (
    <div class="flex flex-col gap-2">
      <h4 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest px-1">
        {group.title}
      </h4>

      <div class="flex flex-wrap gap-1">
        {group.items.map((item) => (
          <button class="
            group flex items-center gap-1.5 px-2 py-0.5 
            bg-white border border-gray-100 rounded-md
            transition-all duration-150
            hover:border-blue-400 hover:bg-blue-50/30
          ">
            <span class="text-[13px] shrink-0 leading-none">
              {item.icon}
            </span>
            
            <span class="text-[12px] text-gray-900 font-medium leading-loose">
              {item.label}
            </span>
          </button>
        ))}
        
        <button class="px-2 py-0.5 text-[11px] text-gray-400 hover:text-blue-500 transition-colors">
          + 更多
        </button>
      </div>
    </div>
  ))}

 <div class="px-1 mt-auto pt-6 border-t border-gray-100/60">
  <div class="relative group">
    <span class="absolute left-3 top-2.5 text-[14px] text-gray-400 group-focus-within:text-blue-500 transition-colors">
      🔍
    </span>
    
    <input 
      type="text" 
      placeholder="搜索标签..." 
      class="
        w-full 
        bg-white 
        border border-gray-200 
        rounded-full 
        py-2 
        pl-9 
        pr-4 
        text-[12px] 
        text-gray-900
        placeholder:text-gray-400 
        shadow-sm
        hover:border-gray-300
        focus:bg-white 
        focus:border-blue-400 
        focus:ring-4 
        focus:ring-blue-50 
        outline-none 
        transition-all
      "
    />
  </div>
</div>
</aside>