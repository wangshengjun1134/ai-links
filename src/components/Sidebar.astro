---
import { sidebarFilters } from '../data/navigation';

const { categories, companies, pricing } = sidebarFilters.products;
---
<aside class="w-80 shrink-0 flex flex-col gap-5 pr-6 border-r border-gray-100 h-fit sticky top-24">

  <!-- 任务分类 -->
  <div class="flex flex-col gap-2">
    <h4 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest px-1">
      任务分类
    </h4>

    <div class="flex flex-wrap gap-1">
      {categories.map((item) => (
        <a
          href={item.path}
          class={`
            group flex items-center gap-1.5 px-2 py-0.5
            border rounded-md transition-all duration-150
            ${item.active
              ? 'bg-blue-50 border-blue-400'
              : 'bg-white border-gray-100 hover:border-blue-400 hover:bg-blue-50/30'
            }
          `}
        >
          <span class="text-[13px] shrink-0 leading-none">
            {item.icon}
          </span>
          <span class="text-[12px] font-medium leading-loose text-gray-900">
            {item.name}
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- 所属公司 -->
  <div class="flex flex-col gap-2">
    <h4 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest px-1">
      所属公司
    </h4>

    <div class="flex flex-wrap gap-1">
      {companies.map((item) => (
        <a
          href={item.path}
          class="
            group flex items-center gap-1.5 px-2 py-0.5
            bg-white border border-gray-100 rounded-md
            transition-all duration-150
            hover:border-blue-400 hover:bg-blue-50/30
          "
        >
          <span class="text-[13px] shrink-0 leading-none">
            {item.icon}
          </span>
          <span class="text-[12px] text-gray-900 font-medium leading-loose">
            {item.name}
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- 收费模式 -->
  <div class="flex flex-col gap-2">
    <h4 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest px-1">
      收费模式
    </h4>

    <div class="flex flex-wrap gap-1">
      {pricing.map((item) => (
        <a
          href={item.path}
          class="
            group flex items-center gap-1.5 px-2 py-0.5
            bg-white border border-gray-100 rounded-md
            transition-all duration-150
            hover:border-blue-400 hover:bg-blue-50/30
          "
        >
          <span class="text-[13px] shrink-0 leading-none">
            {item.icon}
          </span>
          <span class="text-[12px] text-gray-900 font-medium leading-loose">
            {item.name}
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- 搜索框 -->
  <div class="px-1 mt-auto pt-6 border-t border-gray-100/60">
    <div class="relative group">
      <span class="absolute left-3 top-2.5 text-[14px] text-gray-400 group-focus-within:text-blue-500 transition-colors">
        🔍
      </span>
      <input
        type="text"
        placeholder="搜索标签..."
        class="
          w-full
          bg-white
          border border-gray-200
          rounded-full
          py-2
          pl-9
          pr-4
          text-[12px]
          text-gray-900
          placeholder:text-gray-400
          shadow-sm
          hover:border-gray-300
          focus:bg-white
          focus:border-blue-400
          focus:ring-4
          focus:ring-blue-50
          outline-none
          transition-all
        "
      />
    </div>
  </div>
</aside>
