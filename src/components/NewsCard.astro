---
interface RefLink {
  title: string;
  url: string;
}

interface Props {
  uid: string;
  title: string;
  titleEn?: string;
  description?: string;
  author?: string;
  category?: string;
  readTime?: string;
  publishedAt?: string;
  websiteUrl?: string;
  context?: string;
  refUrl?: RefLink[];
}

const { uid, title, category, readTime, publishedAt, context, refUrl = [] } = Astro.props;
const cardId = `news-card-${uid}`;
---

<div id={cardId} class="news-card flex gap-6 p-5 border-b border-[#F0F0F0] last:border-b-0" data-expanded="false" data-category={category} data-published-at={publishedAt}>
  <!-- 左侧：内容区域 -->
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-3 mb-2">
      {category && (
        <span class="inline-block px-2.5 py-0.5 text-[11px] font-medium text-[#7C3AED] bg-[#F3E8FF] rounded-full">
          {category}
        </span>
      )}
      {publishedAt && (
        <span class="text-[11.5px] text-[#A3A3A3]">{publishedAt}</span>
      )}
      {readTime && (
        <span class="text-[11.5px] text-[#A3A3A3]">· {readTime}</span>
      )}
    </div>
    <div class="flex items-center justify-between gap-4 mb-2">
      <h3 class="text-[15px] font-semibold text-[#171717] leading-relaxed">{title}</h3>
      {context && context.length > 80 && (
        <button class="expand-btn text-[12px] text-[#2563EB] hover:text-[#1D4ED8] shrink-0 flex items-center gap-1 transition-colors" onclick="event.stopPropagation()">
          <span class="expand-text">展开全文</span>
          <svg class="expand-icon w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      )}
    </div>
    {context && (
      <p class="text-content text-[13px] text-[#525252] leading-relaxed line-clamp-3">{context}</p>
    )}
  </div>

  <!-- 右侧：相关链接 -->
  {refUrl.length > 0 && (
    <div class="shrink-0 w-48 pl-4 border-l border-[#E5E5E5]">
      <h4 class="text-[11.5px] font-bold text-[#A3A3A3] uppercase tracking-wider mb-3">相关链接</h4>
      <ul class="space-y-2">
        {refUrl.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[13px] text-[#2563EB] hover:text-[#1D4ED8] hover:underline transition-colors flex items-center gap-1"
              onclick="event.stopPropagation()"
            >
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span class="truncate">{link.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<script define:vars={{ cardId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const card = document.getElementById(cardId);
    if (!card) return;

    const expandBtn = card.querySelector('.expand-btn');
    const textContent = card.querySelector('.text-content');
    const expandText = card.querySelector('.expand-text');
    const expandIcon = card.querySelector('.expand-icon');

    // 检测内容是否被截断
    if (expandBtn && textContent) {
      // 检查内容是否真的被截断（line-clamp生效）
      const lineHeight = parseFloat(getComputedStyle(textContent).lineHeight) || 21;
      const maxHeight = lineHeight * 3;
      const actualHeight = textContent.scrollHeight;
      
      if (actualHeight <= maxHeight) {
        // 内容没有被截断，隐藏按钮
        expandBtn.style.display = 'none';
        return;
      }

      expandBtn.addEventListener('click', () => {
        const isExpanded = card.dataset.expanded === 'true';

        if (isExpanded) {
          textContent.classList.add('line-clamp-3');
          expandText.textContent = '展开全文';
          expandIcon.style.transform = 'rotate(0deg)';
          card.dataset.expanded = 'false';
        } else {
          textContent.classList.remove('line-clamp-3');
          expandText.textContent = '收起';
          expandIcon.style.transform = 'rotate(180deg)';
          card.dataset.expanded = 'true';
        }
      });
    }
  });
</script>