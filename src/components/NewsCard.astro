---
interface Props {
  date: string;
  title: string;
  source: string;
}

const { date, title, source } = Astro.props;
---

<div class="flex items-center space-x-4 p-4 hover:bg-[#F9FAFB] rounded-xl transition-all duration-200 border-b border-[#F0F0F0] cursor-pointer group">
  <div class="text-[11.5px] text-[#A3A3A3] font-medium w-24 uppercase">{date}</div>
  <div class="flex-1 text-[13.5px] text-[#171717] font-medium group-hover:text-[#171717] transition-colors">{title}</div>
  <div class="text-[11px] text-[#A3A3A3] font-medium">{source}</div>
</div>