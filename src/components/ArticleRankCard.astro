---
interface Props {
  rank: number;
  title: string;
  author: string;
  views: string;
}

const { rank, title, author, views } = Astro.props;

const rankColors: Record<number, string> = {
  1: "bg-gradient-to-br from-[#D4AF37] to-[#B8860B] text-white shadow-md shadow-[#D4AF37]/20",
  2: "bg-gradient-to-br from-[#C0C0C0] to-[#A8A8A8] text-white shadow-md shadow-[#C0C0C0]/20",
  3: "bg-gradient-to-br from-[#CD7F32] to-[#B87333] text-white shadow-md shadow-[#CD7F32]/20",
};
---

<div class="flex items-center gap-3 p-3 bg-white border border-[#E5E5E5] rounded-xl hover:border-[#171717]/20 hover:bg-[#F9FAFB] transition-all duration-200 group cursor-pointer">
  <div class={`w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold flex-shrink-0 ${rankColors[rank] || 'bg-[#F5F5F5] text-[#525252]'}`}>
    {rank}
  </div>

  <div class="flex-1 min-w-0">
    <h4 class="text-[13px] font-bold text-[#171717] truncate group-hover:text-[#171717] transition-colors">
      {title}
    </h4>
    <div class="flex items-center gap-2 text-[11px] text-[#A3A3A3] mt-0.5">
      <span>{author}</span>
      <span>•</span>
      <span>{views} 阅读</span>
    </div>
  </div>
</div>