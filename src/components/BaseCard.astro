---
/**
 * 通用卡片组件 - 支持两种模式：
 * - compact: 紧凑模式（默认），显示基本信息
 * - expanded: 展开模式（hover 时），显示详细信息和操作按钮
 */
interface Props {
  // 基础信息
  title: string;
  subtitle?: string;
  description?: string;
  icon?: string;
  logo?: string;
  logoAlt?: string;

  // 元数据
  tier?: string;
  author?: string;
  tags?: string[];

  // 状态
  needVpn?: boolean;
  hasApi?: boolean;

  // 链接
  detailUrl?: string;
  externalUrl?: string;

  // 过滤属性
  "data-task"?: string;
  "data-company"?: string;
  "data-country"?: string;
  "data-pricing"?: string;
  "data-useType"?: string;
  "data-language"?: string;

  // 自定义内容插槽通过 slot 属性实现
}

import logoImg from '../assets/logo.png';

const {
  title,
  subtitle,
  description,
  icon,
  logo,
  logoAlt = '',
  tier,
  author,
  tags = [],
  needVpn = false,
  hasApi = false,
  detailUrl,
  externalUrl
} = Astro.props;

const tierColors: Record<string, string> = {
  "S-Tier": "text-[#D4AF37]",
  "A-Tier": "text-[#9333EA]",
  "B-Tier": "text-[#2563EB]",
};

const tierBgColors: Record<string, string> = {
  "S-Tier": "bg-[#D4AF37]/10",
  "A-Tier": "bg-[#9333EA]/10",
  "B-Tier": "bg-[#2563EB]/10",
};

const tierLabel = tier ? tier.split('-')[0] : '';
const displayLogo = logo || logoImg.src;

// 过滤属性
const dataAttrs = {
  'data-task': Astro.props['data-task'],
  'data-company': Astro.props['data-company'],
  'data-country': Astro.props['data-country'],
  'data-pricing': Astro.props['data-pricing'],
  'data-useType': Astro.props['data-useType'],
  'data-language': Astro.props['data-language'],
};
---

<div class="group relative h-[72px]" {...dataAttrs}>
  <!-- 紧凑模式 -->
  <div class="absolute inset-0 p-3 bg-white border border-[#F0F0F0] rounded-xl flex items-center gap-3.5 transition-all duration-300 ease-out hover:border-[#171717]/30 hover:shadow-[0_4px_16px_-2px_rgba(0,0,0,0.08)] cursor-pointer">
    <div class="w-10 h-10 rounded-lg border border-[#F0F0F0] flex-shrink-0 bg-white flex items-center justify-center overflow-hidden">
      {icon ? (
        <span class="text-[24px] leading-none">{icon}</span>
      ) : (
        <img src={displayLogo} alt={logoAlt} class="w-full h-full object-contain p-1" />
      )}
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <h3 class="font-bold text-[#171717] text-[14.5px] truncate leading-tight">{title}</h3>
          {tier && (
            <span class={`text-[9px] font-black px-1.5 py-0.5 rounded shrink-0 ${tierBgColors[tier] || 'bg-gray-100'} ${tierColors[tier] || 'text-gray-400'}`}>
              {tierLabel}
            </span>
          )}
        </div>
        {subtitle && (
          <span class="text-[11px] text-[#A3A3A3] truncate text-right shrink-0 font-medium">
            {subtitle}
          </span>
        )}
      </div>

      {description && (
        <p class="text-[11.5px] text-[#525252] truncate mt-1.5 leading-tight font-medium">
          {description}
        </p>
      )}
    </div>
  </div>

  <!-- 展开模式 -->
  <div class="absolute -inset-x-1 -top-2 p-6 bg-white rounded-2xl shadow-[0_20px_60px_-12px_rgba(0,0,0,0.18)] border border-[#171717]/10
              opacity-0 translate-y-2 pointer-events-none
              group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-hover:z-50
              transition-all duration-300 ease-out"
       style="transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);">

    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="p-1.5 bg-[#F9FAFB] rounded-xl border border-[#F0F0F0]">
          {icon ? (
            <span class="text-[24px] leading-none">{icon}</span>
          ) : (
            <img src={displayLogo} class="w-8 h-8 object-contain" />
          )}
        </div>
        <div>
          <h4 class="font-bold text-[#171717] text-[16px] leading-tight">{title}</h4>
          {subtitle && (
            <p class="text-[10px] text-[#A3A3A3] uppercase tracking-wider font-semibold mt-0.5">{subtitle}</p>
          )}
          {author && (
            <p class="text-[10px] text-[#A3A3A3] font-medium mt-0.5">By {author}</p>
          )}
        </div>
      </div>
      {tier && (
        <span class={`text-[10px] font-black px-2 py-1 rounded-lg ${tierBgColors[tier] || 'bg-gray-100'} ${tierColors[tier] || 'text-gray-400'}`}>
          {tier}
        </span>
      )}
    </div>

    {description && (
      <p class="text-[12.5px] text-[#525252] leading-relaxed mb-5 line-clamp-3">
        {description}
      </p>
    )}

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-5">
        {tags.map((tag) => (
          <span class="px-2.5 py-1 bg-[#F5F5F5] text-[#525252] text-[11px] rounded-full hover:bg-[#171717] hover:text-white transition-all duration-200 cursor-default font-medium">
            {tag}
          </span>
        ))}
      </div>
    )}

    {(needVpn !== undefined || hasApi !== undefined) && (
      <div class="grid grid-cols-2 gap-3 mb-5 p-3.5 bg-[#F9FAFB] rounded-xl border border-[#F0F0F0]">
        {needVpn !== undefined && (
          <div class="space-y-1">
            <p class="text-[9px] text-[#A3A3A3] font-bold uppercase tracking-wide">网络环境</p>
            <p class={`text-[12.5px] font-bold ${needVpn ? 'text-orange-500' : 'text-emerald-600'}`}>
              {needVpn ? '需要代理' : '国内直连'}
            </p>
          </div>
        )}
        {hasApi !== undefined && (
          <div class="space-y-1">
            <p class="text-[9px] text-[#A3A3A3] font-bold uppercase tracking-wide">API 接口</p>
            <p class="text-[12.5px] font-bold text-[#171717]">{hasApi ? '已开放' : '暂无'}</p>
          </div>
        )}
      </div>
    )}

    {(detailUrl || externalUrl) && (
      <div class="flex gap-2.5">
        {detailUrl && (
          <a href={detailUrl} class="flex-1 text-center py-2.5 bg-white border border-[#E5E5E5] hover:border-[#171717] hover:bg-[#F9FAFB] text-[#171717] rounded-xl text-[12.5px] font-bold transition-all duration-200 cursor-pointer">
            查看详情
          </a>
        )}
        {externalUrl && (
          <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="flex-1 text-center py-2.5 bg-[#171717] hover:bg-[#262626] text-white rounded-xl text-[12.5px] font-bold transition-all duration-200 shadow-md shadow-[#171717]/20 cursor-pointer">
            立即访问
          </a>
        )}
      </div>
    )}
  </div>
</div>
