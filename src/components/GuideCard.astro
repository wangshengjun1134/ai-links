---
interface Props {
  uid: string;
  title: string;
  description: string;
  author: string;
  category: string;
  readTime: string;
  publishedAt: string;
}

const { uid, title, description, author, category, readTime, publishedAt } = Astro.props;
---

<a href={`/guides/${uid}`} class="block bg-white border border-[#F0F0F0] rounded-2xl p-5 hover:shadow-[0_8px_24px_-4px_rgba(0,0,0,0.1)] hover:border-[#171717]/20 transition-all duration-300 group cursor-pointer">
  <h3 class="text-lg font-bold text-[#171717] mb-2.5 group-hover:text-[#171717] transition-colors leading-tight">
    {title}
  </h3>

  <p class="text-[13.5px] text-[#525252] mb-4 line-clamp-2 leading-relaxed">
    {description}
  </p>

  <div class="flex items-center justify-between text-[12.5px] text-[#A3A3A3]">
    <span class="flex items-center gap-2">
      <span class="w-6 h-6 rounded-full bg-gradient-to-br from-[#171717] to-[#525252] flex items-center justify-center text-white text-[10px] font-bold">
        {author.charAt(0)}
      </span>
      <span class="font-medium text-[#525252]">{author}</span>
    </span>
    <span>{publishedAt}</span>
  </div>
</a>
