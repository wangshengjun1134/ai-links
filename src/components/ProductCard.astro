---
interface Props {
  uid: string;
  slug?: string;
  logo: string;
  aiProductName: string;
  introduction: string;
  websiteUrl: string;
  metrics: {
    productType: string[] | { level1?: string; level2?: string; tags?: string[] };
    company: string;
    country: string;
    pricingModel: string[];
    useType: string[];
    languages: string[];
    hasApi: boolean;
    needVpn: boolean;
    rawProductType?: string[];
  };
}

import BaseCard from './BaseCard.astro';

const { uid, slug, aiProductName, introduction, websiteUrl, metrics, logo } = Astro.props;

// 处理 productType 可能是对象或数组的情况
const getProductTypes = (): string[] => {
  const pt = metrics.productType;
  if (Array.isArray(pt)) {
    return pt;
  }
  // 如果是对象，合并 level1, level2, tags
  const types: string[] = [];
  if (pt?.level1) types.push(pt.level1);
  if (pt?.level2) types.push(pt.level2);
  if (pt?.tags) types.push(...pt.tags);
  // 也包含 rawProductType
  if (metrics.rawProductType) types.push(...metrics.rawProductType);
  return types;
};

const productTypes = getProductTypes();

// 生成详情页 URL：统一使用 uid（路由基于 uid 生成）
const detailUrl = `/product/${uid}`;
---

<BaseCard
  title={aiProductName}
  subtitle={metrics.company}
  description={introduction}
  needVpn={metrics.needVpn}
  hasApi={metrics.hasApi}
  logo={logo}
  detailUrl={detailUrl}
  externalUrl={websiteUrl}
  data-task={JSON.stringify(productTypes)}
  data-company={metrics.company || ''}
  data-country={metrics.country || ''}
  data-pricing={JSON.stringify(metrics.pricingModel || [])}
  data-useType={JSON.stringify(metrics.useType || [])}
  data-language={JSON.stringify(metrics.languages || [])}
/>