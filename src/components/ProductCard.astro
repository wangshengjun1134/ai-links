---
interface Props {
  uid: string;
  slug: string;
  logo: string;
  aiProductName: string;
  introduction: string;
  websiteUrl: string;
  metrics: {
    productType: string[];
    company: string;
    modelLevel: string;
    hasApi: boolean;
    needVpn: boolean;
    isInternal: boolean;
  };
}

import logoImg from '../assets/logo.png';

const { slug, logo, aiProductName, introduction, websiteUrl, metrics } = Astro.props;

const tierColors = {
  "S-Tier": "text-amber-500",
  "A-Tier": "text-purple-500",
  "B-Tier": "text-blue-500",
};
---

<div class="group relative h-[64px]">

  <div class="absolute inset-0 p-2.5 bg-white border border-gray-100 rounded-lg flex items-center gap-3 transition-all duration-300 group-hover:border-blue-200 group-hover:shadow-md">
    <div class="w-9 h-9 rounded border border-gray-50 flex-shrink-0 bg-white p-1 flex items-center justify-center">
      <img src={logoImg} alt="" class="w-full h-full object-contain" />
    </div>
    
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-1.5 min-w-0">
          <h3 class="font-bold text-gray-900 text-[14px] truncate leading-none">
            {aiProductName}
          </h3>
          <span class={`text-[10px] font-black shrink-0 ${tierColors[metrics.modelLevel] || 'text-gray-400'}`}>
            {metrics.modelLevel.split('-')[0]}
          </span>
        </div>
        <span class="text-[11px] text-gray-400 truncate text-right shrink-0">
          {metrics.company}
        </span>
      </div>
      
      <p class="text-[11px] text-gray-600 truncate mt-2 leading-none font-medium">
        {introduction}
      </p>
    </div>
  </div>

  <div class="absolute -inset-x-2 -top-1 p-5 bg-white rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.15)] border border-blue-50
              opacity-0 translate-y-2 pointer-events-none
              group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-hover:z-50
              transition-all duration-300 delay-150 ease-out"> <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <div class="p-1 bg-gray-50 rounded-lg border border-gray-100">
          <img src={logoImg} class="w-7 h-7 object-contain" />
        </div>
        <div>
          <h4 class="font-bold text-gray-900 text-[15px] leading-tight">{aiProductName}</h4>
          <p class="text-[10px] text-gray-400 uppercase tracking-wider font-semibold">{metrics.company}</p>
        </div>
      </div>
      <span class={`text-[10px] font-black px-1.5 py-0.5 rounded bg-gray-50 ${tierColors[metrics.modelLevel]}`}>
        {metrics.modelLevel}
      </span>
    </div>

    <p class="text-[12px] text-gray-600 leading-relaxed mb-5 line-clamp-3">
      {introduction}
    </p>

    <div class="grid grid-cols-2 gap-3 mb-5 p-3 bg-gray-50 rounded-xl">
      <div class="space-y-0.5">
        <p class="text-[9px] text-gray-400 font-bold uppercase">网络环境</p>
        <p class={`text-[12px] font-bold ${metrics.needVpn ? 'text-orange-500' : 'text-green-600'}`}>
          {metrics.needVpn ? '需要代理' : '国内直连'}
        </p>
      </div>
      <div class="space-y-0.5">
        <p class="text-[9px] text-gray-400 font-bold uppercase">API 接口</p>
        <p class="text-[12px] font-bold text-gray-800">{metrics.hasApi ? '已开放' : '暂无'}</p>
      </div>
    </div>

    <div class="flex gap-2.5">
      <a href={`/detail/${slug}`} class="flex-1 text-center py-2 bg-white border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-700 rounded-lg text-[12px] font-bold transition-all">
        查看详情
      </a>
      <a href={websiteUrl} target="_blank" class="flex-1 text-center py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-[12px] font-bold transition-all shadow-md shadow-blue-100">
        立即访问
      </a>
    </div>
  </div>
</div>