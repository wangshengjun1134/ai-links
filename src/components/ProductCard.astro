---
interface Props {
  uid: string;
  slug: string;
  logo: string;
  aiProductName: string;
  introduction: string;
  websiteUrl: string;
  metrics: {
    productType: string[];
    company: string;
    modelLevel: string;
    hasApi: boolean;
    needVpn: boolean;
    isInternal: boolean;
  };
}

import BaseCard from './BaseCard.astro';

const { slug, aiProductName, introduction, websiteUrl, metrics } = Astro.props;
---

<BaseCard
  title={aiProductName}
  subtitle={metrics.company}
  description={introduction}
  tier={metrics.modelLevel}
  needVpn={metrics.needVpn}
  hasApi={metrics.hasApi}
  detailUrl={`/detail/${slug}`}
  externalUrl={websiteUrl}
/>