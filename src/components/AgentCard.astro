---
// src/components/AgentCard.astro
const { title, description, author, tags, icon } = Astro.props;
---
<div class="glass-card p-5 rounded-xl border border-white/10 hover:border-blue-500/50 transition-all group">
  <div class="flex items-start justify-between">
    <div class="flex items-center space-x-3">
      <div class="text-2xl">{icon}</div>
      <h3 class="font-bold text-gray-100 group-hover:text-blue-400">{title}</h3>
    </div>
    <span class="text-[10px] bg-white/5 text-gray-400 px-2 py-1 rounded">By {author}</span>
  </div>
  <p class="mt-3 text-sm text-gray-400 line-clamp-2">{description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="text-[10px] border border-white/10 px-2 py-0.5 rounded-full">{tag}</span>
    ))}
  </div>
</div>