---
interface Props {
  uid: string;
  slug: string;
  logo: string;
  agentName: string;
  introduction: string;
  websiteUrl: string;
  metrics: {
    agentType: string[];
    creator: string;
    modelLevel: string;
    hasApi: boolean;
    needVpn: boolean;
    isInternal: boolean;
  };
}

import BaseCard from './BaseCard.astro';

const { slug, agentName, introduction, websiteUrl, metrics } = Astro.props;
---

<BaseCard
  title={agentName}
  subtitle={metrics.creator}
  description={introduction}
  tier={metrics.modelLevel}
  needVpn={metrics.needVpn}
  hasApi={metrics.hasApi}
  detailUrl={`/detail/${slug}`}
  externalUrl={websiteUrl}
/>
