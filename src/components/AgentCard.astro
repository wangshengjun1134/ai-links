---
interface Props {
  uid: string;
  slug: string;
  logo: string;
  aiProductName: string;
  introduction: string;
  websiteUrl: string;
  metrics: {
    productType: {
      level1: string;
      level2: string;
      tags: string[];
    };
    company: string;
    country: string;
    useType: string[];
    modelLevel: string;
    hasApi: boolean;
    pricingModel: string[];
    needVpn: boolean;
    languages: string[];
    isInternal: boolean;
    websiteReachable: boolean;
    rawProductType: string[];
    category?: string;
    agentLevel?: string;
  };
}

import BaseCard from './BaseCard.astro';

const { uid, slug, logo, aiProductName, introduction, websiteUrl, metrics } = Astro.props;

// 提取分类数据用于过滤
const category = metrics.category || '';
const agentLevel = metrics.agentLevel || '';
---

<BaseCard
  title={aiProductName}
  subtitle={metrics.company}
  description={introduction}
  tier={metrics.modelLevel}
  needVpn={metrics.needVpn}
  hasApi={metrics.hasApi}
  logo={logo}
  detailUrl={`/agent/${slug}`}
  externalUrl={websiteUrl}
  data-category={category.toLowerCase()}
  data-agentLevel={agentLevel.toLowerCase()}
/>