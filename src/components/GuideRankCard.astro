---
interface Props {
  rank: number;
  title: string;
  author: string;
  views: string;
}

const { rank, title, author, views } = Astro.props;

const rankColors = {
  1: "bg-gradient-to-br from-yellow-400 to-yellow-600 text-white",
  2: "bg-gradient-to-br from-gray-300 to-gray-500 text-white",
  3: "bg-gradient-to-br from-amber-600 to-amber-800 text-white",
};
---

<div class="flex items-center gap-3 p-3 bg-white border border-gray-100 rounded-lg hover:border-blue-200 hover:shadow-md transition-all group cursor-pointer">
  <div class={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 ${rankColors[rank] || 'bg-gray-100 text-gray-600'}`}>
    {rank}
  </div>
  
  <div class="flex-1 min-w-0">
    <h4 class="text-sm font-bold text-gray-900 truncate group-hover:text-blue-600 transition-colors">
      {title}
    </h4>
    <div class="flex items-center gap-2 text-xs text-gray-400 mt-0.5">
      <span>{author}</span>
      <span>•</span>
      <span>{views} 阅读</span>
    </div>
  </div>
</div>
