---
interface Props {
  title?: string;
  description?: string;
  subNav?: {
    activeTab: string;
    tabs: Array<{ name: string; href: string; id: string }>;
  };
}

import Navbar from '../components/Navbar.astro';

const { title = "AI Links", description = "发现最好的 AI 工具、智能体、技能和学习资源", subNav } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-[#F9FAFB]">
    <Navbar />

    {subNav && (
      <div class="border-b border-[#E5E5E5] bg-white/80 backdrop-blur-md sticky top-[64px] z-40">
        <div class="max-w-[1600px] mx-auto px-4">
          <div class="flex gap-2 py-2.5">
            {subNav.tabs.map(tab => (
              <a
                href={tab.href}
                class={`px-4 py-2 text-[13px] font-semibold rounded-full transition-all duration-200 cursor-pointer ${
                  subNav.activeTab === tab.id
                  ? 'bg-[#171717] text-white shadow-md'
                  : 'text-[#525252] hover:text-[#171717] hover:bg-[#F0F0F0]'
                }`}
              >
                {tab.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    <div class="max-w-[1600px] mx-auto flex">
      <slot name="sidebar" />
      <div class="flex-1 min-w-0">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --navbar-height: 64px;
    --subnav-height: 57px;
    --sidebar-top-single: 80px;
    --sidebar-top-with-subnav: 137px;
  }

  html {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }
</style>
