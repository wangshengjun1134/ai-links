---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  keywords?: string[];
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  subNav?: {
    activeTab: string;
    tabs: Array<{ name: string; href: string; id: string }>;
  };
}

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { 
  title = "AI Links - 发现最好的 AI 工具、智能体和技能", 
  description = "AI Links 收录超过 1000+ AI 产品、智能体 Agent、提示词模板、MCP 服务和插件工具，提供 AI 科普教程和行业资讯，助你快速入门 AI 世界",
  image = "/logo.jpeg",
  canonicalURL = Astro.url?.href,
  keywords = ["AI 工具", "人工智能", "智能体", "Agent", "提示词", "Prompt", "MCP", "大模型", "AI 导航"],
  author = "AI Links",
  publishedTime,
  modifiedTime,
  articleSection,
  subNav 
} = Astro.props;

const siteUrl = "https://ai-links.cn";
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const currentKeywords = keywords.join(', ');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={currentKeywords} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="baiduspider" content="index, follow" />
    
    <!-- Canonical URL -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    
    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/logo.jpeg" />
    <link rel="apple-touch-icon" href="/logo.jpeg" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={publishedTime ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="AI Links" />
    <meta property="og:locale" content="zh_CN" />
    
    <!-- Article specific OG tags -->
    {publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime} />
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {articleSection && <meta property="article:section" content={articleSection} />}
      </>
    )}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Baidu Site Verification -->
    <meta name="baidu-site-verification" content="codeva-jdnM998WXW" />
    
    <!-- Title -->
    <title>{title}</title>
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": publishedTime ? "Article" : "WebSite",
      "name": title,
      "description": description,
      "url": canonicalURL,
      "image": fullImage,
      "author": {
        "@type": "Organization",
        "name": "AI Links"
      },
      "publisher": {
        "@type": "Organization",
        "name": "AI Links",
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/logo.jpeg`
        }
      },
      "datePublished": publishedTime,
      "dateModified": modifiedTime,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL
      }
    })} />
  </head>
  <body class="bg-[#F9FAFB] flex flex-col min-h-screen">
    <Navbar />

    {subNav && (
      <div class="border-b border-[#E5E5E5] bg-white/80 backdrop-blur-md sticky top-[64px] z-40">
        <div class="max-w-[1600px] mx-auto px-4">
          <div class="flex gap-2 py-2.5">
            {subNav.tabs.map(tab => (
              <a
                href={tab.href}
                class={`px-4 py-2 text-[13px] font-semibold rounded-full transition-all duration-200 cursor-pointer ${
                  subNav.activeTab === tab.id
                  ? 'bg-[#171717] text-white shadow-md'
                  : 'text-[#525252] hover:text-[#171717] hover:bg-[#F0F0F0]'
                }`}
              >
                {tab.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    <div class="max-w-[1600px] mx-auto flex flex-1 w-full">
      <slot name="sidebar" />
      <div class="flex-1 min-w-0">
        <slot />
      </div>
    </div>

    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --navbar-height: 64px;
    --subnav-height: 57px;
    --sidebar-top-single: 80px;
    --sidebar-top-with-subnav: 137px;
  }

  html {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }
</style>
