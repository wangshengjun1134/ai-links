---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import NewsRankCard from '../components/NewsRankCard.astro';
import Pagination from '../components/Pagination.astro';
import { getNewsPaginated, getNewsCount, getNewsCategories } from '../lib/db';

// 时间范围选项
const timeRangeOptions = [
  { value: '', label: '不限', icon: '📅' },
  { value: '24h', label: '24小时内', icon: '🕐' },
  { value: '7d', label: '7天内', icon: '📆' },
  { value: '30d', label: '30天内', icon: '🗓️' },
];

// 解析 URL 参数
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 20;
const category = Astro.url.searchParams.get('category') || '';
const timeRange = Astro.url.searchParams.get('timeRange') || '';
const search = Astro.url.searchParams.get('search') || '';

// 数据库查询
const result = await getNewsPaginated({
  page,
  pageSize,
  category: category || undefined,
  timeRange: timeRange || undefined,
  search: search || undefined,
});

const news = result.items;
const total = result.total;
const totalPages = result.totalPages;

// 获取筛选列表和总数
const categories = await getNewsCategories();
const totalCount = await getNewsCount();

// 排行榜数据（取前5条）
const rankData = news.slice(0, 5).map((n, index) => ({
  rank: index + 1,
  title: n.title,
  source: n.category,
  views: `${(Math.floor(Math.random() * 20) + 5)}.${Math.floor(Math.random() * 9)}k`,
}));

// 动态 SEO 标题
let pageTitle = 'AI 新闻 - AI Links';
let pageDescription = `探索最新 AI 行业新闻、产品发布、融资动态`;

if (search) {
  pageTitle = `搜索"${search}"的新闻 - AI Links`;
} else if (category) {
  pageTitle = `${category}类AI新闻 - AI Links`;
}

if (page > 1) {
  pageTitle += ` - 第${page}页`;
}

// 构建分类筛选 URL
const buildCategoryUrl = (cat: string) => {
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (timeRange) params.set('timeRange', timeRange);

  if (category === cat) {
    // 取消选中
  } else {
    params.set('category', cat);
  }

  const queryString = params.toString();
  return queryString ? `/news?${queryString}` : '/news';
};

// 构建时间范围筛选 URL
const buildTimeRangeUrl = (range: string) => {
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (category) params.set('category', category);

  if (timeRange === range) {
    // 取消选中
  } else if (range) {
    params.set('timeRange', range);
  }

  const queryString = params.toString();
  return queryString ? `/news?${queryString}` : '/news';
};

// 查询参数
const queryParams: Record<string, string | string[]> = {};
if (category) queryParams.category = category;
if (timeRange) queryParams.timeRange = timeRange;
if (search) queryParams.search = search;
---

<Layout title={pageTitle} description={pageDescription}>
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <h3 class="text-[11.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-wider">新闻分类</h3>
    <div class="space-y-1.5 mb-6">
      <a
        href={buildCategoryUrl('')}
        class={`filter-btn category-btn block w-full px-3 py-2.5 text-[13px] rounded-xl transition-all duration-200 ${
          !category
            ? 'bg-[#171717] text-white'
            : 'text-[#525252] hover:bg-[#171717] hover:text-white'
        }`}
      >
        📰 全部新闻
      </a>
      {categories.map((cat) => {
        const isActive = category === cat;
        return (
          <a
            href={buildCategoryUrl(cat)}
            class={`filter-btn category-btn block w-full px-3 py-2.5 text-[13px] rounded-xl transition-all duration-200 ${
              isActive
                ? 'bg-[#171717] text-white'
                : 'text-[#525252] hover:bg-[#171717] hover:text-white'
            }`}
          >
            {cat === '产品发布' && '🚀'} {cat === '融资动态' && '💰'} {cat === '研究论文' && '🔬'} {cat === '政策法规' && '📜'} {cat}
          </a>
        );
      })}
    </div>

    <h3 class="text-[11.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-wider">时间范围</h3>
    <div class="space-y-1.5 mb-6">
      {timeRangeOptions.map((opt) => {
        const isActive = timeRange === opt.value;
        return (
          <a
            href={buildTimeRangeUrl(opt.value)}
            class={`filter-btn block w-full px-3 py-2.5 text-[13px] rounded-xl transition-all duration-200 ${
              isActive
                ? 'bg-[#171717] text-white'
                : 'text-[#525252] hover:bg-[#171717] hover:text-white'
            }`}
          >
            {opt.icon} {opt.label}
          </a>
        );
      })}
    </div>

    {(category || timeRange || search) && (
      <a href="/news" class="text-[13px] text-[#A3A3A3] hover:text-[#171717] flex items-center gap-1">
        <span>✕</span>
        <span>清除筛选</span>
      </a>
    )}
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">AI 新闻</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <form action="/news" method="get">
          {category && <input type="hidden" name="category" value={category} />}
          {timeRange && <input type="hidden" name="timeRange" value={timeRange} />}
          <input
            type="text"
            name="search"
            value={search}
            placeholder="搜索新闻..."
            class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] outline-none"
          />
        </form>
      </div>

      <div class="flex-1"></div>

      {(category || timeRange || search) && (
        <div class="flex items-center gap-2 text-[13px] text-[#525252]">
          <span>筛选:</span>
          {category && <span class="bg-[#171717] text-white px-2 py-0.5 rounded text-[12px]">{category}</span>}
          {timeRange && (
            <span class="bg-[#171717] text-white px-2 py-0.5 rounded text-[12px]">
              {timeRangeOptions.find(o => o.value === timeRange)?.label}
            </span>
          )}
          {search && <span class="bg-[#F5F5F5] px-2 py-0.5 rounded">搜索: {search}</span>}
        </div>
      )}
    </div>

    {news.length > 0 ? (
      <div class="flex gap-8">
        <div class="flex-1">
          <div id="news-list" class="bg-white rounded-2xl border border-[#E5E5E5] overflow-hidden">
            <div class="divide-y divide-[#F0F0F0]">
              {news.map(n => (
                <div
                  data-category={n.category}
                  data-publishedAt={n.publishedAt}
                >
                  <NewsCard
                    uid={n.uid}
                    slug={n.slug}
                    title={n.title}
                    category={n.category}
                    publishedAt={n.publishedAt}
                    context={n.context}
                    refUrl={n.metrics.refUrl}
                  />
                </div>
              ))}
            </div>
          </div>

          <Pagination
            currentPage={page}
            totalPages={totalPages}
            totalItems={total}
            pageSize={pageSize}
            itemTypeLabel="新闻"
            baseUrl="/news"
            queryParams={queryParams}
          />
        </div>

        <div class="w-80 shrink-0">
          <div class="sticky top-20 space-y-6">
            <div class="bg-white border border-[#E5E5E5] rounded-2xl p-5 shadow-sm">
              <h3 class="text-[13px] font-bold text-[#171717] mb-4 flex items-center gap-2">
                <span class="text-lg">🔥</span> 阅读排行榜
              </h3>
              <div class="flex flex-col gap-2">
                {rankData.map(r => <NewsRankCard {...r} />)}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div id="empty-state" class="text-center py-20 bg-white rounded-2xl border border-[#E5E5E5]">
        <div class="text-6xl mb-4">📰</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无新闻</h3>
        <p class="text-[#525252]">当前筛选条件下暂无新闻</p>
      </div>
    )}
  </div>
</Layout>