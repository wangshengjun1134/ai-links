---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import NewsRankCard from '../components/NewsRankCard.astro';
import news from '../data/news.json';
import { sidebarFilters } from '../data/navigation';

const { categories, timeRanges } = sidebarFilters.news;

// 为每个分类项添加 data-value
const categoriesWithValue = categories.map((item, index) => ({
  ...item,
  value: index === 0 ? 'all' : item.name
}));

const timeRangesWithValue = timeRanges.map((range) => ({
  name: range,
  value: range
}));

// 排行榜数据：从新闻数据中取前5条
const rankData = news.slice(0, 5).map((n, index) => ({
  rank: index + 1,
  title: n.title,
  source: n.category,
  views: `${(Math.floor(Math.random() * 20) + 5)}.${Math.floor(Math.random() * 9)}k`,
}));
---

<Layout title="AI 新闻 - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <h3 class="text-[11.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-wider">新闻分类</h3>
    <div class="space-y-1.5 mb-6" id="category-filter">
      {categoriesWithValue.map((item) => (
        <button
          data-value={item.value}
          class="filter-btn category-btn block w-full px-3 py-2.5 text-[13px] text-[#525252] hover:bg-[#171717] hover:text-white rounded-xl transition-all duration-200 cursor-pointer text-left"
        >
          {item.icon} {item.name}
        </button>
      ))}
    </div>

    <h3 class="text-[11.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-wider">时间范围</h3>
    <div class="space-y-1.5" id="time-filter">
      {timeRangesWithValue.map((item) => (
        <button
          data-value={item.value}
          class="filter-btn time-btn block w-full px-3 py-2.5 text-[13px] text-[#525252] hover:bg-[#171717] hover:text-white rounded-xl transition-all duration-200 cursor-pointer text-left"
        >
          {item.name}
        </button>
      ))}
    </div>
  </aside>

  <div class="p-6">
    <h2 class="text-2xl font-bold text-[#171717] mb-6">AI 新闻</h2>

    <div class="flex gap-8">
      <div class="flex-1">
        <div id="news-list" class="bg-white rounded-2xl border border-[#E5E5E5] overflow-hidden">
          <div class="divide-y divide-[#F0F0F0]">
            {news.map(n => <NewsCard {...n} />)}
          </div>
        </div>

        <div id="empty-state" class="text-center py-20 bg-white rounded-2xl border border-[#E5E5E5] hidden">
          <div class="text-6xl mb-4">📰</div>
          <h3 class="text-xl font-bold text-[#171717] mb-2">暂无新闻</h3>
          <p class="text-[#525252]">当前筛选条件下暂无新闻</p>
        </div>
      </div>

      <div class="w-80 shrink-0">
        <div class="sticky top-20 space-y-6">
          <div class="bg-white border border-[#E5E5E5] rounded-2xl p-5 shadow-sm">
            <h3 class="text-[13px] font-bold text-[#171717] mb-4 flex items-center gap-2">
              <span class="text-lg">🔥</span> 阅读排行榜
            </h3>
            <div class="flex flex-col gap-2">
              {rankData.map(r => <NewsRankCard {...r} />)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // 过滤状态
  let currentCategory = 'all';
  let currentTimeRange = '';

  // 初始化：设置第一个分类按钮为选中状态
  function initFilters() {
    const categoryBtns = document.querySelectorAll('.category-btn');
    const timeBtns = document.querySelectorAll('.time-btn');

    // 默认选中"全部新闻"
    if (categoryBtns[0]) {
      categoryBtns[0].classList.add('bg-[#171717]', 'text-white');
    }

    // 默认选中"不限"
    if (timeBtns[0]) {
      timeBtns[0].classList.add('bg-[#171717]', 'text-white');
    }

    // 分类按钮点击事件
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // 移除其他按钮的选中状态
        categoryBtns.forEach(b => b.classList.remove('bg-[#171717]', 'text-white'));
        // 添加当前按钮的选中状态
        btn.classList.add('bg-[#171717]', 'text-white');
        // 更新当前分类
        currentCategory = btn.dataset.value || 'all';
        applyFilters();
      });
    });

    // 时间按钮点击事件
    timeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // 移除其他按钮的选中状态
        timeBtns.forEach(b => b.classList.remove('bg-[#171717]', 'text-white'));
        // 添加当前按钮的选中状态
        btn.classList.add('bg-[#171717]', 'text-white');
        // 更新当前时间范围
        currentTimeRange = btn.dataset.value || '';
        applyFilters();
      });
    });
  }

  // 检查时间范围
  function isWithinTimeRange(publishedAt: string | null, timeRange: string): boolean {
    if (!timeRange || timeRange === '不限' || !publishedAt) return true;

    const publishDate = new Date(publishedAt);
    const now = new Date();
    const diffMs = now.getTime() - publishDate.getTime();
    const diffDays = diffMs / (1000 * 60 * 60 * 24);

    switch (timeRange) {
      case '24 小时内':
        return diffDays <= 1;
      case '7 天内':
        return diffDays <= 7;
      case '30 天内':
        return diffDays <= 30;
      default:
        return true;
    }
  }

  // 应用过滤
  function applyFilters() {
    const newsList = document.getElementById('news-list');
    const emptyState = document.getElementById('empty-state');
    const cards = newsList?.querySelector('.divide-y')?.children || [];

    let visibleCount = 0;

    Array.from(cards).forEach((card) => {
      // 直接从 DOM 元素读取分类和时间
      const cardCategory = card.dataset.category || '';
      const cardPublishedAt = card.dataset.publishedAt || '';

      // 分类过滤
      const categoryMatch = currentCategory === 'all' || cardCategory === currentCategory;

      // 时间过滤
      const timeMatch = isWithinTimeRange(cardPublishedAt, currentTimeRange);

      if (categoryMatch && timeMatch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // 显示/隐藏空状态
    if (visibleCount === 0) {
      newsList?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
    } else {
      newsList?.classList.remove('hidden');
      emptyState?.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initFilters();
  });
</script>