---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import news from '../data/news.json';
import { sidebarFilters } from '../data/navigation';

const { categories, timeRanges } = sidebarFilters.news;
---

<Layout title="AI 新闻 - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200">
    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">新闻分类</h3>
    <div class="space-y-2 mb-6">
      {categories.map((item) => (
        <a href={item.path} class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
          {item.icon} {item.name}
        </a>
      ))}
    </div>

    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">时间范围</h3>
    <div class="space-y-2">
      {timeRanges.map((range) => (
        <a href={`?time=${range}`} class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
          {range}
        </a>
      ))}
    </div>
  </aside>

  <div class="p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-6">AI 新闻</h2>

    {news.length > 0 ? (
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
        <div class="divide-y divide-gray-100">
          {news.map(n => <NewsCard {...n} />)}
        </div>
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">📰</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无新闻</h3>
        <p class="text-gray-500">暂无 AI 行业新闻</p>
      </div>
    )}
  </div>
</Layout>
