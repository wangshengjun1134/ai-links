---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import news from '../data/news.json';

const newsCount = news.length;
---

<Layout title="AI 新闻 - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 p-6 border-r border-gray-100 h-fit sticky top-24">
    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">新闻分类</h3>
    <div class="space-y-2">
      <a href="?cat=all" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">📰 全部新闻</a>
      <a href="?cat=product" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">🚀 产品发布</a>
      <a href="?cat=funding" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">💰 融资动态</a>
      <a href="?cat=research" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">🔬 研究论文</a>
      <a href="?cat=policy" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">📜 政策法规</a>
    </div>

    <h3 class="text-xs font-bold text-gray-500 mt-6 mb-4 uppercase tracking-wider">时间范围</h3>
    <div class="space-y-2">
      <a href="?time=24h" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">24 小时内</a>
      <a href="?time=7d" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">7 天内</a>
      <a href="?time=30d" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">30 天内</a>
    </div>
  </aside>

  <div class="flex-1 p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">AI 新闻</h2>
      <span class="text-[12px] font-mono text-gray-500 bg-gray-100/50 px-2 py-0.5 rounded-full">{newsCount}</span>
      <div class="flex-1"></div>
      <select class="text-[12px] font-bold text-gray-700 bg-white border border-gray-200 rounded-full px-3 py-1.5 outline-none">
        <option>最新</option>
        <option>最热</option>
      </select>
    </div>

    {newsCount > 0 ? (
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
        <div class="divide-y divide-gray-100">
          {news.map(n => <NewsCard {...n} />)}
        </div>
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">📰</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无新闻</h3>
        <p class="text-gray-500">暂无 AI 行业新闻</p>
      </div>
    )}
  </div>
</Layout>
