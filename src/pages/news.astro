---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import news from '../data/news.json';
import { sidebarFilters } from '../data/navigation';

const { categories, timeRanges } = sidebarFilters.news;
---

<Layout title="AI 新闻 - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-[#E5E5E5] h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl">
    <h3 class="text-[11.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-wider">新闻分类</h3>
    <div class="space-y-1.5 mb-6">
      {categories.map((item) => (
        <a href={item.path} class="block px-3 py-2.5 text-[13px] text-[#525252] hover:bg-[#171717] hover:text-white rounded-xl transition-all duration-200 cursor-pointer">
          {item.icon} {item.name}
        </a>
      ))}
    </div>

    <h3 class="text-[11.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-wider">时间范围</h3>
    <div class="space-y-1.5">
      {timeRanges.map((range) => (
        <a href={`?time=${range}`} class="block px-3 py-2.5 text-[13px] text-[#525252] hover:bg-[#171717] hover:text-white rounded-xl transition-all duration-200 cursor-pointer">
          {range}
        </a>
      ))}
    </div>
  </aside>

  <div class="p-6">
    <h2 class="text-2xl font-bold text-[#171717] mb-6">AI 新闻</h2>

    {news.length > 0 ? (
      <div class="bg-white rounded-2xl border border-[#E5E5E5] overflow-hidden">
        <div class="divide-y divide-[#F0F0F0]">
          {news.map(n => <NewsCard {...n} />)}
        </div>
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-[#E5E5E5]">
        <div class="text-6xl mb-4">📰</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无新闻</h3>
        <p class="text-[#525252]">暂无 AI 行业新闻</p>
      </div>
    )}
  </div>
</Layout>
