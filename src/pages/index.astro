---
import Layout from '../layouts/Layout.astro';

const categories = [
  { name: 'AI 产品', path: '/products', icon: '🚀', count: 6, color: 'from-blue-500 to-cyan-500' },
  { name: '智能体 Agent', path: '/agents', icon: '🤖', count: 0, color: 'from-purple-500 to-pink-500' },
  { name: '技能 Skills', path: '/skills', icon: '⚡', count: 0, color: 'from-orange-500 to-red-500' },
  { name: '大模型 LLMs', path: '/llms', icon: '🧠', count: 0, color: 'from-green-500 to-emerald-500' },
  { name: '新闻', path: '/news', icon: '📰', count: 0, color: 'from-indigo-500 to-blue-500' },
  { name: '教程', path: '/guides', icon: '📚', count: 0, color: 'from-amber-500 to-orange-500' },
];
---

<Layout title="AI Links - 导航页">
  <div slot="sidebar"></div>

  <main class="max-w-7xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">AI Links</h1>
      <p class="text-gray-600 text-lg">发现最好的 AI 工具、智能体、技能和学习资源</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <a
          href={cat.path}
          class="group relative bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
        >
          <div class={`w-14 h-14 rounded-xl bg-gradient-to-br ${cat.color} flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform`}>
            {cat.icon}
          </div>
          
          <h3 class="text-xl font-bold text-gray-900 mb-2">{cat.name}</h3>
          <p class="text-gray-500 text-sm mb-4">探索 {cat.count} 个{cat.name}</p>
          
          <div class="flex items-center text-blue-600 font-medium text-sm">
            立即浏览
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
