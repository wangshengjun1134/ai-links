---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';
import agents from '../data/agents.json';
import prompts from '../data/prompts.json';
import mcp from '../data/mcp.json';
import tools from '../data/tools.json';

// 统计数量
const productCount = products.length;
const agentCount = agents.length;
const promptCount = prompts.length;
const mcpCount = mcp.length;
const toolCount = tools.length;

// 分类卡片配置
const categories = [
  {
    name: 'AI 产品',
    icon: '🚀',
    description: '发现最实用的 AI 工具和应用程序',
    href: '/products',
    count: productCount,
    color: 'from-blue-500 to-indigo-600',
    bgColor: 'bg-blue-50',
  },
  {
    name: '智能体 Agent',
    icon: '🤖',
    description: '自动化执行任务的 AI 助手',
    href: '/agents',
    count: agentCount,
    color: 'from-purple-500 to-pink-600',
    bgColor: 'bg-purple-50',
  },
  {
    name: '提示词',
    icon: '✍️',
    description: '精选提示词模板，让 AI 更聪明',
    href: '/skills/prompts',
    count: promptCount,
    color: 'from-emerald-500 to-teal-600',
    bgColor: 'bg-emerald-50',
  },
  {
    name: 'MCP 服务',
    icon: '🔌',
    description: '连接 AI 与外部工具的协议服务',
    href: '/skills/mcp',
    count: mcpCount,
    color: 'from-orange-500 to-red-600',
    bgColor: 'bg-orange-50',
  },
  {
    name: '插件 Skill',
    icon: '🧰',
    description: '扩展 AI 能力的插件工具',
    href: '/skills/tools',
    count: toolCount,
    color: 'from-cyan-500 to-blue-600',
    bgColor: 'bg-cyan-50',
  },
  {
    name: 'AI Hub',
    icon: '🧠',
    description: '大模型索引与技术资源',
    href: '/aihub',
    count: null,
    color: 'from-amber-500 to-yellow-600',
    bgColor: 'bg-amber-50',
  },
  {
    name: '文章',
    icon: '📚',
    description: 'AI 科普教程与技术文章',
    href: '/guides',
    count: null,
    color: 'from-rose-500 to-pink-600',
    bgColor: 'bg-rose-50',
  },
  {
    name: '新闻',
    icon: '📰',
    description: 'AI 行业动态与最新资讯',
    href: '/news',
    count: null,
    color: 'from-slate-500 to-gray-600',
    bgColor: 'bg-slate-50',
  },
];

---

<Layout title="AI Links - 发现最好的 AI 工具、智能体和技能">
  <!-- Hero 区域 -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F9FAFB] via-white to-[#F0F4F8] py-16 md:py-24">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-40"></div>
    
    <div class="max-w-[1600px] mx-auto px-4 relative">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Logo 和品牌 -->
        <div class="flex items-center justify-center gap-3 mb-6">
          <img src="/logo.jpeg" alt="AI Links Logo" class="w-12 h-12 rounded-xl shadow-lg" />
          <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-[#171717]">
            AI Links
          </h1>
        </div>
        
        <!-- 主标题 -->
        <p class="text-lg md:text-xl text-[#525252] font-medium mb-8 leading-relaxed">
          发现最好的 <span class="text-[#171717] font-bold">AI 工具</span>、
          <span class="text-[#171717] font-bold">智能体</span>、
          <span class="text-[#171717] font-bold">提示词</span> 和学习资源
        </p>
        
        <!-- 搜索框 -->
        <div class="relative max-w-xl mx-auto mb-8">
          <input 
            type="text" 
            id="hero-search"
            placeholder="搜索 AI 工具、智能体、技能..." 
            class="w-full bg-white border border-[#E5E5E5] rounded-2xl py-4 px-6 pl-14 text-[15px] font-medium text-[#171717] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-8 focus:ring-[#171717]/5 outline-none transition-all duration-300 shadow-sm hover:shadow-md"
          />
          <svg class="w-5 h-5 absolute left-5 top-1/2 -translate-y-1/2 text-[#A3A3A3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        
        <!-- 统计数据 -->
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <div class="flex items-center gap-2 bg-white/80 backdrop-blur-sm px-4 py-2 rounded-full border border-[#E5E5E5]">
            <span class="text-2xl">🚀</span>
            <span class="font-bold text-[#171717]">{productCount}</span>
            <span class="text-[#525252]">AI 产品</span>
          </div>
          <div class="flex items-center gap-2 bg-white/80 backdrop-blur-sm px-4 py-2 rounded-full border border-[#E5E5E5]">
            <span class="text-2xl">🤖</span>
            <span class="font-bold text-[#171717]">{agentCount}</span>
            <span class="text-[#525252]">智能体</span>
          </div>
          <div class="flex items-center gap-2 bg-white/80 backdrop-blur-sm px-4 py-2 rounded-full border border-[#E5E5E5]">
            <span class="text-2xl">✍️</span>
            <span class="font-bold text-[#171717]">{promptCount}</span>
            <span class="text-[#525252]">提示词</span>
          </div>
          <div class="flex items-center gap-2 bg-white/80 backdrop-blur-sm px-4 py-2 rounded-full border border-[#E5E5E5]">
            <span class="text-2xl">🔌</span>
            <span class="font-bold text-[#171717]">{mcpCount}</span>
            <span class="text-[#525252]">MCP 服务</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 分类导航 -->
  <section class="py-12 bg-white">
    <div class="max-w-[1600px] mx-auto px-4">
      <h2 class="text-2xl font-bold text-[#171717] mb-8 text-center">探索 AI 世界</h2>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {categories.map((cat) => (
          <a 
            href={cat.href}
            class={`group relative overflow-hidden ${cat.bgColor} border border-[#E5E5E5] rounded-2xl p-6 transition-all duration-300 hover:border-[#171717]/30 hover:shadow-lg hover:-translate-y-1`}
          >
            <div class={`absolute top-0 right-0 w-24 h-24 bg-gradient-to-br ${cat.color} opacity-10 rounded-bl-full transition-all duration-300 group-hover:opacity-20`}></div>
            
            <div class="relative">
              <span class="text-4xl mb-4 block">{cat.icon}</span>
              <h3 class="text-lg font-bold text-[#171717] mb-2">{cat.name}</h3>
              <p class="text-[13px] text-[#525252] leading-relaxed mb-3">{cat.description}</p>
              {cat.count !== null && (
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#A3A3A3]">
                  <span class="w-1.5 h-1.5 bg-current rounded-full"></span>
                  {cat.count} 项收录
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 快速入口 -->
  <section class="py-12 bg-white border-t border-[#E5E5E5]">
    <div class="max-w-[1600px] mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-6">
        <!-- 新手指南 -->
        <div class="bg-gradient-to-br from-[#F9FAFB] to-white border border-[#E5E5E5] rounded-2xl p-8">
          <div class="flex items-start gap-4">
            <span class="text-4xl">📖</span>
            <div>
              <h3 class="text-lg font-bold text-[#171717] mb-2">新手指南</h3>
              <p class="text-[13px] text-[#525252] leading-relaxed mb-4">
                了解什么是大模型、智能体、提示词和 MCP，快速入门 AI 世界
              </p>
              <a href="/guides?type=sciencepopu" class="inline-flex items-center gap-2 text-[13px] font-semibold text-[#171717] hover:underline">
                开始学习
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
        
        <!-- 最新动态 -->
        <div class="bg-gradient-to-br from-[#F9FAFB] to-white border border-[#E5E5E5] rounded-2xl p-8">
          <div class="flex items-start gap-4">
            <span class="text-4xl">⚡</span>
            <div>
              <h3 class="text-lg font-bold text-[#171717] mb-2">最新动态</h3>
              <p class="text-[13px] text-[#525252] leading-relaxed mb-4">
                关注 AI 行业的最新产品发布、融资动态和技术突破
              </p>
              <a href="/news" class="inline-flex items-center gap-2 text-[13px] font-semibold text-[#171717] hover:underline">
                查看新闻
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // 搜索功能
  const heroSearch = document.getElementById('hero-search');
  if (heroSearch) {
    heroSearch.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const query = heroSearch.value.trim();
        if (query) {
          // 跳转到产品页面并带上搜索参数
          window.location.href = `/products?search=${encodeURIComponent(query)}`;
        }
      }
    });
  }
</script>