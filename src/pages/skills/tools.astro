---
import Layout from '../../layouts/Layout.astro';
import SkillCard from '../../components/SkillCard.astro';
import skills from '../../data/skills.json';
import { skillsSubNav, sidebarFilters } from '../../data/navigation';

const toolsData = skills.filter((s: any) => s.subCategory === 'tools');
const { languages, licenses, functions } = sidebarFilters.tools;

const subNav = {
  activeTab: 'tools',
  tabs: skillsSubNav,
};
---

<Layout title="插件 Skill - AI Links" subNav={subNav}>
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-with-subnav)] p-6 transition-all duration-200">
    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">开发语言</h3>
    <div class="space-y-2 mb-6">
      {languages.map((lang) => (
        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" class="rounded" /> {lang}
        </label>
      ))}
    </div>

    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">授权方式</h3>
    <div class="space-y-2 mb-6">
      {licenses.map((license) => (
        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" class="rounded" /> {license}
        </label>
      ))}
    </div>

    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">功能分类</h3>
    <div class="flex flex-wrap gap-1">
      {functions.map((item) => (
        <a href={item.path} class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50 transition-colors">
          {item.icon} {item.name}
        </a>
      ))}
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">插件 Skill</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-gray-400">🔍</span>
        <input
          type="text"
          placeholder="搜索插件..."
          class="w-full bg-white border border-gray-200 rounded-full py-2 pl-10 pr-4 text-[13px] placeholder:text-gray-400 focus:border-blue-400 focus:ring-4 focus:ring-blue-50/50 outline-none"
        />
      </div>

      <div class="flex-1"></div>
    </div>

    {toolsData.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-3 gap-y-2">
        {toolsData.map(s => <SkillCard {...s} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">🔌</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无插件</h3>
        <p class="text-gray-500">提交你的第一个 Skill 插件！</p>
      </div>
    )}
  </div>
</Layout>
