---
import Layout from '../../layouts/Layout.astro';
import SkillCard from '../../components/SkillCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getMcpsPaginated, getMcpsCount, getMcpServerTypes, getMcpAuthTypes, getMcpDeployments } from '../../lib/db';
import { skillsSubNav } from '../../data/navigation';

const subNav = {
  activeTab: 'mcp',
  tabs: skillsSubNav,
};

// 解析 URL 参数 - 支持多选
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 60;
const serverTypeArray = Astro.url.searchParams.getAll('serverType').filter(Boolean);
const authTypeArray = Astro.url.searchParams.getAll('authType').filter(Boolean);
const deploymentArray = Astro.url.searchParams.getAll('deployment').filter(Boolean);
const search = Astro.url.searchParams.get('search') || '';

// 数据库查询
const result = await getMcpsPaginated({
  page,
  pageSize,
  serverType: serverTypeArray.length > 0 ? serverTypeArray : undefined,
  authType: authTypeArray.length > 0 ? authTypeArray : undefined,
  deployment: deploymentArray.length > 0 ? deploymentArray : undefined,
  search: search || undefined,
});

const mcps = result.items;
const total = result.total;
const totalPages = result.totalPages;

// 获取筛选列表和总数
const serverTypes = await getMcpServerTypes();
const authTypes = await getMcpAuthTypes();
const deployments = await getMcpDeployments();
const totalCount = await getMcpsCount();

// 动态 SEO 标题
let pageTitle = 'MCP 服务 - AI Links';
let pageDescription = `探索 ${totalCount}+ MCP 服务器资源`;

if (search) {
  pageTitle = `搜索"${search}"的MCP服务 - AI Links`;
} else if (serverTypeArray.length > 0 || authTypeArray.length > 0 || deploymentArray.length > 0) {
  const filtersText = [...serverTypeArray, ...authTypeArray, ...deploymentArray].join('、');
  pageTitle = `${filtersText}类MCP服务 - ${total}款精选 - AI Links`;
}

if (page > 1) {
  pageTitle += ` - 第${page}页`;
}

// 构建筛选 URL（支持多选切换）
const buildFilterUrl = (filterType: string, clickedValue: string) => {
  const params = new URLSearchParams();
  if (search) params.set('search', search);

  if (filterType === 'serverType') {
    const isSelected = serverTypeArray.includes(clickedValue);
    let newArray: string[];
    if (isSelected) {
      newArray = serverTypeArray.filter(s => s !== clickedValue);
    } else {
      newArray = [...serverTypeArray, clickedValue];
    }
    newArray.forEach(s => params.append('serverType', s));
    authTypeArray.forEach(a => params.append('authType', a));
    deploymentArray.forEach(d => params.append('deployment', d));
  } else if (filterType === 'authType') {
    const isSelected = authTypeArray.includes(clickedValue);
    let newArray: string[];
    if (isSelected) {
      newArray = authTypeArray.filter(a => a !== clickedValue);
    } else {
      newArray = [...authTypeArray, clickedValue];
    }
    serverTypeArray.forEach(s => params.append('serverType', s));
    newArray.forEach(a => params.append('authType', a));
    deploymentArray.forEach(d => params.append('deployment', d));
  } else if (filterType === 'deployment') {
    const isSelected = deploymentArray.includes(clickedValue);
    let newArray: string[];
    if (isSelected) {
      newArray = deploymentArray.filter(d => d !== clickedValue);
    } else {
      newArray = [...deploymentArray, clickedValue];
    }
    serverTypeArray.forEach(s => params.append('serverType', s));
    authTypeArray.forEach(a => params.append('authType', a));
    newArray.forEach(d => params.append('deployment', d));
  }

  const queryString = params.toString();
  return queryString ? `/skills/mcp?${queryString}` : '/skills/mcp';
};

// 查询参数
const queryParams: Record<string, string | string[]> = {};
if (serverTypeArray.length > 0) queryParams.serverType = serverTypeArray;
if (authTypeArray.length > 0) queryParams.authType = authTypeArray;
if (deploymentArray.length > 0) queryParams.deployment = deploymentArray;
if (search) queryParams.search = search;
---

<Layout title={pageTitle} description={pageDescription} subNav={subNav}>
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-with-subnav))] sticky top-[var(--sidebar-top-with-subnav)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">服务器类型</h4>
      <div class="flex flex-wrap gap-1.5">
        {serverTypes.map((type) => {
          const isActive = serverTypeArray.includes(type);
          return (
            <a
              href={buildFilterUrl('serverType', type)}
              class={`filter-btn border px-2.5 py-1.5 rounded-lg text-[12.5px] font-medium transition-all duration-200 ${
                isActive
                  ? 'bg-[#171717] text-white border-[#171717]'
                  : 'bg-white border-[#E5E5E5] text-[#525252] hover:border-[#171717] hover:text-[#171717] hover:shadow-sm'
              }`}
            >
              <span>{type}</span>
              {isActive && <span class="ml-0.5 text-[10px]">✓</span>}
            </a>
          );
        })}
      </div>
    </div>

    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">认证方式</h4>
      <div class="flex flex-wrap gap-1.5">
        {authTypes.map((method) => {
          const isActive = authTypeArray.includes(method);
          return (
            <a
              href={buildFilterUrl('authType', method)}
              class={`filter-btn border px-2.5 py-1.5 rounded-lg text-[12.5px] font-medium transition-all duration-200 ${
                isActive
                  ? 'bg-[#171717] text-white border-[#171717]'
                  : 'bg-white border-[#E5E5E5] text-[#525252] hover:border-[#171717] hover:text-[#171717] hover:shadow-sm'
              }`}
            >
              <span>{method}</span>
              {isActive && <span class="ml-0.5 text-[10px]">✓</span>}
            </a>
          );
        })}
      </div>
    </div>

    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">部署方式</h4>
      <div class="flex flex-wrap gap-1.5">
        {deployments.map((deploy) => {
          const isActive = deploymentArray.includes(deploy);
          return (
            <a
              href={buildFilterUrl('deployment', deploy)}
              class={`filter-btn border px-2.5 py-1.5 rounded-lg text-[12.5px] font-medium transition-all duration-200 ${
                isActive
                  ? 'bg-[#171717] text-white border-[#171717]'
                  : 'bg-white border-[#E5E5E5] text-[#525252] hover:border-[#171717] hover:text-[#171717] hover:shadow-sm'
              }`}
            >
              <span>{deploy}</span>
              {isActive && <span class="ml-0.5 text-[10px]">✓</span>}
            </a>
          );
        })}
      </div>
    </div>

    {(serverTypeArray.length > 0 || authTypeArray.length > 0 || deploymentArray.length > 0 || search) && (
      <a href="/skills/mcp" class="text-[13px] text-[#A3A3A3] hover:text-[#171717] flex items-center gap-1">
        <span>✕</span>
        <span>清除所有筛选</span>
        {(serverTypeArray.length + authTypeArray.length + deploymentArray.length) > 0 && (
          <span class="text-[11px] bg-[#E5E5E5] px-1.5 py-0.5 rounded">{serverTypeArray.length + authTypeArray.length + deploymentArray.length} 项</span>
        )}
      </a>
    )}
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">MCP 服务资源</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <form action="/skills/mcp" method="get">
          {serverTypeArray.map(s => <input type="hidden" name="serverType" value={s} />)}
          {authTypeArray.map(a => <input type="hidden" name="authType" value={a} />)}
          {deploymentArray.map(d => <input type="hidden" name="deployment" value={d} />)}
          <input
            type="text"
            name="search"
            value={search}
            placeholder="搜索 MCP 资源..."
            class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] outline-none"
          />
        </form>
      </div>

      <div class="flex-1"></div>

      {(serverTypeArray.length > 0 || authTypeArray.length > 0 || deploymentArray.length > 0 || search) && (
        <div class="flex items-center gap-2 text-[13px] text-[#525252]">
          <span>筛选:</span>
          {serverTypeArray.map(s => (
            <span class="bg-[#171717] text-white px-2 py-0.5 rounded text-[12px]">{s}</span>
          ))}
          {authTypeArray.map(a => (
            <span class="bg-[#171717] text-white px-2 py-0.5 rounded text-[12px]">{a}</span>
          ))}
          {deploymentArray.map(d => (
            <span class="bg-[#171717] text-white px-2 py-0.5 rounded text-[12px]">{d}</span>
          ))}
          {search && <span class="bg-[#F5F5F5] px-2 py-0.5 rounded">搜索: {search}</span>}
        </div>
      )}
    </div>

    {mcps.length > 0 ? (
      <>
        <div id="mcp-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-3">
          {mcps.map(m => (
            <SkillCard
              uid={m.uid}
              title={m.title}
              description={m.description}
              author={m.author}
              tags={m.metrics.tags}
              icon={m.icon}
              websiteUrl={m.github_url}
              subCategory="mcp"
            />
          ))}
        </div>

        <Pagination
          currentPage={page}
          totalPages={totalPages}
          totalItems={total}
          pageSize={pageSize}
          itemTypeLabel="MCP 服务"
          baseUrl="/skills/mcp"
          queryParams={queryParams}
        />
      </>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-[#E5E5E5]">
        <div class="text-6xl mb-4">🔗</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无 MCP 资源</h3>
        <p class="text-[#525252]">当前筛选条件下暂无 MCP 资源</p>
      </div>
    )}
  </div>
</Layout>

<script>
  import { initCardClick } from '../../scripts/cardClick';
  initCardClick();
</script>