---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import mcpData from '../../../data/mcp.json';

export async function getStaticPaths() {
  const posts = await getCollection('mcps');
  const mcpUids = new Set(mcpData.map(m => m.id || m.uid));
  return posts
    .filter(entry => mcpUids.has(entry.data.uid))
    .map(entry => ({
      params: { uid: entry.data.uid },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const mcpInfo = entry.data;
const fullMcp = mcpData.find(m => (m.id || m.uid) === mcpInfo.uid);
---

<Layout title={fullMcp?.title || 'MCP 服务详情'}>
  <div class="flex min-h-screen bg-white bg-clip-content px-[140px]">
    <article class="flex-1 min-w-0">
      <div class="mx-auto px-8 md:px-16 py-20">

        <header class="mb-16 pb-12 border-b border-slate-100">
          <div class="flex items-start gap-6 mb-8">
            <div class="w-20 h-20 rounded-2xl border border-slate-200 bg-white flex items-center justify-center p-3 shadow-sm">
              <span class="text-[40px]">⚙</span>
            </div>
            <div class="flex-1">
              <h1 class="text-[44px] font-black text-slate-900 leading-[1.1] tracking-tight mb-3">
                {fullMcp?.title || 'MCP 服务详情'}
              </h1>
              <p class="text-[16px] text-slate-500 leading-relaxed">
                {mcpInfo.introduction || fullMcp?.description}
              </p>
            </div>
          </div>

          <!-- 作者信息 -->
          {fullMcp?.author && (
            <div class="flex items-center gap-2 mb-6">
              <span class="text-[12px] text-slate-400 uppercase tracking-wider font-bold">作者</span>
              <span class="text-[14px] text-slate-700 font-semibold">{fullMcp.author}</span>
            </div>
          )}

          <!-- Tags 标签 + GitHub 链接 -->
          <div class="flex flex-wrap items-center gap-2">
            {fullMcp?.tags && fullMcp.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {fullMcp.tags.map((tag: string) => (
                  <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[12px] rounded-full font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            {fullMcp?.github_url && (
              <a
                href={fullMcp.github_url}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto flex items-center gap-2 px-3 py-1 bg-slate-100 text-slate-500 text-[12px] rounded-full font-medium hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                <span class="underline">GitHub</span>
              </a>
            )}
          </div>
        </header>

        <!-- 详情内容 -->
        <div id="custom-article-content">
          <Content />
        </div>

        <!-- 底部信息 -->
        <footer class="mt-20 pt-8 border-t border-slate-200">
          <div class="flex items-center justify-between">
            <span class="text-[12px] text-slate-400">MCP UID: {mcpInfo.uid}</span>
            <a
              href="/skills/mcp"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[13px] font-bold rounded-full transition-all duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              <span>返回列表</span>
            </a>
          </div>
        </footer>
      </div>
    </article>

    <!-- 右侧导航 -->
    <aside class="w-[320px] shrink-0 border-l border-slate-50 hidden xl:block">
      <div class="sticky top-0 h-screen p-10 overflow-y-auto custom-scrollbar">
        <nav class="space-y-1">
          {headings.filter(h => h.depth >= 2).map((h) => (
            <a href={`#${h.slug}`} class={`group flex items-center py-2 px-3 transition-all rounded-lg hover:bg-slate-50 hover:text-indigo-600 ${h.depth === 2 ? 'text-[13px] font-bold text-slate-800' : 'text-[12px] text-slate-500 ml-4'}`}>
              <span class="truncate">{h.text}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</Layout>

<style is:global>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5c1;
  }

  #custom-article-content h2,
  #custom-article-content h3,
  #custom-article-content h4 {
    scroll-margin-top: 120px;
  }

  #custom-article-content {
    font-family: 'Inter', system-ui, sans-serif;
    color: #334155;
    line-height: 1.8;
    font-size: 16px;
  }

  #custom-article-content h2 {
    font-size: 28px;
    font-weight: 900;
    color: #0f172a;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }

  #custom-article-content h3 {
    font-size: 20px;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  #custom-article-content p {
    margin-bottom: 1.5rem;
  }

  #custom-article-content ul {
    list-style-type: disc;
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  #custom-article-content li {
    margin-bottom: 0.5rem;
  }

  #custom-article-content strong {
    color: #0f172a;
    font-weight: 800;
  }

  #custom-article-content pre {
    background-color: #0d1117;
    padding: 1.5rem;
    border-radius: 1rem;
    margin: 2.5rem 0;
    overflow-x: auto;
    border: 1px solid #1e293b;
  }

  #custom-article-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  #custom-article-content :not(pre) > code {
    background-color: #f1f5f9;
    color: #4f46e5;
    padding: 0.2rem 0.4rem;
    border-radius: 0.4rem;
    font-weight: 600;
  }

  #custom-article-content blockquote {
    border-left: 4px solid #e2e8f0;
    padding-left: 1.5rem;
    font-style: italic;
    color: #64748b;
    margin: 2rem 0;
  }

  #custom-article-content img {
    border-radius: 1rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    margin: 1.5rem 0;
    max-width: 100%;
  }
</style>