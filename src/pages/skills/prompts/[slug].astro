---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import promptsData from '../../../data/prompts.json';

export async function getStaticPaths() {
  const posts = await getCollection('prompts');
  return posts.map(entry => {
    // 从 JSON 数据中找到对应的 prompt
    const prompt = promptsData.find(p => p.id === entry.data.uid || p.uid === entry.data.uid);
    // 优先使用 slug，如果没有则使用 uid
    const slug = prompt?.slug && prompt.slug.trim() !== '' ? prompt.slug : entry.data.uid;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const promptData = entry.data;
const fullPrompt = promptsData.find(p => (p.id || p.uid) === promptData.uid);
---

<Layout title={fullPrompt?.title || '提示词详情'}>
  <div class="flex min-h-screen bg-white bg-clip-content px-[140px]">
    <article class="flex-1 min-w-0">
      <div class="mx-auto px-8 md:px-16 py-20">

        <header class="mb-16 pb-12 border-b border-slate-100">
          <div class="flex items-start gap-6 mb-8">
            <div class="w-20 h-20 rounded-2xl border border-slate-200 bg-white flex items-center justify-center p-3 shadow-sm">
              <span class="text-[40px]">🖉</span>
            </div>
            <div class="flex-1">
              <h1 class="text-[44px] font-black text-slate-900 leading-[1.1] tracking-tight mb-3">
                {fullPrompt?.title || '提示词详情'}
              </h1>
              <p class="text-[16px] text-slate-500 leading-relaxed">
                {promptData.introduction || fullPrompt?.description}
              </p>
            </div>
          </div>

          <!-- 分类信息 -->
          {fullPrompt?.category && (
            <div class="flex flex-wrap items-center gap-6">
              <div class="flex items-center gap-2 px-4 py-2 bg-indigo-50 rounded-full border border-indigo-100">
                <span class="text-[10px] font-bold text-indigo-500 uppercase tracking-wider">场景</span>
                <span class="text-[13px] font-black text-indigo-700">{fullPrompt.category.scenario}</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-2 bg-purple-50 rounded-full border border-purple-100">
                <span class="text-[10px] font-bold text-purple-500 uppercase tracking-wider">任务</span>
                <span class="text-[13px] font-black text-purple-700">{fullPrompt.category.task}</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-2 bg-blue-50 rounded-full border border-blue-100">
                <span class="text-[10px] font-bold text-blue-500 uppercase tracking-wider">模态</span>
                <span class="text-[13px] font-black text-blue-700">{fullPrompt.category.modality}</span>
              </div>
            </div>
          )}

          <!-- Tags 标签 + 数据来源 -->
          <div class="flex flex-wrap items-center gap-2 mt-6">
            {fullPrompt?.tags && fullPrompt.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {fullPrompt.tags.map((tag: string) => (
                  <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[12px] rounded-full font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            {fullPrompt?.websiteUrl && (
              <a
                href={fullPrompt.websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto flex items-center gap-2 px-3 py-1 bg-slate-100 text-slate-500 text-[12px] rounded-full font-medium hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
              >
                <span class="text-slate-400">数据来源</span>
                <span class="underline">{new URL(fullPrompt.websiteUrl).hostname}</span>
              </a>
            )}
          </div>
        </header>

        <!-- 详情内容 -->
        <div id="custom-article-content">
          <Content />
        </div>

        <!-- 底部信息 -->
        <footer class="mt-20 pt-8 border-t border-slate-200">
          <div class="flex items-center justify-between">
            <span class="text-[12px] text-slate-400">Prompt UID: {promptData.uid}</span>
            <a
              href="/skills/prompts"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[13px] font-bold rounded-full transition-all duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              <span>返回列表</span>
            </a>
          </div>
        </footer>
      </div>
    </article>

    <!-- 右侧导航 -->
    <aside class="w-[320px] shrink-0 border-l border-slate-50 hidden xl:block">
      <div class="sticky top-0 h-screen p-10 overflow-y-auto custom-scrollbar">
        <nav class="space-y-1">
          {headings.filter(h => h.depth >= 2).map((h) => (
            <a href={`#${h.slug}`} class={`group flex items-center py-2 px-3 transition-all rounded-lg hover:bg-slate-50 hover:text-indigo-600 ${h.depth === 2 ? 'text-[13px] font-bold text-slate-800' : 'text-[12px] text-slate-500 ml-4'}`}>
              <span class="truncate">{h.text}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>

  <!-- 图片预览模态框 -->
  <div id="image-lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm">
    <button id="lightbox-close" class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center text-white/70 hover:text-white transition-colors cursor-pointer">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <img id="lightbox-image" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl" src="" alt="">
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 处理 <script class="md-md-raw"> 标签 - 将其转换为格式化的 pre 块
    const mdBlocks = document.querySelectorAll('script.md-md-raw');
    mdBlocks.forEach((block) => {
      const content = block.textContent || '';
      const wrapper = document.createElement('pre');
      wrapper.className = 'md-content-block';
      wrapper.style.whiteSpace = 'pre-wrap';
      wrapper.style.wordWrap = 'break-word';
      wrapper.style.backgroundColor = '#f6f8fa';
      wrapper.style.padding = '16px';
      wrapper.style.borderRadius = '8px';
      wrapper.style.border = '1px solid #e1e4e8';
      wrapper.style.fontFamily = 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace';
      wrapper.style.fontSize = '14px';
      wrapper.style.lineHeight = '1.6';
      wrapper.style.color = '#24292f';
      wrapper.style.overflow = 'auto';
      wrapper.style.margin = '1.5rem 0';
      wrapper.textContent = content;
      block.replaceWith(wrapper);
    });

    // 处理 <md-image-grid> 自定义标签
    const imageGrids = document.querySelectorAll('md-image-grid');
    imageGrids.forEach((grid) => {
      const content = grid.textContent?.trim() || '';
      const lines = content.split('\n').map(line => line.trim()).filter(line => line);

      if (lines.length === 0) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'grid grid-cols-2 md:grid-cols-4 gap-3 my-6';

      lines.forEach((src) => {
        const imgContainer = document.createElement('div');
        imgContainer.className = 'aspect-square overflow-hidden rounded-xl bg-slate-100';

        const img = document.createElement('img');
        img.src = src;
        img.alt = '示例图片';
        img.className = 'w-full h-full object-cover cursor-zoom-in hover:scale-105 transition-transform duration-300';
        img.loading = 'lazy';

        img.addEventListener('click', () => {
          const lightbox = document.getElementById('image-lightbox');
          const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
          if (lightbox && lightboxImage) {
            lightboxImage.src = src;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        });

        imgContainer.appendChild(img);
        wrapper.appendChild(imgContainer);
      });

      grid.replaceWith(wrapper);
    });

    // 图片预览关闭功能
    const lightbox = document.getElementById('image-lightbox');
    const lightboxClose = document.getElementById('lightbox-close');

    const closeLightbox = () => {
      lightbox?.classList.add('hidden');
      lightbox?.classList.remove('flex');
      document.body.style.overflow = '';
    };

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox?.classList.contains('hidden')) closeLightbox();
    });
  });
</script>

<style is:global>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
  }

  #custom-article-content h2,
  #custom-article-content h3,
  #custom-article-content h4 {
    scroll-margin-top: 120px;
  }

  #custom-article-content {
    font-family: 'Inter', system-ui, sans-serif;
    color: #334155;
    line-height: 1.8;
    font-size: 16px;
  }

  #custom-article-content h2 {
    font-size: 28px;
    font-weight: 900;
    color: #0f172a;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }

  #custom-article-content h3 {
    font-size: 20px;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  #custom-article-content p {
    margin-bottom: 1.5rem;
  }

  #custom-article-content ul {
    list-style-type: disc;
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  #custom-article-content li {
    margin-bottom: 0.5rem;
  }

  #custom-article-content strong {
    color: #0f172a;
    font-weight: 800;
  }

  #custom-article-content pre {
    background-color: #0d1117;
    padding: 1.5rem;
    border-radius: 1rem;
    margin: 2.5rem 0;
    overflow-x: auto;
    border: 1px solid #1e293b;
  }

  #custom-article-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  #custom-article-content :not(pre) > code {
    background-color: #f1f5f9;
    color: #4f46e5;
    padding: 0.2rem 0.4rem;
    border-radius: 0.4rem;
    font-weight: 600;
  }

  #custom-article-content blockquote {
    border-left: 4px solid #e2e8f0;
    padding-left: 1.5rem;
    font-style: italic;
    color: #64748b;
    margin: 2rem 0;
  }

  #custom-article-content img {
    border-radius: 1rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    margin: 1.5rem 0;
    max-width: 100%;
  }

  /* md-md 内容块样式 */
  .md-content-block {
    margin: 1.5rem 0;
  }
</style>