---
import Layout from '../../layouts/Layout.astro';
import SkillCard from '../../components/SkillCard.astro';
import promptsData from '../../data/prompts.json';
import { skillsSubNav, sidebarFilters } from '../../data/navigation';
const { models, scenes, types } = sidebarFilters.prompts;

const subNav = {
  activeTab: 'prompts',
  tabs: skillsSubNav,
};
---

<Layout title="提示词 - AI Links" subNav={subNav}>
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-with-subnav))] sticky top-[var(--sidebar-top-with-subnav)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <!-- 适用模型 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">适用模型</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="model" id="model-filters">
        {models.map((model) => (
          <button
            data-model={model}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{model}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 应用场景 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">应用场景</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="scene" id="scene-filters">
        {scenes.map((item) => {
          const scene = item.path.replace('?scene=', '');
          return (
            <button
              data-scene={scene}
              class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
            >
              {item.icon && <span class="mr-0.5">{item.icon}</span>}
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 提示词类型 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">提示词类型</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="prompttype" id="prompttype-filters">
        {types.map((type) => (
          <button
            data-prompttype={type}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{type}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">提示词 Prompts</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input
          type="text"
          placeholder="搜索提示词..."
          class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200"
        />
      </div>

      <div class="flex-1"></div>
    </div>

    {promptsData.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-3">
        {promptsData.map(s => <SkillCard {...s} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-[#E5E5E5]">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无提示词</h3>
        <p class="text-[#525252]">分享你的第一个 Prompt！</p>
      </div>
    )}
  </div>
</Layout>

<script>
  import { initMultiFilter } from '../../lib/multiFilter';
  import { initCardClick } from '../../scripts/cardClick';
  initMultiFilter();
  initCardClick();
</script>
