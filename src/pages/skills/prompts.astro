---
import Layout from '../../layouts/Layout.astro';
import SkillCard from '../../components/SkillCard.astro';
import skills from '../../data/skills.json';
import { skillsSubNav, sidebarFilters } from '../../data/navigation';

const promptsData = skills.filter((s: any) => s.subCategory === 'prompts' || !s.subCategory);
const { models, scenes, types } = sidebarFilters.prompts;

const subNav = {
  activeTab: 'prompts',
  tabs: skillsSubNav,
};
---

<Layout title="提示词 - AI Links" subNav={subNav}>
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-with-subnav)] p-6 transition-all duration-200">
    <h3 class="text-[14px] font-bold text-gray-400 mb-4 uppercase tracking-widest">适用模型</h3>
    <div class="space-y-2 mb-6">
      {models.map((model) => (
        <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
          <input type="checkbox" class="rounded border-gray-300" /> {model}
        </label>
      ))}
    </div>

    <h3 class="text-[14px] font-bold text-gray-400 mb-4 uppercase tracking-widest">应用场景</h3>
    <div class="flex flex-wrap gap-1" data-filter="scene" id="scene-filters">
      {scenes.map((item) => {
        const scene = item.path.replace('?scene=', '');
        return (
          <button
            data-scene={scene}
            class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1"
          >
            {item.icon && <span class="mr-0.5">{item.icon}</span>}
            <span>{item.name}</span>
            <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
          </button>
        );
      })}
    </div>

    <h3 class="text-[14px] font-bold text-gray-400 mt-6 mb-4 uppercase tracking-widest">提示词类型</h3>
    <div class="space-y-2">
      {types.map((type) => (
        <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
          <input type="checkbox" class="rounded border-gray-300" /> {type}
        </label>
      ))}
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">提示词 Prompts</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-gray-400">🔍</span>
        <input
          type="text"
          placeholder="搜索提示词..."
          class="w-full bg-white border border-gray-200 rounded-full py-2 pl-10 pr-4 text-[13px] placeholder:text-gray-400 focus:border-blue-400 focus:ring-4 focus:ring-blue-50/50 outline-none"
        />
      </div>

      <div class="flex-1"></div>
    </div>

    {promptsData.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-3 gap-y-2">
        {promptsData.map(s => <SkillCard {...s} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无提示词</h3>
        <p class="text-gray-500">分享你的第一个 Prompt！</p>
      </div>
    )}
  </div>
</Layout>

<script>
  import { initMultiFilter } from '../../lib/multiFilter';
  initMultiFilter();
</script>
