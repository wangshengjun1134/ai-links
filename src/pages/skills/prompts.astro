---
import Layout from '../../layouts/Layout.astro';
import SubNav from '../../components/SubNav.astro';
import SkillCard from '../../components/SkillCard.astro';
import skills from '../../data/skills.json';

const promptsData = skills.filter((s: any) => s.subCategory === 'prompts' || !s.subCategory);
const itemCount = promptsData.length;
---

<Layout title="提示词 - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-gray-100 h-fit sticky top-16 p-6">
    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">适用模型</h3>
    <div class="space-y-2 mb-6">
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> GPT-4 / ChatGPT
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> Claude
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> Gemini
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> 文心一言
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> 通义千问
      </label>
    </div>

    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">应用场景</h3>
    <div class="flex flex-wrap gap-1">
      <a href="?scene=writing" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">✍️ 写作</a>
      <a href="?scene=code" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">💻 编程</a>
      <a href="?scene=translate" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">🌐 翻译</a>
      <a href="?scene=design" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">🎨 设计</a>
      <a href="?scene=marketing" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">📢 营销</a>
      <a href="?scene=analysis" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">📊 分析</a>
    </div>

    <h3 class="text-xs font-bold text-gray-500 mt-6 mb-4 uppercase tracking-wider">提示词类型</h3>
    <div class="space-y-2">
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> 结构化模板
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> 角色设定
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
        <input type="checkbox" class="rounded" /> 工作流
      </label>
    </div>
  </aside>

  <div class="p-6">
    <SubNav activeTab="prompts" />

    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">提示词 Prompts</h2>
      <span class="text-[12px] font-mono text-gray-500 bg-gray-100/50 px-2 py-0.5 rounded-full">{itemCount}</span>
      <div class="flex-1"></div>
      <button class="px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-bold hover:bg-blue-700">分享 Prompt</button>
    </div>

    {itemCount > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {promptsData.map(s => <SkillCard {...s} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无提示词</h3>
        <p class="text-gray-500">分享你的第一个 Prompt！</p>
      </div>
    )}
  </div>
</Layout>
