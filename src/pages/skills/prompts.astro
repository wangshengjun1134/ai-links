---
import Layout from '../../layouts/Layout.astro';
import SkillCard from '../../components/SkillCard.astro';
import promptsData from '../../data/prompts.json';
import { skillsSubNav } from '../../data/navigation';

const subNav = {
  activeTab: 'prompts',
  tabs: skillsSubNav,
};

// 场景分类
const scenarios = [
  { name: '内容创作', icon: '✍️' },
  { name: '办公效率', icon: '💼' },
  { name: '数据分析', icon: '📊' },
  { name: '编程开发', icon: '💻' },
  { name: '学习教育', icon: '📚' },
  { name: '多模态生成', icon: '🎨' },
  { name: 'AI Agent', icon: '🤖' },
];

// 任务分类
const tasks = [
  { name: '写作', icon: '✍️' },
  { name: '总结', icon: '📋' },
  { name: '改写', icon: '✏️' },
  { name: '翻译', icon: '🌐' },
  { name: '生成', icon: '✨' },
  { name: '分析', icon: '🔍' },
  { name: '提取', icon: '📤' },
  { name: '规划', icon: '📐' },
];

// 模态分类
const modalities = [
  { name: 'text', label: '文本', icon: '📝' },
  { name: 'image', label: '图像', icon: '🖼️' },
  { name: 'video', label: '视频', icon: '🎬' },
  { name: 'audio', label: '音频', icon: '🎧' },
  { name: 'multimodal', label: '多模态', icon: '🧩' },
];
---

<Layout title="提示词 - AI Links" subNav={subNav}>
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-with-subnav))] sticky top-[var(--sidebar-top-with-subnav)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <!-- 场景分类 -->
    <div class="flex flex-col gap-3 pb-5 mb-5 border-b border-[#F0F0F0]">
      <h5 class="text-[13px] font-bold text-[#171717]">📁 场景</h5>
      <div class="flex flex-wrap gap-1.5" data-filter="scenario">
        {scenarios.map((item) => (
          <button
            data-scenario={item.name}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{item.icon}</span>
            <span>{item.name}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 任务分类 -->
    <div class="flex flex-col gap-3 pb-5 mb-5 border-b border-[#F0F0F0]">
      <h5 class="text-[13px] font-bold text-[#171717]">🎯 任务</h5>
      <div class="flex flex-wrap gap-1.5" data-filter="task">
        {tasks.map((item) => (
          <button
            data-task={item.name}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{item.icon}</span>
            <span>{item.name}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 模态分类 -->
    <div class="flex flex-col gap-3">
      <h5 class="text-[13px] font-bold text-[#171717]">🎭 模态</h5>
      <div class="flex flex-wrap gap-1.5" data-filter="modality">
        {modalities.map((item) => (
          <button
            data-modality={item.name}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{item.icon}</span>
            <span>{item.label}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">提示词 Prompts</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input
          type="text"
          id="prompt-search"
          placeholder="搜索提示词..."
          class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200"
        />
      </div>

      <div class="flex-1"></div>
    </div>

    {promptsData.length > 0 ? (
      <>
        <div id="prompt-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-3">
          {promptsData.map(s => {
            const scenario = s.category?.scenario || '';
            const task = s.category?.task || '';
            const modality = s.category?.modality || '';
            const tags = s.tags || [];
            return (
              <div
                class="prompt-item"
                data-prompt-name={s.title.toLowerCase()}
                data-scenario={scenario.toLowerCase()}
                data-task={task.toLowerCase()}
                data-modality={modality.toLowerCase()}
                data-tags={tags.join(',').toLowerCase()}
                data-description={s.description.toLowerCase()}
              >
                <SkillCard {...s} modality={modality} />
              </div>
            );
          })}
        </div>

        <!-- 分页组件 -->
        <div id="pagination" class="mt-12 flex items-center justify-center gap-4">
          <button id="prev-btn" class="p-2.5 rounded-xl border border-[#E5E5E5] bg-white hover:border-[#171717] hover:text-[#171717] hover:shadow-sm disabled:opacity-30 disabled:cursor-not-allowed transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <div id="page-info" class="text-[13px] font-medium text-[#525252]"></div>
          <button id="next-btn" class="p-2.5 rounded-xl border border-[#E5E5E5] bg-white hover:border-[#171717] hover:text-[#171717] hover:shadow-sm disabled:opacity-30 disabled:cursor-not-allowed transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-[#E5E5E5]">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无提示词</h3>
        <p class="text-[#525252]">分享你的第一个 Prompt！</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .prompt-item.v-hidden {
    display: none !important;
  }
</style>

<script>
  import { initMultiFilter } from '../../lib/multiFilter';
  import { initCardClick } from '../../scripts/cardClick';

  initMultiFilter();
  initCardClick();

  const CONFIG = {
    pageSize: 30,
  };

  let state = {
    currentPage: 1,
    allCards: [] as HTMLElement[],
    filteredCards: [] as HTMLElement[],
  };

  function init() {
    // 获取所有卡片
    state.allCards = Array.from(document.querySelectorAll('#prompt-list .prompt-item')) as HTMLElement[];
    state.filteredCards = [...state.allCards];

    const searchInput = document.getElementById('prompt-search');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    // 搜索事件
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.toLowerCase().trim();

        state.filteredCards = state.allCards.filter(card => {
          const name = card.getAttribute('data-prompt-name') || '';
          const description = card.getAttribute('data-description') || '';
          const tags = card.getAttribute('data-tags') || '';
          return name.includes(val) || description.includes(val) || tags.includes(val);
        });

        state.currentPage = 1;
        render();
      });
    }

    // 监听侧边栏过滤事件
    document.addEventListener('filtersChanged', () => {
      // 根据当前可见的卡片更新 filteredCards
      state.filteredCards = state.allCards.filter(card => {
        return card.style.display !== 'none';
      });

      // 重置到第一页
      state.currentPage = 1;
      render();
    });

    // 翻页事件
    if (prevBtn) {
      prevBtn.onclick = () => {
        if (state.currentPage > 1) {
          state.currentPage--;
          render();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        const totalPages = Math.ceil(state.filteredCards.length / CONFIG.pageSize);
        if (state.currentPage < totalPages) {
          state.currentPage++;
          render();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      };
    }

    render();
  }

  function render() {
    const totalPages = Math.ceil(state.filteredCards.length / CONFIG.pageSize);
    const start = (state.currentPage - 1) * CONFIG.pageSize;
    const end = start + CONFIG.pageSize;

    // 1. 处理显隐
    state.allCards.forEach(card => card.classList.add('v-hidden'));
    state.filteredCards.slice(start, end).forEach(card => card.classList.remove('v-hidden'));

    // 2. 更新按钮状态
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    if (prevBtn) prevBtn.disabled = state.currentPage === 1;
    if (nextBtn) nextBtn.disabled = state.currentPage === totalPages || totalPages === 0;

    // 3. 更新页码显示
    const pageInfo = document.getElementById('page-info');
    if (pageInfo) {
      pageInfo.textContent = totalPages > 0
        ? `第 ${state.currentPage} / ${totalPages} 页（共 ${state.filteredCards.length} 个提示词）`
        : '无结果';
    }
  }

  // 启动
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>