---
import { getCollection } from 'astro:content';
import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import products from '../../data/products.json';

const siteUrl = "https://ai-links.cn";

export async function getStaticPaths() {
  const posts = await getCollection('products');
  const productUids = new Set(products.map(p => p.uid));
  return posts
    .filter(entry => {
      const uid = entry.slug.split('/').pop() || entry.slug;
      return productUids.has(uid);
    })
    .map(entry => {
      const uid = entry.slug.split('/').pop() || entry.slug;
      return {
        params: { slug: uid },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const productData = entry.data;

// 从 products.json 中获取完整的 metrics 数据
const fullProduct = products.find(p => p.uid === productData.uid);
const metrics = fullProduct?.metrics;

// 提取 productType 信息
const productType = metrics?.productType;
const isProductTypeObject = productType && typeof productType === 'object' && !Array.isArray(productType);
const level1 = isProductTypeObject ? productType.level1 : null;
const level2 = isProductTypeObject ? productType.level2 : null;
const tags = isProductTypeObject ? productType.tags || [] : [];
---

<DetailPageLayout
  title={productData.aiProductName}
  logo={productData.logo}
  productName={productData.aiProductName}
  introduction={productData.introduction}
  company={productData.company}
  country={productData.country}
  modelLevel={productData.modelLevel}
  websiteUrl={productData.websiteUrl}
  uid={productData.uid}
  uidLabel="产品 UID"
  level1={level1}
  level2={level2}
  tags={tags}
  content={Content}
  headings={headings}
/>