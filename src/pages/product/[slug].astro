---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';

export async function getStaticPaths() {
  const posts = await getCollection('products');
  // 只生成 products.json 中存在的产品路径
  const productUids = new Set(products.map(p => p.uid));
  return posts
    .filter(entry => productUids.has(entry.slug))
    .map(entry => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// 从 entry.data 获取元数据
const productData = entry.data;

// 从 products.json 中获取完整的 metrics 数据
const fullProduct = products.find(p => p.uid === productData.uid);
const metrics = fullProduct?.metrics;

// 提取 productType 信息
const productType = metrics?.productType;
const isProductTypeObject = productType && typeof productType === 'object' && !Array.isArray(productType);
const level1 = isProductTypeObject ? productType.level1 : null;
const level2 = isProductTypeObject ? productType.level2 : null;
const tags = isProductTypeObject ? productType.tags || [] : [];
---

<Layout title={productData.aiProductName}>
  <div class="flex min-h-screen bg-white bg-clip-content px-[140px]">
    <article class="flex-1 min-w-0">
      <div class="mx-auto px-8 md:px-16 py-20">

        <header class="mb-16 pb-12 border-b border-slate-100">
          <!-- Logo 和产品名称 -->
          <div class="flex items-start gap-6 mb-8">
            <div class="w-20 h-20 rounded-2xl border border-slate-200 bg-white flex items-center justify-center p-3 shadow-sm">
              <img
                src={productData.logo}
                alt={productData.aiProductName}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="flex-1">
              <h1 class="text-[44px] font-black text-slate-900 leading-[1.1] tracking-tight mb-3">
                {productData.aiProductName}
              </h1>
              <p class="text-[16px] text-slate-500 leading-relaxed">
                {productData.introduction}
              </p>
            </div>
          </div>

          <!-- 元数据 -->
          <div class="flex flex-wrap items-center gap-6">
            <!-- 公司/开发者 -->
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-white text-[12px] font-black">
                {productData.company.charAt(0).toUpperCase()}
              </div>
              <div class="flex flex-col text-[13px]">
                <span class="font-bold text-slate-900">{productData.company}</span>
                <span class="font-medium text-slate-400 font-mono tracking-tighter">{productData.country}</span>
              </div>
            </div>

            <!-- 模型等级 -->
            {productData.modelLevel && (
              <div class="flex items-center gap-2 px-4 py-2 bg-slate-50 rounded-full border border-slate-200">
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">模型等级</span>
                <span class={`text-[13px] font-black ${
                  productData.modelLevel === 'S-Tier' ? 'text-amber-600' :
                  productData.modelLevel === 'A-Tier' ? 'text-purple-600' :
                  'text-blue-600'
                }`}>
                  {productData.modelLevel}
                </span>
              </div>
            )}

            <!-- 产品分类 -->
            {(level1 || level2) && (
              <div class="flex items-center gap-2 px-4 py-2 bg-indigo-50 rounded-full border border-indigo-100">
                <span class="text-[10px] font-bold text-indigo-500 uppercase tracking-wider">分类</span>
                <div class="flex items-center gap-1.5">
                  {level1 && (
                    <span class="text-[13px] font-black text-indigo-700">
                      {level1}
                    </span>
                  )}
                  {level1 && level2 && (
                    <svg class="w-3 h-3 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  )}
                  {level2 && (
                    <span class="text-[13px] font-black text-indigo-700">
                      {level2}
                    </span>
                  )}
                </div>
              </div>
            )}

            <!-- 访问链接 -->
            {productData.websiteUrl && (
              <a
                href={productData.websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-[13px] font-bold rounded-full transition-all duration-200 shadow-lg shadow-slate-900/20"
              >
                <span>访问官网</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            )}
          </div>
        </header>

        <!-- 详情内容 -->
        <div id="custom-article-content">
          <Content />
        </div>

        <!-- 底部信息 -->
        <footer class="mt-20 pt-8 border-t border-slate-200">
          <div class="flex items-center justify-between">
            <div class="flex flex-col gap-4">
              <span class="text-[12px] text-slate-400">产品 UID: {productData.uid}</span>
              
              <!-- Tags 标签 -->
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag: string) => (
                    <span class="px-3 py-1 bg-slate-100 text-slate-600 text-[12px] rounded-full font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </footer>
      </div>
    </article>

    <!-- 右侧导航 -->
    <aside class="w-[320px] shrink-0 border-l border-slate-50 hidden xl:block">
      <div class="sticky top-0 h-screen p-10 overflow-y-auto custom-scrollbar">
        <nav class="space-y-1">
          {headings.filter(h => h.depth >= 2).map((h) => (
            <a href={`#${h.slug}`} class={`group flex items-center py-2 px-3 transition-all rounded-lg hover:bg-slate-50 hover:text-indigo-600 ${h.depth === 2 ? 'text-[13px] font-bold text-slate-800' : 'text-[12px] text-slate-500 ml-4'}`}>
              <span class="truncate">{h.text}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</Layout>

<style is:global>
  /* 自定义滚动条样式 - 右侧导航栏 */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 3px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
  }

  /* 锚点定位偏移 - 防止被 sticky header 遮挡 */
  #custom-article-content h2,
  #custom-article-content h3,
  #custom-article-content h4 {
    scroll-margin-top: 120px;
  }

  /* 核心排版：这是让它"变好看"的关键 */
  #custom-article-content {
    font-family: 'Inter', system-ui, sans-serif;
    color: #334155; /* slate-700 */
    line-height: 1.8;
    font-size: 16px;
  }

  /* 标题：大而黑，增加间距 */
  #custom-article-content h2 {
    font-size: 28px;
    font-weight: 900;
    color: #0f172a;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }

  #custom-article-content h3 {
    font-size: 20px;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* 段落与列表：解决拥挤问题 */
  #custom-article-content p {
    margin-bottom: 1.5rem;
  }

  #custom-article-content ul {
    list-style-type: disc;
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  #custom-article-content li {
    margin-bottom: 0.5rem;
  }

  /* 重点文本 */
  #custom-article-content strong {
    color: #0f172a;
    font-weight: 800;
  }

  /* 代码块：工业深色风 */
  #custom-article-content pre {
    background-color: #0d1117;
    padding: 1.5rem;
    border-radius: 1rem;
    margin: 2.5rem 0;
    overflow-x: auto;
    border: 1px solid #1e293b;
  }

  #custom-article-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  /* 行内代码 */
  #custom-article-content :not(pre) > code {
    background-color: #f1f5f9;
    color: #4f46e5;
    padding: 0.2rem 0.4rem;
    border-radius: 0.4rem;
    font-weight: 600;
  }

  /* 引用 */
  #custom-article-content blockquote {
    border-left: 4px solid #e2e8f0;
    padding-left: 1.5rem;
    font-style: italic;
    color: #64748b;
    margin: 2rem 0;
  }

  /* 图片 */
  #custom-article-content img {
    border-radius: 1rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    margin: 3rem auto;
    max-width: 100%;
  }
</style>
