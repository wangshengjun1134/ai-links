---
// 详情页使用预渲染（SSG）
export const prerender = true;

import { getCollection } from 'astro:content';
import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import { getProductBySlug, getAllProductSlugs } from '../../lib/db';

// 构建时从数据库获取 slug 列表
export async function getStaticPaths() {
  const slugs = await getAllProductSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

// 从数据库获取产品信息
const p = await getProductBySlug(slug);

if (!p) {
  return Astro.redirect('/404');
}

// 通过 uid 找到对应的 Markdown 文件
// content collection 的 slug 格式是小写的 "uid/uid"
const posts = await getCollection('products');
const uid = p.uid;
const lowerUid = uid.toLowerCase();
const entry = posts.find(e => e.slug === `${lowerUid}/${lowerUid}` || e.id === `${uid}/${uid}.md`);

// 获取 Content 组件和 headings
const { Content, headings } = entry ? await entry.render() : { Content: null, headings: [] };

const product = {
  uid: p.uid,
  slug: p.slug,
  logo: p.logo,
  aiProductName: p.aiProductName,
  introduction: p.introduction,
  websiteUrl: p.websiteUrl,
  metrics: {
    level1: p.metrics.level1 || '',
    level2: p.metrics.level2 || '',
    tags: p.metrics.tags || [],
    country: p.metrics.country || '',
    company: p.metrics.company || '',
    hasApi: p.metrics.hasApi || false,
    needVpn: p.metrics.needVpn || false,
    pricingModel: p.metrics.pricingModel || [],
    useType: p.metrics.useType || [],
    languages: p.metrics.languages || [],
    rawProductType: p.metrics.rawProductType || [],
  },
};
---

<DetailPageLayout
  title={product.aiProductName}
  logo={product.logo}
  productName={product.aiProductName}
  introduction={product.introduction}
  company={product.metrics?.company || '未知'}
  country={product.metrics?.country || 'N/A'}
  websiteUrl={product.websiteUrl}
  uid={product.uid}
  uidLabel="产品 UID"
  level1={product.metrics.level1 || null}
  level2={product.metrics.level2 || null}
  tags={product.metrics.tags || []}
  content={Content}
  headings={headings}
/>