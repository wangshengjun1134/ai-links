---
// 详情页使用预渲染（SSG）
export const prerender = true;

import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import { marked } from 'marked';
import { getProductBySlug, getAllProductSlugs } from '../../lib/db';
import fs from 'fs';
import path from 'path';

// 构建时从数据库获取 slug 列表
export async function getStaticPaths() {
  const slugs = await getAllProductSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

// 从数据库获取产品信息
const p = await getProductBySlug(slug);

if (!p) {
  return Astro.redirect('/404');
}

// 尝试读取 Markdown 正文内容
let detailContent = '';
const mdPath = path.join(process.cwd(), 'src', 'content', 'products', p.uid, `${p.uid}.md`);
if (fs.existsSync(mdPath)) {
  detailContent = fs.readFileSync(mdPath, 'utf-8');
}

const product = {
  uid: p.uid,
  slug: p.slug,
  logo: p.logo,
  aiProductName: p.aiProductName,
  introduction: p.introduction,
  websiteUrl: p.websiteUrl,
  detail: detailContent || p.introduction,
  metrics: {
    level1: p.metrics.level1 || '',
    level2: p.metrics.level2 || '',
    tags: p.metrics.tags || [],
    country: p.metrics.country || '',
    company: p.metrics.company || '',
    hasApi: p.metrics.hasApi || false,
    needVpn: p.metrics.needVpn || false,
    pricingModel: p.metrics.pricingModel || [],
    useType: p.metrics.useType || [],
    languages: p.metrics.languages || [],
    rawProductType: p.metrics.rawProductType || [],
  },
};

// 渲染 Markdown 正文为 HTML
const contentHtml = product.detail
  ? await marked.parse(product.detail)
  : `<p>${product.introduction}</p>`;

// 提取 productType 信息
const level1 = product.metrics.level1 || null;
const level2 = product.metrics.level2 || null;
const tags = product.metrics.tags || [];
---

<DetailPageLayout
  title={product.aiProductName}
  logo={product.logo}
  productName={product.aiProductName}
  introduction={product.introduction}
  company={product.metrics?.company || '未知'}
  country={product.metrics?.country || 'N/A'}
  websiteUrl={product.websiteUrl}
  uid={product.uid}
  uidLabel="产品 UID"
  level1={level1}
  level2={level2}
  tags={tags}
  contentHtml={contentHtml}
/>