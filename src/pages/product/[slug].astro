---
import { getCollection } from 'astro:content';
import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import products from '../../data/products.json';

export async function getStaticPaths() {
  const posts = await getCollection('products');
  const productUids = new Set(products.map(p => p.uid));
  return posts
    .filter(entry => productUids.has(entry.slug))
    .map(entry => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// 文件名即为 uid，所有数据从 products.json 获取
const uid = entry.slug;
const product = products.find(p => p.uid === uid);

if (!product) {
  return Astro.redirect('/404');
}

// 提取 productType 信息
const productType = product.metrics?.productType;
const isProductTypeObject = productType && typeof productType === 'object' && !Array.isArray(productType);
const level1 = isProductTypeObject ? productType.level1 : null;
const level2 = isProductTypeObject ? productType.level2 : null;
const tags = isProductTypeObject ? productType.tags || [] : [];
---

<DetailPageLayout
  title={product.aiProductName}
  logo={product.logo}
  productName={product.aiProductName}
  introduction={product.introduction}
  company={product.metrics?.company || '未知'}
  country={product.metrics?.country || 'N/A'}
  modelLevel={product.metrics?.modelLevel}
  websiteUrl={product.websiteUrl}
  uid={product.uid}
  uidLabel="产品 UID"
  level1={level1}
  level2={level2}
  tags={tags}
  content={Content}
  headings={headings}
/>