---
import Layout from '../layouts/Layout.astro';
import AgentCard from '../components/AgentCard.astro';
import agents from '../data/agents.json';
import { sidebarFilters } from '../data/navigation';

const { types, creators } = sidebarFilters.agents;
---

<Layout title="智能体 Agent - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200">
    <!-- Agent 分类 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">Agent 分类</h4>
      <div class="flex flex-wrap gap-1" id="type-filters">
        {types.map((item) => {
          const type = item.path.replace('?type=', '');
          return (
            <button
              data-type={type}
              class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1"
            >
              {item.icon && <span class="mr-0.5">{item.icon}</span>}
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 创建者 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">创建者</h4>
      <div class="flex flex-wrap gap-1" id="creator-filters">
        {creators.map((item) => {
          const creator = item.path.replace('?creator=', '');
          return (
            <button
              data-creator={creator}
              class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1"
            >
              {item.icon && <span class="mr-0.5">{item.icon}</span>}
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 收费模式 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">收费模式</h4>
      <div class="space-y-2">
        <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
          <input type="checkbox" class="rounded border-gray-300" /> 完全免费
        </label>
        <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
          <input type="checkbox" class="rounded border-gray-300" /> 按量计费
        </label>
        <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
          <input type="checkbox" class="rounded border-gray-300" /> 会员订阅
        </label>
      </div>
    </div>

    <!-- 搜索 -->
    <div class="pt-6 border-t border-gray-100">
      <div class="relative">
        <span class="absolute left-3 top-2.5 text-[14px] text-gray-400">🔍</span>
        <input type="text" placeholder="搜索智能体..." class="w-full bg-white border border-gray-200 rounded-full py-2 pl-9 pr-4 text-[12px] focus:border-blue-400 focus:ring-4 focus:ring-blue-50 outline-none" />
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">智能体 Agent</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-gray-400">🔍</span>
        <input type="text" placeholder="按名称过滤智能体..." class="w-full bg-white border border-gray-200 rounded-full py-2 pl-10 pr-4 text-[13px] focus:border-blue-400 focus:ring-4 focus:ring-blue-50/50 outline-none" />
      </div>

      <div class="flex-1"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-x-3 gap-y-2">
      {agents.map(a => <AgentCard {...a} />)}
    </div>
  </div>
</Layout>

<script>
  function getSelectedFilters(paramName) {
    const params = new URLSearchParams(window.location.search);
    return params.getAll(paramName);
  }

  function updateFilters(paramName, values) {
    const params = new URLSearchParams(window.location.search);
    params.delete(paramName);
    values.forEach(v => params.append(paramName, v));
    const newUrl = params.toString() 
      ? `${window.location.pathname}?${params.toString()}` 
      : window.location.pathname;
    window.history.pushState({}, '', newUrl);
  }

  function toggleFilter(paramName, value, btn) {
    const selected = getSelectedFilters(paramName);
    const index = selected.indexOf(value);
    const closeIcon = btn.querySelector('.close-icon');
    
    if (index > -1) {
      selected.splice(index, 1);
      btn.classList.remove('active');
      btn.classList.add('border-gray-100');
      btn.classList.remove('border-blue-400', 'bg-blue-50', 'text-blue-600');
      if (closeIcon) closeIcon.classList.add('hidden');
    } else {
      selected.push(value);
      btn.classList.add('active');
      btn.classList.remove('border-gray-100');
      btn.classList.add('border-blue-400', 'bg-blue-50', 'text-blue-600');
      if (closeIcon) closeIcon.classList.remove('hidden');
    }
    updateFilters(paramName, selected);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const selectedTypes = getSelectedFilters('type');
    document.querySelectorAll('#type-filters .filter-btn').forEach(btn => {
      const type = btn.getAttribute('data-type');
      const closeIcon = btn.querySelector('.close-icon');
      if (selectedTypes.includes(type)) {
        btn.classList.add('active');
        btn.classList.remove('border-gray-100');
        btn.classList.add('border-blue-400', 'bg-blue-50', 'text-blue-600');
        if (closeIcon) closeIcon.classList.remove('hidden');
      }
      btn.addEventListener('click', (e) => {
        if (e.target.classList.contains('close-icon')) e.stopPropagation();
        toggleFilter('type', type, btn);
      });
      if (closeIcon) {
        closeIcon.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleFilter('type', type, btn);
        });
      }
    });

    const selectedCreators = getSelectedFilters('creator');
    document.querySelectorAll('#creator-filters .filter-btn').forEach(btn => {
      const creator = btn.getAttribute('data-creator');
      const closeIcon = btn.querySelector('.close-icon');
      if (selectedCreators.includes(creator)) {
        btn.classList.add('active');
        btn.classList.remove('border-gray-100');
        btn.classList.add('border-blue-400', 'bg-blue-50', 'text-blue-600');
        if (closeIcon) closeIcon.classList.remove('hidden');
      }
      btn.addEventListener('click', (e) => {
        if (e.target.classList.contains('close-icon')) e.stopPropagation();
        toggleFilter('creator', creator, btn);
      });
      if (closeIcon) {
        closeIcon.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleFilter('creator', creator, btn);
        });
      }
    });
  });
</script>
