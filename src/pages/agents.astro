---
import Layout from '../layouts/Layout.astro';
import AgentCard from '../components/AgentCard.astro';
import Pagination from '../components/Pagination.astro';
import agents from '../data/agents.json';
import { agentFilters } from '../data/filters';

// 从数据中提取唯一的分类值
const getUniqueValues = (key: string): string[] => {
  const values = new Set<string>();
  agents.forEach(a => {
    const value = a.metrics?.[key];
    if (Array.isArray(value)) {
      value.forEach(v => values.add(v));
    } else if (value) {
      values.add(String(value));
    }
  });
  return Array.from(values).sort();
};

const categories = getUniqueValues('category');
const agentLevels = getUniqueValues('agentLevel');
---

<Layout title="智能体 Agent - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <div class="flex flex-col gap-5 mb-7">
      <div class="flex flex-col gap-3 pb-4 border-b border-[#F0F0F0]">
        <h5 class="text-[13px] font-bold text-[#171717]">📁 智能体分类</h5>
        <div class="flex flex-wrap gap-1.5" data-filter="category">
          {categories.map((category) => {
            const emoji = agentFilters.categoryEmojis[category] || '';
            return (
              <button
                data-category={category}
                class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
              >
                {emoji && <span class="mr-0.5">{emoji}</span>}
                <span>{category}</span>
                <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
              </button>
            );
          })}
        </div>
      </div>

      <div class="flex flex-col gap-3 pb-4 border-b border-[#F0F0F0]">
        <h5 class="text-[13px] font-bold text-[#171717]">📊 智能体等级</h5>
        <div class="flex flex-wrap gap-1.5" data-filter="agentLevel">
          {agentLevels.map((level) => {
            const emoji = agentFilters.agentLevelEmojis[level] || '';
            return (
              <button
                data-agentLevel={level.toLowerCase()}
                class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
              >
                {emoji && <span class="mr-0.5">{emoji}</span>}
                <span>{level.replace('_', '·')}</span>
                <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
              </button>
            );
          })}
        </div>
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">智能体 Agent</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input type="text" id="agent-search" placeholder="按名称过滤智能体..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200" />
      </div>

      <div class="flex-1"></div>
    </div>

    <div id="agent-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-4 gap-y-3">
      {agents.map(a => {
        const category = a.metrics.category || '';
        const agentLevel = a.metrics.agentLevel || '';

        return (
          <div
            class="agent-item"
            data-agent-name={a.aiProductName.toLowerCase()}
            data-company={a.metrics.company?.toLowerCase() || ''}
            data-category={category.toLowerCase()}
            data-agentLevel={agentLevel.toLowerCase()}
            data-introduction={a.introduction.toLowerCase()}
          >
            <AgentCard {...a} />
          </div>
        );
      })}
    </div>

    <Pagination itemTypeLabel="智能体" />
  </div>
</Layout>

<style>
  .agent-item.v-hidden {
    display: none !important;
  }
</style>

<script>
  import { initMultiFilter } from '../lib/multiFilter';
  import { initCardClick } from '../scripts/cardClick';
  import { initPagination } from '../lib/pagination';

  initMultiFilter();
  initCardClick();
  initPagination({
    listId: 'agent-list',
    itemClass: 'agent-item',
    searchId: 'agent-search',
    pageSize: 30,
    itemTypeLabel: '智能体',
    searchAttrs: ['data-agent-name', 'data-company', 'data-introduction'],
  });
</script>