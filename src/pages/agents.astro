---
import Layout from '../layouts/Layout.astro';
import AgentCard from '../components/AgentCard.astro';
import Pagination from '../components/Pagination.astro';
import { getAgentsPaginated, getAgentCategories, getAgentLevels, getAgentsCount } from '../lib/db';
import { agentFilters } from '../data/filters';

// 解析 URL 参数 - 支持多选
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 20;
const categoryArray = Astro.url.searchParams.getAll('category').filter(Boolean);
const agentLevelArray = Astro.url.searchParams.getAll('agentLevel').filter(Boolean);
const search = Astro.url.searchParams.get('search') || '';

// 数据库查询
const result = await getAgentsPaginated({
  page,
  pageSize,
  category: categoryArray.length > 0 ? categoryArray : undefined,
  agentLevel: agentLevelArray.length > 0 ? agentLevelArray : undefined,
  search: search || undefined,
});

const agents = result.items;
const total = result.total;
const totalPages = result.totalPages;

// 获取分类列表
const categories = await getAgentCategories();
const agentLevels = await getAgentLevels();

// 计算总数
const totalCount = await getAgentsCount();

// 动态 SEO 标题和描述
let pageTitle = 'AI 智能体 Agent 大全 - AI Links';
let pageDescription = `探索 ${totalCount}+ AI 智能体和自动化助手，按分类和等级筛选，包含详细配置教程和使用指南`;

if (search) {
  pageTitle = `搜索"${search}"的AI智能体 - AI Links`;
  pageDescription = `找到 ${total} 个与"${search}"相关的AI智能体，包含详细介绍和使用指南`;
} else if (categoryArray.length > 0 || agentLevelArray.length > 0) {
  const filtersText = [...categoryArray, ...agentLevelArray.map(l => l.replace('_', '·'))].join('、');
  pageTitle = `${filtersText}类AI智能体 - ${total}款精选 - AI Links`;
  pageDescription = `精选 ${total} 款${filtersText}类AI智能体，包含详细介绍、功能对比和使用指南`;
}

if (page > 1) {
  pageTitle += ` - 第${page}页`;
}

// 构建筛选 URL（支持多选切换，使用数组参数格式）
const buildFilterUrl = (filterType: string, clickedValue: string) => {
  const params = new URLSearchParams();
  if (search) params.set('search', search);

  // 根据 filterType 设置对应参数
  if (filterType === 'category') {
    const isSelected = categoryArray.includes(clickedValue);
    let newCategoryArray: string[];
    if (isSelected) {
      newCategoryArray = categoryArray.filter(c => c !== clickedValue);
    } else {
      newCategoryArray = [...categoryArray, clickedValue];
    }
    newCategoryArray.forEach(c => params.append('category', c));
    agentLevelArray.forEach(l => params.append('agentLevel', l));
  } else if (filterType === 'agentLevel') {
    const isSelected = agentLevelArray.includes(clickedValue);
    let newLevelArray: string[];
    if (isSelected) {
      newLevelArray = agentLevelArray.filter(l => l !== clickedValue);
    } else {
      newLevelArray = [...agentLevelArray, clickedValue];
    }
    categoryArray.forEach(c => params.append('category', c));
    newLevelArray.forEach(l => params.append('agentLevel', l));
  }

  const queryString = params.toString();
  return queryString ? `/agents?${queryString}` : '/agents';
};

// 构建分页 URL（用于 prev/next 链接，保持数组参数格式）
const buildPageUrl = (targetPage: number) => {
  const params = new URLSearchParams();
  categoryArray.forEach(c => params.append('category', c));
  agentLevelArray.forEach(l => params.append('agentLevel', l));
  if (search) params.set('search', search);
  if (targetPage > 1) params.set('page', targetPage.toString());
  const queryString = params.toString();
  return queryString ? `/agents?${queryString}` : '/agents';
};

// 构建规范化的 canonical URL（SEO 重要，保持数组参数格式）
const buildCanonicalUrl = () => {
  const params = new URLSearchParams();
  categoryArray.forEach(c => params.append('category', c));
  agentLevelArray.forEach(l => params.append('agentLevel', l));
  if (search) params.set('search', search);
  if (page > 1) params.set('page', page.toString());
  const queryString = params.toString();
  return queryString ? `/agents?${queryString}` : '/agents';
};

// 用于 Pagination 组件的查询参数
const queryParams: Record<string, string | string[]> = {};
if (categoryArray.length > 0) queryParams.category = categoryArray;
if (agentLevelArray.length > 0) queryParams.agentLevel = agentLevelArray;
if (search) queryParams.search = search;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={["AI 智能体", "Agent", "自动化", "AI 助手", "工作流自动化", ...categoryArray, ...agentLevelArray.map(l => l.replace('_', '·'))].filter(Boolean) as string[]}
>
  <!-- SEO 链接标记 -->
  <slot slot="head">
    {page > 1 && <link rel="prev" href={buildPageUrl(page - 1)} />}
    {page < totalPages && <link rel="next" href={buildPageUrl(page + 1)} />}
    <link rel="canonical" href={buildCanonicalUrl()} />
  </slot>

  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <div class="flex flex-col gap-5 mb-7">
      <div class="flex flex-col gap-3 pb-4 border-b border-[#F0F0F0]">
        <h5 class="text-[13px] font-bold text-[#171717]">📁 智能体分类</h5>
        <div class="flex flex-wrap gap-1.5">
          {categories.map((cat) => {
            const emoji = agentFilters.categoryEmojis[cat] || '';
            const isActive = categoryArray.includes(cat);
            return (
              <a
                href={buildFilterUrl('category', cat)}
                class={`border px-2.5 py-1.5 rounded-lg text-[12.5px] font-medium transition-all duration-200 flex items-center gap-1 ${
                  isActive
                    ? 'bg-[#171717] text-white border-[#171717]'
                    : 'bg-white border-[#E5E5E5] text-[#525252] hover:border-[#171717] hover:text-[#171717] hover:shadow-sm'
                }`}
              >
                {emoji && <span>{emoji}</span>}
                <span>{cat}</span>
                {isActive && <span class="ml-0.5 text-[10px]">✓</span>}
              </a>
            );
          })}
        </div>
      </div>

      <div class="flex flex-col gap-3 pb-4 border-b border-[#F0F0F0]">
        <h5 class="text-[13px] font-bold text-[#171717]">📊 智能体等级</h5>
        <div class="flex flex-wrap gap-1.5">
          {agentLevels.map((level) => {
            const emoji = agentFilters.agentLevelEmojis[level] || '';
            const isActive = agentLevelArray.includes(level);
            return (
              <a
                href={buildFilterUrl('agentLevel', level)}
                class={`border px-2.5 py-1.5 rounded-lg text-[12.5px] font-medium transition-all duration-200 flex items-center gap-1 ${
                  isActive
                    ? 'bg-[#171717] text-white border-[#171717]'
                    : 'bg-white border-[#E5E5E5] text-[#525252] hover:border-[#171717] hover:text-[#171717] hover:shadow-sm'
                }`}
              >
                {emoji && <span>{emoji}</span>}
                <span>{level.replace('_', '·')}</span>
                {isActive && <span class="ml-0.5 text-[10px]">✓</span>}
              </a>
            );
          })}
        </div>
      </div>
    </div>

    {(categoryArray.length > 0 || agentLevelArray.length > 0 || search) && (
      <a href="/agents" class="text-[13px] text-[#A3A3A3] hover:text-[#171717] flex items-center gap-1">
        <span>✕</span>
        <span>清除所有筛选</span>
        {(categoryArray.length + agentLevelArray.length) > 0 && (
          <span class="text-[11px] bg-[#E5E5E5] px-1.5 py-0.5 rounded">{categoryArray.length + agentLevelArray.length} 项</span>
        )}
      </a>
    )}
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">智能体 Agent</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#A3A3A3]">🔍</span>
        <form action="/agents" method="get">
          {categoryArray.map(cat => <input type="hidden" name="category" value={cat} />)}
          {agentLevelArray.map(level => <input type="hidden" name="agentLevel" value={level} />)}
          <input
            type="text"
            name="search"
            value={search}
            placeholder="按名称过滤智能体..."
            class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] outline-none"
          />
        </form>
      </div>

      <div class="flex-1"></div>

      {(categoryArray.length > 0 || agentLevelArray.length > 0 || search) && (
        <div class="flex items-center gap-2 text-[13px] text-[#525252]">
          <span>筛选:</span>
          {categoryArray.map(cat => (
            <span class="bg-[#171717] text-white px-2 py-0.5 rounded text-[12px]">{cat}</span>
          ))}
          {agentLevelArray.map(level => (
            <span class="bg-[#171717] text-white px-2 py-0.5 rounded text-[12px]">{level.replace('_', '·')}</span>
          ))}
          {search && <span class="bg-[#F5F5F5] px-2 py-0.5 rounded">搜索: {search}</span>}
        </div>
      )}
    </div>

    <div id="agent-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-4 gap-y-3">
      {agents.map((a) => (
        <div
          class="agent-item"
          data-agent-name={a.aiProductName.toLowerCase()}
          data-company={a.metrics.company?.toLowerCase() || ''}
          data-category={a.metrics.category.toLowerCase()}
          data-agentLevel={a.metrics.agentLevel.toLowerCase()}
          data-introduction={a.introduction.toLowerCase()}
        >
          <AgentCard
            uid={a.uid}
            slug={a.slug}
            logo={a.logo}
            aiProductName={a.aiProductName}
            introduction={a.introduction}
            websiteUrl={a.websiteUrl}
            metrics={a.metrics}
          />
        </div>
      ))}
    </div>

    {agents.length === 0 && (
      <div class="text-center py-12 text-[#525252]">
        <p class="text-lg">未找到匹配的智能体</p>
        <p class="text-[13px] mt-2">
          <a href="/agents" class="text-[#171717] hover:underline">查看全部智能体</a>
        </p>
      </div>
    )}

    <Pagination
      currentPage={page}
      totalPages={totalPages}
      totalItems={total}
      pageSize={pageSize}
      itemTypeLabel="智能体"
      baseUrl="/agents"
      queryParams={queryParams}
    />
  </div>
</Layout>

<script>
  import { initCardClick } from '../scripts/cardClick';
  import { initPartialRefresh } from '../lib/partialRefresh';

  initCardClick();
  initPartialRefresh({
    listId: 'agent-list',
    paginationId: 'pagination',
    transitionDuration: 200
  });
</script>