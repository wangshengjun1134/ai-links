---
import Layout from '../layouts/Layout.astro';
import AgentCard from '../components/AgentCard.astro';
import agents from '../data/agents.json';

const agentCount = agents.length;
---

<Layout title="智能体 Agent - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 p-6 border-r border-gray-100 h-fit sticky top-24">
    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">Agent 分类</h3>
    <div class="space-y-2">
      <a href="?type=code" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">💻 编程助手</a>
      <a href="?type=design" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">🎨 设计创作</a>
      <a href="?type=data" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">📊 数据分析</a>
      <a href="?type=office" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">📝 办公效率</a>
    </div>

    <h3 class="text-xs font-bold text-gray-500 mt-6 mb-4 uppercase tracking-wider">难度等级</h3>
    <div class="space-y-2">
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" class="rounded" /> 入门级
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" class="rounded" /> 进阶级
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" class="rounded" /> 专家级
      </label>
    </div>
  </aside>

  <div class="flex-1 p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">智能体 Agent</h2>
      <span class="text-[12px] font-mono text-gray-500 bg-gray-100/50 px-2 py-0.5 rounded-full">{agentCount}</span>
      <div class="flex-1"></div>
      <button class="px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-bold hover:bg-blue-700">提交 Agent</button>
    </div>

    {agentCount > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {agents.map(a => <AgentCard {...a} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">🤖</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无智能体</h3>
        <p class="text-gray-500">成为第一个提交智能体的人！</p>
      </div>
    )}
  </div>
</Layout>
