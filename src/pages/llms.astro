---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import llms from '../data/llms.json';
import { sidebarFilters } from '../data/navigation';

const { sizes, capabilities } = sidebarFilters.llms;
---

<Layout title="大模型 LLMs - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200">
    <!-- 模型规模 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">模型规模</h4>
      <div class="flex flex-wrap gap-1" data-filter="size" id="size-filters">
        {sizes.map((item) => {
          const size = item.path.replace('?size=', '');
          return (
            <button
              data-size={size}
              class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1"
            >
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 能力领域 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">能力领域</h4>
      <div class="flex flex-wrap gap-1" data-filter="cap" id="cap-filters">
        {capabilities.map((item) => {
          const cap = item.path.replace('?cap=', '');
          return (
            <button
              data-cap={cap}
              class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1"
            >
              {item.icon && <span class="mr-0.5">{item.icon}</span>}
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 开源状态 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">开源状态</h4>
      <div class="flex flex-wrap gap-1" data-filter="opensource" id="opensource-filters">
        <button data-opensource="open" class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1">
          <span>🔓</span>
          <span>开源模型</span>
          <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
        </button>
        <button data-opensource="closed" class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1">
          <span>🔒</span>
          <span>闭源商用</span>
          <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
        </button>
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">大模型 LLMs</h2>
      <div class="flex-1"></div>
    </div>

    {llms.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-3 gap-y-2">
        {llms.map(l => <ProductCard {...l} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">🧠</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无大模型</h3>
        <p class="text-gray-500">添加第一个大模型！</p>
      </div>
    )}
  </div>
</Layout>

<script>
  import { initMultiFilter } from '../lib/multiFilter';
  initMultiFilter();
</script>
