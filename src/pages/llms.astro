---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import llms from '../data/llms.json';
import { sidebarFilters } from '../data/navigation';

const { sizes, capabilities } = sidebarFilters.llms;
---

<Layout title="大模型 LLMs - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200">
    <h3 class="text-[14px] font-bold text-gray-400 mb-4 uppercase tracking-widest">模型规模</h3>
    <div class="space-y-2 mb-6">
      {sizes.map((item) => (
        <a href={item.path} class="block px-3 py-2 text-[13px] text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
          {item.name}
        </a>
      ))}
    </div>

    <h3 class="text-[14px] font-bold text-gray-400 mb-4 uppercase tracking-widest">能力领域</h3>
    <div class="flex flex-wrap gap-1">
      {capabilities.map((item) => (
        <a href={item.path} class="bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 hover:border-blue-400">
          {item.name}
        </a>
      ))}
    </div>

    <h3 class="text-[14px] font-bold text-gray-400 mb-4 uppercase tracking-widest">开源状态</h3>
    <div class="space-y-2">
      <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
        <input type="checkbox" class="rounded border-gray-300" /> 开源模型
      </label>
      <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
        <input type="checkbox" class="rounded border-gray-300" /> 闭源商用
      </label>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">大模型 LLMs</h2>
      <div class="flex-1"></div>
    </div>

    {llms.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-3 gap-y-2">
        {llms.map(l => <ProductCard {...l} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">🧠</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无大模型</h3>
        <p class="text-gray-500">添加第一个大模型！</p>
      </div>
    )}
  </div>
</Layout>
