---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import llms from '../data/llms.json';
import { sidebarFilters } from '../data/navigation';

const { sizes, capabilities } = sidebarFilters.llms;
---

<Layout title="大模型 LLMs - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl">
    <!-- 模型规模 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">模型规模</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="size" id="size-filters">
        {sizes.map((item) => {
          const size = item.path.replace('?size=', '');
          return (
            <button
              data-size={size}
              class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
            >
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 能力领域 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">能力领域</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="cap" id="cap-filters">
        {capabilities.map((item) => {
          const cap = item.path.replace('?cap=', '');
          return (
            <button
              data-cap={cap}
              class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
            >
              {item.icon && <span class="mr-0.5">{item.icon}</span>}
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 开源状态 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">开源状态</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="opensource" id="opensource-filters">
        <button data-opensource="open" class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95">
          <span>🔓</span>
          <span>开源模型</span>
          <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
        </button>
        <button data-opensource="closed" class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95">
          <span>🔒</span>
          <span>闭源商用</span>
          <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
        </button>
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">大模型 LLMs</h2>
      <div class="flex-1"></div>
    </div>

    {llms.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-4 gap-y-3">
        {llms.map(l => <ProductCard {...l} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-[#E5E5E5]">
        <div class="text-6xl mb-4">🧠</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无大模型</h3>
        <p class="text-[#525252]">添加第一个大模型！</p>
      </div>
    )}
  </div>
</Layout>

<script>
  import { initMultiFilter } from '../lib/multiFilter';
  initMultiFilter();
</script>
