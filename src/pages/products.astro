---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';

// 从数据中提取唯一的筛选选项
const productTypes = [...new Set(products.flatMap(p => p.metrics.productType || []))];
const companies = [...new Set(products.map(p => p.metrics.company).filter(Boolean))];
const countries = [...new Set(products.map(p => p.metrics.country).filter(Boolean))];
const pricingModels = [...new Set(products.flatMap(p => p.metrics.pricingModel || []))];
const languages = [...new Set(products.flatMap(p => p.metrics.languages || []))];
const useTypes = [...new Set(products.flatMap(p => p.metrics.useType || []))];
---

<Layout title="AI 产品 - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <!-- 任务分类 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">任务分类</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="task" id="task-filters">
        {productTypes.map((type) => (
          <button
            data-task={type}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{type}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 所属公司 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">所属公司</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="company" id="company-filters">
        {companies.map((company) => (
          <button
            data-company={company}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{company}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 所属国家 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">所属国家</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="country" id="country-filters">
        {countries.map((country) => (
          <button
            data-country={country}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{country}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 收费模式 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">收费模式</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="pricing" id="pricing-filters">
        {pricingModels.map((model) => (
          <button
            data-pricing={model}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{model}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 使用平台 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">使用平台</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="useType" id="useType-filters">
        {useTypes.map((type) => (
          <button
            data-useType={type}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{type.toUpperCase()}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 支持语言 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">支持语言</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="language" id="language-filters">
        {languages.map((lang) => (
          <button
            data-language={lang}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{lang}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 搜索 -->
    <div class="pt-6 border-t border-[#E5E5E5]">
      <div class="relative">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input type="text" placeholder="搜索产品..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-10 pr-4 text-[12.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200" />
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">AI 产品</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input type="text" placeholder="按名称过滤产品..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200" />
      </div>

      <div class="flex-1"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-4 gap-y-3">
      {products.map(p => <ProductCard {...p} />)}
    </div>
  </div>
</Layout>

<script>
  import { initMultiFilter } from '../lib/multiFilter';
  initMultiFilter();
</script>
