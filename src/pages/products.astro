---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { sidebarFilters } from '../data/navigation';

const { categories, companies, pricing } = sidebarFilters.products;
---

<Layout title="AI 产品 - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200">
    <!-- 任务分类 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">任务分类</h4>
      <div class="flex flex-wrap gap-1">
        {categories.map((item) => (
          <a href={item.path} class="bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] hover:border-blue-400">
            {item.icon && <span class="mr-1">{item.icon}</span>}
            {item.name}
          </a>
        ))}
      </div>
    </div>

    <!-- 所属公司 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">所属公司</h4>
      <div class="flex flex-wrap gap-1">
        {companies.map((item) => (
          <a href={item.path} class="bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] hover:border-blue-400">
            {item.icon && <span class="mr-1">{item.icon}</span>}
            {item.name}
          </a>
        ))}
      </div>
    </div>

    <!-- 收费模式 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">收费模式</h4>
      <div class="space-y-2">
        {pricing.map((item) => (
          <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer">
            <input type="checkbox" class="rounded border-gray-300" />
            {item.icon && <span class="mr-1">{item.icon}</span>}
            {item.name}
          </label>
        ))}
      </div>
    </div>

    <!-- 搜索 -->
    <div class="pt-6 border-t border-gray-100">
      <div class="relative">
        <span class="absolute left-3 top-2.5 text-[14px] text-gray-400">🔍</span>
        <input type="text" placeholder="搜索产品..." class="w-full bg-white border border-gray-200 rounded-full py-2 pl-9 pr-4 text-[12px] focus:border-blue-400 focus:ring-4 focus:ring-blue-50 outline-none" />
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">AI 产品</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-gray-400">🔍</span>
        <input type="text" placeholder="按名称过滤产品..." class="w-full bg-white border border-gray-200 rounded-full py-2 pl-10 pr-4 text-[13px] focus:border-blue-400 focus:ring-4 focus:ring-blue-50/50 outline-none" />
      </div>

      <div class="flex-1"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-x-3 gap-y-2">
      {products.map(p => <ProductCard {...p} />)}
    </div>
  </div>
</Layout>
