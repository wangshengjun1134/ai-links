---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';

// 从数据中提取所有 level1 -> level2 -> tags 的层级结构
interface ProductTypeHierarchy {
  [level1: string]: {
    [level2: string]: Set<string>;
  };
}

const typeHierarchy: ProductTypeHierarchy = {};

products.forEach(p => {
  const pt = p.metrics?.productType;
  if (pt && typeof pt === 'object' && !Array.isArray(pt)) {
    const level1 = pt.level1;
    const level2 = pt.level2;
    const tags = pt.tags || [];
    
    // 只处理有 level1 和 level2 的数据
    if (level1 && level2) {
      if (!typeHierarchy[level1]) {
        typeHierarchy[level1] = {};
      }
      if (!typeHierarchy[level1][level2]) {
        typeHierarchy[level1][level2] = new Set<string>();
      }
      
      // 只添加有效的 tags
      tags.forEach(tag => {
        if (tag && tag.trim()) {
          typeHierarchy[level1][level2].add(tag);
        }
      });
    }
  }
});

// 转换为数组结构用于渲染
const hierarchyData = Object.entries(typeHierarchy).map(([level1, level2Data]) => ({
  level1,
  level2s: Object.entries(level2Data).map(([level2, tags]) => ({
    level2,
    tags: Array.from(tags).sort()
  }))
}));
---

<Layout title="AI 产品 - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <!-- 任务分类（三级结构显示） -->
    <div class="flex flex-col gap-5 mb-7">
      {hierarchyData.map((group) => (
        <div class="flex flex-col gap-3 pb-4 border-b border-[#F0F0F0] last:border-0">
          <!-- 一级分类 -->
          <h5 class="text-[13px] font-bold text-[#171717]">{group.level1}</h5>
          
          <!-- 二级分类 -->
          {group.level2s.map((level2Item) => (
            <div class="flex flex-col gap-2">
              <div class="text-[11px] text-[#525252] font-medium">{level2Item.level2}</div>
              <!-- 三级标签（可点击） -->
              <div class="flex flex-wrap gap-1.5" data-filter="task">
                {level2Item.tags.map((tag) => (
                  <button
                    data-task={tag}
                    class="filter-btn bg-white border border-[#E5E5E5] px-2 py-1 rounded-md text-[11px] text-[#525252] font-medium transition-all duration-200 cursor-pointer hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
                  >
                    <span>{tag}</span>
                    <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <!-- 搜索 -->
    <div class="pt-6 border-t border-[#E5E5E5]">
      <div class="relative">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input type="text" placeholder="搜索产品..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-10 pr-4 text-[12.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200" />
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">AI 产品</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input type="text" id="product-search" placeholder="按名称过滤产品..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200" />
      </div>

      <div class="flex-1"></div>
    </div>

    <!-- 平铺显示所有产品（分页） -->
    <div id="product-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-4 gap-y-3">
      {products.map(p => {
        // 提取三级 tags 用于过滤
        const getProductTags = (): string[] => {
          const pt = p.metrics.productType;
          if (!pt) return [];
          // 如果是对象结构，只提取 tags
          if (typeof pt === 'object' && !Array.isArray(pt)) {
            return pt.tags || [];
          }
          // 如果是数组（兼容旧数据）
          return pt;
        };
        const productTags = getProductTags();

        return (
          <div
            class="product-item"
            data-product-name={p.aiProductName.toLowerCase()}
            data-company={p.metrics.company?.toLowerCase() || ''}
            data-task={JSON.stringify(productTags)}
            data-introduction={p.introduction.toLowerCase()}
          >
            <ProductCard {...p} />
          </div>
        );
      })}
    </div>

    <!-- 分页组件 -->
    <div id="pagination" class="mt-12 flex items-center justify-center gap-4">
      <button id="prev-btn" class="p-2.5 rounded-xl border border-[#E5E5E5] bg-white hover:border-[#171717] hover:text-[#171717] hover:shadow-sm disabled:opacity-30 disabled:cursor-not-allowed transition-all duration-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <div id="page-info" class="text-[13px] font-medium text-[#525252]"></div>
      <button id="next-btn" class="p-2.5 rounded-xl border border-[#E5E5E5] bg-white hover:border-[#171717] hover:text-[#171717] hover:shadow-sm disabled:opacity-30 disabled:cursor-not-allowed transition-all duration-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</Layout>

<style>
  .product-item.v-hidden {
    display: none !important;
  }
</style>

<script>
  import { initMultiFilter } from '../lib/multiFilter';
  import { initCardClick } from '../scripts/cardClick';

  initMultiFilter();
  initCardClick();

  const CONFIG = {
    pageSize: 30,
  };

  let state = {
    currentPage: 1,
    allCards: [],
    filteredCards: [],
  };

  function init() {
    // 获取所有卡片
    state.allCards = Array.from(document.querySelectorAll('#product-list .product-item'));
    state.filteredCards = [...state.allCards];
    
    const searchInput = document.getElementById('product-search');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    // 搜索事件
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase().trim();
        
        state.filteredCards = state.allCards.filter(card => {
          const title = card.getAttribute('data-product-name') || '';
          const company = card.getAttribute('data-company') || '';
          const introduction = card.getAttribute('data-introduction') || '';
          return title.includes(val) || company.includes(val) || introduction.includes(val);
        });

        state.currentPage = 1;
        render();
      });
    }

    // 监听侧边栏过滤事件
    document.addEventListener('filtersChanged', () => {
      // 根据当前可见的卡片更新 filteredCards
      state.filteredCards = state.allCards.filter(card => {
        return card.style.display !== 'none';
      });
      
      // 重置到第一页
      state.currentPage = 1;
      render();
    });

    // 翻页事件
    prevBtn.onclick = () => { 
      if (state.currentPage > 1) { 
        state.currentPage--; 
        render(); 
        window.scrollTo({ top: 0, behavior: 'smooth' }); 
      } 
    };
    
    nextBtn.onclick = () => { 
      const totalPages = Math.ceil(state.filteredCards.length / CONFIG.pageSize);
      if (state.currentPage < totalPages) { 
        state.currentPage++; 
        render(); 
        window.scrollTo({ top: 0, behavior: 'smooth' }); 
      } 
    };

    render();
  }

  function render() {
    const totalPages = Math.ceil(state.filteredCards.length / CONFIG.pageSize);
    const start = (state.currentPage - 1) * CONFIG.pageSize;
    const end = start + CONFIG.pageSize;

    // 1. 处理显隐
    state.allCards.forEach(card => card.classList.add('v-hidden'));
    state.filteredCards.slice(start, end).forEach(card => card.classList.remove('v-hidden'));

    // 2. 更新按钮状态
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    prevBtn.disabled = state.currentPage === 1;
    nextBtn.disabled = state.currentPage === totalPages || totalPages === 0;

    // 3. 更新页码显示
    const pageInfo = document.getElementById('page-info');
    if (pageInfo) {
      pageInfo.textContent = totalPages > 0 
        ? `第 ${state.currentPage} / ${totalPages} 页（共 ${state.filteredCards.length} 个产品）` 
        : '无结果';
    }
  }

  // 启动
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
