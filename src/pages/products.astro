---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { sidebarFilters } from '../data/navigation';

const { categories, companies, pricing } = sidebarFilters.products;
---

<Layout title="AI 产品 - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200">
    <!-- 任务分类 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">任务分类</h4>
      <div class="flex flex-wrap gap-1" id="task-filters">
        {categories.map((item) => {
          const task = item.path.replace('?task=', '');
          return (
            <button
              data-task={task}
              class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1"
            >
              {item.icon && <span class="mr-0.5">{item.icon}</span>}
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 所属公司 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">所属公司</h4>
      <div class="flex flex-wrap gap-1" id="company-filters">
        {companies.map((item) => {
          const company = item.path.replace('?company=', '');
          return (
            <button
              data-company={company}
              class="filter-btn bg-white border border-gray-100 px-2 py-0.5 rounded-md text-[13px] text-gray-600 transition-all cursor-pointer flex items-center gap-1"
            >
              {item.icon && <span class="mr-0.5">{item.icon}</span>}
              <span>{item.name}</span>
              <span class="close-icon hidden ml-1 text-gray-400 hover:text-gray-600">×</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- 收费模式 -->
    <div class="flex flex-col gap-2 mb-6">
      <h4 class="text-[14px] font-bold text-gray-400 uppercase tracking-widest">收费模式</h4>
      <div class="space-y-2">
        {pricing.map((item) => (
          <label class="flex items-center gap-2 text-[13px] text-gray-600 cursor-pointer">
            <input type="checkbox" class="rounded border-gray-300" />
            {item.icon && <span class="mr-1">{item.icon}</span>}
            {item.name}
          </label>
        ))}
      </div>
    </div>

    <!-- 搜索 -->
    <div class="pt-6 border-t border-gray-100">
      <div class="relative">
        <span class="absolute left-3 top-2.5 text-[14px] text-gray-400">🔍</span>
        <input type="text" placeholder="搜索产品..." class="w-full bg-white border border-gray-200 rounded-full py-2 pl-9 pr-4 text-[12px] focus:border-blue-400 focus:ring-4 focus:ring-blue-50 outline-none" />
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">AI 产品</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-gray-400">🔍</span>
        <input type="text" placeholder="按名称过滤产品..." class="w-full bg-white border border-gray-200 rounded-full py-2 pl-10 pr-4 text-[13px] focus:border-blue-400 focus:ring-4 focus:ring-blue-50/50 outline-none" />
      </div>

      <div class="flex-1"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-x-3 gap-y-2">
      {products.map(p => <ProductCard {...p} />)}
    </div>
  </div>
</Layout>

<script>
  // 从 URL 获取当前选中的筛选条件
  function getSelectedFilters(paramName) {
    const params = new URLSearchParams(window.location.search);
    return params.getAll(paramName);
  }

  // 更新 URL 参数（支持多选）
  function updateFilters(paramName, values) {
    const params = new URLSearchParams(window.location.search);
    params.delete(paramName);
    values.forEach(v => params.append(paramName, v));
    
    const newUrl = params.toString() 
      ? `${window.location.pathname}?${params.toString()}` 
      : window.location.pathname;
    
    window.history.pushState({}, '', newUrl);
    
    // 触发页面刷新以应用筛选
    window.dispatchEvent(new CustomEvent('filters-change', { detail: params }));
  }

  // 切换筛选状态
  function toggleFilter(paramName, value, btn) {
    const selected = getSelectedFilters(paramName);
    const index = selected.indexOf(value);
    const closeIcon = btn.querySelector('.close-icon');
    
    if (index > -1) {
      selected.splice(index, 1);
      btn.classList.remove('active');
      btn.classList.add('border-gray-100');
      btn.classList.remove('border-blue-400', 'bg-blue-50', 'text-blue-600');
      if (closeIcon) closeIcon.classList.add('hidden');
    } else {
      selected.push(value);
      btn.classList.add('active');
      btn.classList.remove('border-gray-100');
      btn.classList.add('border-blue-400', 'bg-blue-50', 'text-blue-600');
      if (closeIcon) closeIcon.classList.remove('hidden');
    }
    
    updateFilters(paramName, selected);
  }

  // 初始化选中状态
  document.addEventListener('DOMContentLoaded', () => {
    // 初始化任务分类
    const selectedTasks = getSelectedFilters('task');
    document.querySelectorAll('#task-filters .filter-btn').forEach(btn => {
      const task = btn.getAttribute('data-task');
      const closeIcon = btn.querySelector('.close-icon');
      
      if (selectedTasks.includes(task)) {
        btn.classList.add('active');
        btn.classList.remove('border-gray-100');
        btn.classList.add('border-blue-400', 'bg-blue-50', 'text-blue-600');
        if (closeIcon) closeIcon.classList.remove('hidden');
      }
      
      btn.addEventListener('click', (e) => {
        // 如果点击的是关闭图标，阻止事件冒泡
        if (e.target.classList.contains('close-icon')) {
          e.stopPropagation();
        }
        toggleFilter('task', task, btn);
      });
      
      // 关闭图标点击事件
      if (closeIcon) {
        closeIcon.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleFilter('task', task, btn);
        });
      }
    });

    // 初始化公司筛选
    const selectedCompanies = getSelectedFilters('company');
    document.querySelectorAll('#company-filters .filter-btn').forEach(btn => {
      const company = btn.getAttribute('data-company');
      const closeIcon = btn.querySelector('.close-icon');
      
      if (selectedCompanies.includes(company)) {
        btn.classList.add('active');
        btn.classList.remove('border-gray-100');
        btn.classList.add('border-blue-400', 'bg-blue-50', 'text-blue-600');
        if (closeIcon) closeIcon.classList.remove('hidden');
      }
      
      btn.addEventListener('click', (e) => {
        if (e.target.classList.contains('close-icon')) {
          e.stopPropagation();
        }
        toggleFilter('company', company, btn);
      });
      
      if (closeIcon) {
        closeIcon.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleFilter('company', company, btn);
        });
      }
    });
  });
</script>
