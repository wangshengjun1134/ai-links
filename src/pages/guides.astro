---
import Layout from '../layouts/Layout.astro';
import GuideCard from '../components/GuideCard.astro';
import GuideRankCard from '../components/GuideRankCard.astro';
import guides from '../data/guides.json';

const guideCount = guides.length;

// 模拟排行榜数据
const rankData = [
  { rank: 1, title: "什么是大语言模型？全面解析 LLM 的工作原理", author: "AI Science", views: "12.5k" },
  { rank: 2, title: "Prompt Engineering 入门：如何与 AI 高效对话", author: "Prompt Master", views: "9.8k" },
  { rank: 3, title: "AI 绘画工具对比：Midjourney vs Stable Diffusion", author: "Art Tech", views: "8.2k" },
  { rank: 4, title: "如何本地部署开源大模型？完整教程", author: "DevOps Pro", views: "6.5k" },
  { rank: 5, title: "Transformer 架构详解：从原理到实现", author: "Deep Learning", views: "5.3k" },
];
---

<Layout title="🌱 SciencePopu - AI Links">
  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-bold text-gray-900">🌱 SciencePopu</h2>
        <span class="text-[12px] font-mono text-gray-500 bg-gray-100/50 px-2 py-0.5 rounded-full">{guideCount}</span>
      </div>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-gray-400">🔍</span>
        <input type="text" placeholder="按名称过滤教程..." class="w-full bg-white border border-gray-200 rounded-full py-2 pl-10 pr-4 text-[13px] focus:border-blue-400 focus:ring-4 focus:ring-blue-50/50 outline-none" />
      </div>

      <div class="flex-1"></div>
    </div>

    {guideCount > 0 ? (
      <div class="flex gap-6">
        <!-- 左侧：卡片列表 -->
        <div class="flex-1 flex flex-col gap-4">
          {guides.map(g => <GuideCard {...g} />)}
        </div>
        
        <!-- 右侧：排行榜 -->
        <div class="w-80 shrink-0">
          <div class="sticky top-20">
            <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">
              <span class="text-lg">🔥</span> 阅读排行榜
            </h3>
            <div class="flex flex-col gap-2">
              {rankData.map(r => <GuideRankCard {...r} />)}
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">📚</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无教程</h3>
        <p class="text-gray-500">分享你的第一个 AI 教程！</p>
      </div>
    )}
  </div>
</Layout>
