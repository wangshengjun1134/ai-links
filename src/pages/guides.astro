---
import Layout from '../layouts/Layout.astro';
import GuideCard from '../components/GuideCard.astro';
import guides from '../data/guides.json';

const guideCount = guides.length;
---

<Layout title="科普 & 教程 - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 p-6 border-r border-gray-100 h-fit sticky top-24">
    <h3 class="text-xs font-bold text-gray-500 mb-4 uppercase tracking-wider">教程类型</h3>
    <div class="space-y-2">
      <a href="?type=beginner" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">🌱 入门教程</a>
      <a href="?type=advanced" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">🚀 进阶指南</a>
      <a href="?type=comparison" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">⚖️ 产品对比</a>
      <a href="?type=review" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">📝 评测报告</a>
    </div>

    <h3 class="text-xs font-bold text-gray-500 mt-6 mb-4 uppercase tracking-wider">内容标签</h3>
    <div class="flex flex-wrap gap-1">
      <a href="?tag=llm" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">大模型</a>
      <a href="?tag=prompt" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">Prompt</a>
      <a href="?tag=api" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">API</a>
      <a href="?tag=deploy" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">部署</a>
      <a href="?tag=fine-tune" class="px-2 py-1 bg-gray-100 text-xs rounded hover:bg-blue-50">微调</a>
    </div>

    <h3 class="text-xs font-bold text-gray-500 mt-6 mb-4 uppercase tracking-wider">阅读时长</h3>
    <div class="space-y-2">
      <a href="?time=short" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">⏱️ 5 分钟内</a>
      <a href="?time=medium" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">⏱️ 5-15 分钟</a>
      <a href="?time=long" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg">⏱️ 15 分钟+</a>
    </div>
  </aside>

  <div class="flex-1 p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-xl font-bold text-gray-900">科普 & 教程</h2>
      <span class="text-[12px] font-mono text-gray-500 bg-gray-100/50 px-2 py-0.5 rounded-full">{guideCount}</span>
      <div class="flex-1"></div>
      <button class="px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-bold hover:bg-blue-700">撰写教程</button>
    </div>

    {guideCount > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {guides.map(g => <GuideCard {...g} />)}
      </div>
    ) : (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="text-6xl mb-4">📚</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">暂无教程</h3>
        <p class="text-gray-500">分享你的第一个 AI 教程！</p>
      </div>
    )}
  </div>
</Layout>
