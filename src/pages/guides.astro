---
import Layout from '../layouts/Layout.astro';
import GuideCard from '../components/GuideCard.astro';
import GuideRankCard from '../components/GuideRankCard.astro';
import guides from '../data/guides.json';
import { sidebarFilters } from '../data/navigation';

const { types } = sidebarFilters.guides;

// 排行榜数据
const rankData = [
  { rank: 1, title: "什么是大语言模型？全面解析 LLM 的工作原理", author: "AI Science", views: "12.5k" },
  { rank: 2, title: "Prompt Engineering 入门：如何与 AI 高效对话", author: "Prompt Master", views: "9.8k" },
  { rank: 3, title: "AI 绘画工具对比：Midjourney vs Stable Diffusion", author: "Art Tech", views: "8.2k" },
  { rank: 4, title: "如何本地部署开源大模型？完整教程", author: "DevOps Pro", views: "6.5k" },
  { rank: 5, title: "Transformer 架构详解：从原理到实现", author: "Deep Learning", views: "5.3k" },
];
---

<Layout title="🌱 SciencePopu - AI Links">
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-gray-100 h-fit sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white">
    <h3 class="text-[14px] font-bold text-gray-400 mb-4 uppercase tracking-widest">教程类型</h3>
    <div class="space-y-2">
      {types.map((item) => (
        <a href={item.path} class="group flex items-center gap-3 px-3 py-2.5 text-[13px] text-gray-600 hover:bg-indigo-50 hover:text-indigo-600 rounded-xl transition-all">
          <span class="text-lg group-hover:scale-110 transition-transform">{item.icon}</span> {item.name}
        </a>
      ))}
    </div>
  </aside>

  <div class="p-8 bg-slate-50 min-h-screen">
    <div class="flex items-center gap-4 mb-8">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-xl shadow-lg shadow-indigo-500/20">🌱</div>
        <div>
          <h2 class="text-xl font-bold text-slate-800">科普&教程</h2>
        </div>
      </div>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-slate-400">🔍</span>
        <input type="text" placeholder="搜索教程..." class="w-full bg-white border border-slate-200 rounded-full py-2.5 pl-11 pr-4 text-sm text-slate-700 placeholder-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all" />
      </div>

      <div class="flex-1"></div>

      <button class="px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full hover:shadow-lg hover:shadow-indigo-500/20 transition-all">
        发布教程
      </button>
    </div>

    {guides.length > 0 ? (
      <div class="flex gap-8">
        <div class="flex-1">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {guides.map(g => (
              <div class="group relative p-5 rounded-2xl border border-slate-200 bg-white hover:border-indigo-300 hover:shadow-[0_0_30px_-10px_rgba(99,102,241,0.3)] transition-all duration-300 hover:-translate-y-1 cursor-pointer">
                <a href={`/guides/${g.uid}`} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-10"></a>

                <div class="flex items-start justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 text-[10px] font-bold text-indigo-600 bg-indigo-50 border border-indigo-100 rounded-full uppercase tracking-wider">{g.category}</span>
                    <span class="flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-medium text-slate-500 bg-slate-100 rounded-full">
                      <span class="w-1 h-1 rounded-full bg-indigo-400"></span>
                      {g.readTime}
                    </span>
                  </div>
                </div>

                <h3 class="text-base font-bold text-slate-800 mb-2 group-hover:text-indigo-600 transition-colors line-clamp-2">
                  {g.title}
                </h3>

                <p class="text-sm text-slate-600 mb-4 line-clamp-2">
                  {g.description}
                </p>

                <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 flex items-center justify-center text-white text-[10px] font-bold shadow-md shadow-indigo-500/20">
                      {g.author.charAt(0)}
                    </div>
                    <span class="text-xs text-slate-600">{g.author}</span>
                  </div>
                  <span class="text-xs text-slate-400">{g.publishedAt}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="w-80 shrink-0">
          <div class="sticky top-20 space-y-6">
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
              <h3 class="text-sm font-bold text-slate-700 mb-4 flex items-center gap-2">
                <span class="text-lg">🔥</span> 阅读排行榜
              </h3>
              <div class="flex flex-col gap-2">
                {rankData.map(r => <GuideRankCard {...r} />)}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="text-center py-20 rounded-2xl border border-slate-200 bg-white">
        <div class="text-6xl mb-4">📚</div>
        <h3 class="text-xl font-bold text-slate-700 mb-2">暂无教程</h3>
        <p class="text-slate-500">分享你的第一个 AI 教程！</p>
      </div>
    )}
  </div>
</Layout>
