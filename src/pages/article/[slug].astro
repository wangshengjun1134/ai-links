---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getArticleBySlug, getAllArticleSlugs, getArticleByUid } from '../../lib/db';

// 从数据库获取所有文章 slug，生成路径
const allSlugs = await getAllArticleSlugs();
const posts = await getCollection('article');

export async function getStaticPaths() {
  // 生成所有数据库中存在的文章路径
  return allSlugs.map(slug => {
    // 从数据库获取文章信息，拿到 uid
    // 注意：getStaticPaths 在 SSR 模式下被忽略，这个页面是动态 SSR
    return {
      params: { slug },
    };
  });
}

// SSR 模式下，从 URL 参数获取 slug
const urlSlug = Astro.params.slug;
const articleMeta = await getArticleBySlug(urlSlug);

if (!articleMeta) {
  return Astro.redirect('/article');
}

// 通过 uid 找到对应的 Markdown 文件
// content collection 的 slug 格式是小写的 "uid/uid"，如 "ar-000006/ar-000006"
// 需要将 uid 转为小写来匹配
const uid = articleMeta.uid;
const lowerUid = uid.toLowerCase();
const entry = posts.find(p => p.slug === `${lowerUid}/${lowerUid}` || p.slug.split('/').pop() === lowerUid);

if (!entry) {
  return Astro.redirect('/article');
}

const { Content, headings } = await entry.render();
---

<Layout title={articleMeta.title}>
  <div class="flex min-h-screen bg-white bg-clip-content px-[140px]">
    <article class="flex-1 min-w-0">
      <div class=" mx-auto px-8 md:px-16 py-20">

        <header class="mb-16 pb-12 border-b border-slate-100">

          <h1 class="text-[44px] font-black text-slate-900 leading-[1.1] tracking-tight mb-8">
            {articleMeta.title}
          </h1>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-white text-[12px] font-black">
              {articleMeta.author.charAt(0).toUpperCase()}
            </div>
            <div class="flex flex-col text-[13px]">
              <span class="font-bold text-slate-900">{articleMeta.author}</span>
              <span class="font-medium text-slate-400 font-mono tracking-tighter">{articleMeta.publishedAt}</span>
            </div>
            
            {articleMeta.websiteUrl && (
              <a
                href={articleMeta.websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto flex items-center gap-2 px-3 py-1.5 bg-slate-100 text-slate-500 text-[12px] rounded-full font-medium hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
              >
                <span class="text-slate-400">数据来源</span>
                <span class="underline">{new URL(articleMeta.websiteUrl).hostname}</span>
              </a>
            )}
          </div>

          <!-- 语言切换按钮 -->
          <div class="flex items-center gap-2 mt-6" id="lang-switcher">
            <button
              type="button"
              data-lang="bilingual"
              class="lang-btn px-4 py-1.5 text-[13px] font-semibold rounded-full transition-all bg-indigo-600 text-white"
            >
              双语
            </button>
            <button
              type="button"
              data-lang="en"
              class="lang-btn px-4 py-1.5 text-[13px] font-semibold rounded-full transition-all bg-slate-100 text-slate-500 hover:bg-slate-200"
            >
              English
            </button>
            <button
              type="button"
              data-lang="zh"
              class="lang-btn px-4 py-1.5 text-[13px] font-semibold rounded-full transition-all bg-slate-100 text-slate-500 hover:bg-slate-200"
            >
              中文
            </button>
          </div>
        </header>

        <div id="custom-article-content">
          <Content />
        </div>
      </div>
    </article>

    <aside class="w-[320px] shrink-0 border-l border-slate-50 hidden xl:block">
      <div class="sticky top-0 h-screen p-10 overflow-y-auto custom-scrollbar">
        <nav class="space-y-1" id="toc-nav">
          {headings.filter(h => h.depth >= 2).map((h) => {
            // 检测是否为中文标题（包含中文字符）
            const isZhTitle = /[\u4e00-\u9fa5]/.test(h.text);
            return (
              <a
                href={`#${h.slug}`}
                data-lang-type={isZhTitle ? 'zh' : 'en'}
                class={`toc-item group flex items-center py-2 px-3 transition-all rounded-lg hover:bg-slate-50 hover:text-indigo-600 ${h.depth === 2 ? 'text-[13px] font-bold text-slate-800' : 'text-[12px] text-slate-500 ml-4'}`}
              >
                <span class="truncate">{h.text}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </aside>
  </div>
</Layout>

<style is:global>
  /* 自定义滚动条样式 - 右侧导航栏 */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 3px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
  }

  /* 锚点定位偏移 - 防止被 sticky header 遮挡 */
  #custom-article-content h2,
  #custom-article-content h3,
  #custom-article-content h4 {
    scroll-margin-top: 120px;
  }

  /* 核心排版：这是让它"变好看"的关键 */
  #custom-article-content {
    font-family: 'Inter', system-ui, sans-serif;
    color: #334155; /* slate-700 */
    line-height: 1.8;
    font-size: 16px;
  }

  /* 标题：大而黑，增加间距 */
  #custom-article-content h2 {
    font-size: 28px;
    font-weight: 900;
    color: #0f172a;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }

  #custom-article-content h3 {
    font-size: 20px;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* 段落与列表：解决拥挤问题 */
  #custom-article-content p {
    margin-bottom: 1.5rem;
  }

  #custom-article-content ul {
    list-style-type: disc;
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  #custom-article-content li {
    margin-bottom: 0.5rem;
  }

  /* 重点文本 */
  #custom-article-content strong {
    color: #0f172a;
    font-weight: 800;
  }

  /* 代码块：工业深色风 */
  #custom-article-content pre {
    background-color: #0d1117;
    padding: 1.5rem;
    border-radius: 1rem;
    margin: 2.5rem 0;
    overflow-x: auto;
    border: 1px solid #1e293b;
  }

  #custom-article-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  /* 行内代码 */
  #custom-article-content :not(pre) > code {
    background-color: #f1f5f9;
    color: #4f46e5;
    padding: 0.2rem 0.4rem;
    border-radius: 0.4rem;
    font-weight: 600;
  }

  /* 引用 */
  #custom-article-content blockquote {
    border-left: 4px solid #e2e8f0;
    padding-left: 1.5rem;
    font-style: italic;
    color: #64748b;
    margin: 2rem 0;
  }

  /* 图片 */
  #custom-article-content img {
    border-radius: 1rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    margin: 3rem auto;
  }

  /* 语言块样式 - 默认双语模式显示所有 */
  .lang-block[data-lang="en"],
  .lang-block[data-lang="zh"] {
    display: block;
  }

  /* 双语模式下的分隔样式 */
  .lang-block[data-lang="zh"] {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed #e2e8f0;
  }

  /* 英文标题样式 */
  .en-title h2 {
    font-size: 28px;
    color: #0f172a;
    font-weight: 900;
    margin: 0;
    letter-spacing: -0.025em;
  }

  .en-title h3 {
    font-size: 20px;
    color: #1e293b;
    font-weight: 800;
    margin: 0;
  }

  /* 中文标题样式 - 由 JS 控制显示 */
  .zh-title h2 {
    font-size: 22px;
    color: #1e293b;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .zh-title h3 {
    font-size: 18px;
    color: #1e293b;
    font-weight: 700;
    margin: 0;
  }
</style>

<script>
  // 语言切换逻辑
  document.addEventListener('DOMContentLoaded', () => {
    const langBtns = document.querySelectorAll('.lang-btn');
    const langBlocks = document.querySelectorAll('.lang-block');
    const tocItems = document.querySelectorAll('.toc-item');

    // 获取所有标题容器
    const enTitleContainers = document.querySelectorAll('.en-title');
    const zhTitleContainers = document.querySelectorAll('.zh-title');

    // 检查是否存在语言块，如果没有则隐藏切换按钮
    if (langBlocks.length === 0) {
      const switcher = document.getElementById('lang-switcher');
      if (switcher) switcher.style.display = 'none';
      return;
    }

    // 更新按钮样式
    function updateButtonStyles(activeLang) {
      langBtns.forEach(b => {
        if (b.getAttribute('data-lang') === activeLang) {
          b.className = 'lang-btn px-4 py-1.5 text-[13px] font-semibold rounded-full transition-all bg-indigo-600 text-white';
        } else {
          b.className = 'lang-btn px-4 py-1.5 text-[13px] font-semibold rounded-full transition-all bg-slate-100 text-slate-500 hover:bg-slate-200';
        }
      });
    }

    // 更新语言块显示
    function updateLanguageDisplay(lang) {
      langBlocks.forEach(block => {
        const blockLang = block.getAttribute('data-lang');
        if (lang === 'bilingual') {
          block.style.display = 'block';
          block.classList.remove('lang-separator-hidden');
        } else if (blockLang === lang) {
          block.style.display = 'block';
          block.classList.add('lang-separator-hidden');
        } else {
          block.style.display = 'none';
        }
      });

      // 更新分隔线样式
      const zhBlocks = document.querySelectorAll('.lang-block[data-lang="zh"]');
      zhBlocks.forEach(block => {
        if (lang === 'bilingual') {
          block.style.borderTop = '1px dashed #e2e8f0';
          block.style.paddingTop = '1rem';
          block.style.marginTop = '1rem';
        } else {
          block.style.borderTop = 'none';
          block.style.paddingTop = '0';
          block.style.marginTop = '0';
        }
      });

      // 更新英文标题显示：双语和英文模式显示，中文模式隐藏
      enTitleContainers.forEach(container => {
        if (lang === 'bilingual' || lang === 'en') {
          container.style.display = 'block';
        } else {
          container.style.display = 'none';
        }
      });

      // 更新中文标题显示：双语和中文模式显示，英文模式隐藏
      zhTitleContainers.forEach(container => {
        if (lang === 'bilingual' || lang === 'zh') {
          container.style.display = 'block';
          container.style.marginTop = '0.5rem';
          container.style.marginBottom = '1.5rem';
        } else {
          container.style.display = 'none';
        }
      });

      // 更新目录显示
      tocItems.forEach(item => {
        const langType = item.getAttribute('data-lang-type');
        if (lang === 'bilingual') {
          item.style.display = 'flex';
        } else if (lang === 'zh') {
          if (langType === 'zh') {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        } else {
          if (langType === 'en') {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        }
      });
    }

    langBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        updateButtonStyles(lang);
        updateLanguageDisplay(lang);
      });
    });

    // 默认显示双语模式
    updateButtonStyles('bilingual');
    updateLanguageDisplay('bilingual');
  });
</script>