---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import guides from '../../data/guides.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // 只生成 guides.json 中存在的教程路径
  const guideUids = new Set(guides.map(g => g.uid));
  return posts
    .filter(entry => guideUids.has(entry.slug))
    .map(entry => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// 从 guides.json 获取额外元数据
const guideMeta = guides.find(g => g.uid === entry.slug) || {
  title: entry.data.title,
  author: entry.data.author || 'Unknown',
  category: entry.data.category || 'Tutorial',
  readTime: entry.data.readTime || '5 min',
  publishedAt: entry.data.publishedAt || '2026-03-01',
};
---

<Layout title={guideMeta.title}>
  <div class="flex min-h-screen bg-white bg-clip-content px-[140px]">
    <article class="flex-1 min-w-0">
      <div class=" mx-auto px-8 md:px-16 py-20">

        <header class="mb-16 pb-12 border-b border-slate-100">

          <h1 class="text-[44px] font-black text-slate-900 leading-[1.1] tracking-tight mb-8">
            {guideMeta.title}
          </h1>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-white text-[12px] font-black">
              {guideMeta.author.charAt(0).toUpperCase()}
            </div>
            <div class="flex flex-col text-[13px]">
              <span class="font-bold text-slate-900">{guideMeta.author}</span>
              <span class="font-medium text-slate-400 font-mono tracking-tighter">{guideMeta.publishedAt}</span>
            </div>
          </div>
        </header>

        <div id="custom-article-content">
          <Content />
        </div>
      </div>
    </article>

    <aside class="w-[320px] shrink-0 border-l border-slate-50 hidden xl:block">
      <div class="sticky top-0 h-screen p-10 overflow-y-auto custom-scrollbar">
        <nav class="space-y-1">
          {headings.filter(h => h.depth >= 2).map((h) => (
            <a href={`#${h.slug}`} class={`group flex items-center py-2 px-3 transition-all rounded-lg hover:bg-slate-50 hover:text-indigo-600 ${h.depth === 2 ? 'text-[13px] font-bold text-slate-800' : 'text-[12px] text-slate-500 ml-4'}`}>
              <span class="truncate">{h.text}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</Layout>

<style is:global>
  /* 自定义滚动条样式 - 右侧导航栏 */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 3px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #cbd5e1;
  }

  /* 锚点定位偏移 - 防止被 sticky header 遮挡 */
  #custom-article-content h2,
  #custom-article-content h3,
  #custom-article-content h4 {
    scroll-margin-top: 120px;
  }

  /* 核心排版：这是让它"变好看"的关键 */
  #custom-article-content {
    font-family: 'Inter', system-ui, sans-serif;
    color: #334155; /* slate-700 */
    line-height: 1.8;
    font-size: 16px;
  }

  /* 标题：大而黑，增加间距 */
  #custom-article-content h2 {
    font-size: 28px;
    font-weight: 900;
    color: #0f172a;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
  }
  
  #custom-article-content h3 {
    font-size: 20px;
    font-weight: 800;
    color: #1e293b;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* 段落与列表：解决拥挤问题 */
  #custom-article-content p {
    margin-bottom: 1.5rem;
  }
  
  #custom-article-content ul {
    list-style-type: disc;
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }
  
  #custom-article-content li {
    margin-bottom: 0.5rem;
  }

  /* 重点文本 */
  #custom-article-content strong {
    color: #0f172a;
    font-weight: 800;
  }

  /* 代码块：工业深色风 */
  #custom-article-content pre {
    background-color: #0d1117;
    padding: 1.5rem;
    border-radius: 1rem;
    margin: 2.5rem 0;
    overflow-x: auto;
    border: 1px solid #1e293b;
  }
  
  #custom-article-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  /* 行内代码 */
  #custom-article-content :not(pre) > code {
    background-color: #f1f5f9;
    color: #4f46e5;
    padding: 0.2rem 0.4rem;
    border-radius: 0.4rem;
    font-weight: 600;
  }

  /* 引用 */
  #custom-article-content blockquote {
    border-left: 4px solid #e2e8f0;
    padding-left: 1.5rem;
    font-style: italic;
    color: #64748b;
    margin: 2rem 0;
  }

  /* 图片 */
  #custom-article-content img {
    border-radius: 1rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    margin: 3rem auto;
  }
</style>