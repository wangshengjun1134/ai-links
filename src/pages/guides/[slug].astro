---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import GuideRankCard from '../../components/GuideRankCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 模拟排行榜数据
const rankData = [
  { rank: 1, title: "什么是大语言模型？全面解析 LLM 的工作原理", author: "AI Science", views: "12.5k" },
  { rank: 2, title: "Prompt Engineering 入门：如何与 AI 高效对话", author: "Prompt Master", views: "9.8k" },
  { rank: 3, title: "AI 绘画工具对比：Midjourney vs Stable Diffusion", author: "Art Tech", views: "8.2k" },
  { rank: 4, title: "如何本地部署开源大模型？完整教程", author: "DevOps Pro", views: "6.5k" },
  { rank: 5, title: "Transformer 架构详解：从原理到实现", author: "Deep Learning", views: "5.3k" },
];

// 提取文章中的标题作为目录
const headings = [
  { text: "引言", level: 2, href: "#引言" },
  { text: "什么是大语言模型？", level: 2, href: "#什么是大语言模型", children: [
    { text: "核心特点", level: 3, href: "#核心特点" }
  ]},
  { text: "LLM 的工作原理", level: 2, href: "#LLM 的工作原理", children: [
    { text: "Transformer 架构", level: 3, href: "#Transformer 架构" },
    { text: "预训练与微调", level: 3, href: "#预训练与微调" }
  ]},
  { text: "应用场景", level: 2, href: "#应用场景" },
  { text: "总结", level: 2, href: "#总结" },
];
---

<Layout title={post.data.title}>
  <div class="flex min-h-screen">
    <!-- 左侧：文章内容 -->
    <article class="flex-1 max-w-[calc(100%-20rem)]">
      <div class="max-w-3xl mx-auto px-6 py-8">
        <!-- 文章头部 -->
        <header class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="px-3 py-1 text-xs font-bold text-green-600 bg-green-50 rounded-full">
              {post.data.category}
            </span>
            <span class="text-xs text-gray-400">{post.data.readTime}</span>
          </div>
          
          <h1 class="text-3xl font-bold text-gray-900 mb-4">
            {post.data.title}
          </h1>
          
          <div class="flex items-center gap-3 text-sm text-gray-500">
            <span class="flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-white text-xs font-bold">
                {post.data.author.charAt(0)}
              </span>
              {post.data.author}
            </span>
            <span>•</span>
            <span>{post.data.publishedAt}</span>
          </div>
        </header>

        <!-- 文章内容 -->
        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </div>
    </article>

    <!-- 右侧：目录和排行榜 -->
    <aside class="w-80 shrink-0 border-l border-gray-100 bg-gray-50">
      <div class="sticky top-16 p-6 space-y-6">
        <!-- 目录 -->
        <div>
          <h3 class="text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span class="text-base">📑</span> 章节目录
          </h3>
          <nav class="space-y-1">
            {headings.map((heading) => (
              <div>
                <a
                  href={heading.href}
                  class="block text-sm text-gray-600 hover:text-blue-600 py-1 transition-colors"
                >
                  {heading.text}
                </a>
                {heading.children && (
                  <div class="ml-4 space-y-1">
                    {heading.children.map((child) => (
                      <a
                        href={child.href}
                        class="block text-xs text-gray-500 hover:text-blue-600 py-1 transition-colors"
                      >
                        {child.text}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </nav>
        </div>

        <!-- 阅读排行榜 -->
        <div>
          <h3 class="text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span class="text-base">🔥</span> 阅读排行榜
          </h3>
          <div class="flex flex-col gap-2">
            {rankData.map(r => <GuideRankCard {...r} />)}
          </div>
        </div>
      </div>
    </aside>
  </div>
</Layout>

<style>
  /* 文章样式 */
  .prose h2 {
    @apply text-xl font-bold text-gray-900 mt-8 mb-4;
  }
  
  .prose h3 {
    @apply text-lg font-bold text-gray-900 mt-6 mb-3;
  }
  
  .prose p {
    @apply text-gray-700 mb-4 leading-relaxed;
  }
  
  .prose ul, .prose ol {
    @apply mb-4 pl-6;
  }
  
  .prose li {
    @apply text-gray-700 mb-2;
  }
  
  .prose strong {
    @apply font-bold text-gray-900;
  }
</style>
