---
import Layout from '../layouts/Layout.astro';
import HubCard from '../components/HubCard.astro';
import aihub from '../data/aihub.json';

// 从数据中提取唯一的 productType 值
const getProductTypes = (): string[] => {
  const values = new Set<string>();
  aihub.forEach(a => {
    if (Array.isArray(a.productType)) {
      a.productType.forEach(t => values.add(t));
    }
  });
  return Array.from(values).filter(t => !t.includes('Tier')).sort();
};

const productTypes = getProductTypes();
---

<Layout title="AI Hub - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <!-- 产品类型 -->
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">产品类型</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="producttype" id="producttype-filters">
        {productTypes.map((type) => (
          <button
            data-producttype={type}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{type}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">AI Hub</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input type="text" id="aihub-search" placeholder="按名称过滤..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200" />
      </div>

      <div class="flex-1"></div>
    </div>

    <!-- 平铺显示所有内容（分页） -->
    <div id="aihub-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-4 gap-y-3">
      {aihub.map(a => {
        const productType = a.productType || [];
        
        return (
          <div
            class="aihub-item"
            data-aihub-name={a.aiProductName.toLowerCase()}
            data-producttype={JSON.stringify(productType).toLowerCase()}
            data-introduction={a.introduction.toLowerCase()}
          >
            <HubCard {...a} />
          </div>
        );
      })}
    </div>

    <!-- 分页组件 -->
    <div id="pagination" class="mt-12 flex items-center justify-center gap-4">
      <button id="prev-btn" class="p-2.5 rounded-xl border border-[#E5E5E5] bg-white hover:border-[#171717] hover:text-[#171717] hover:shadow-sm disabled:opacity-30 disabled:cursor-not-allowed transition-all duration-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <div id="page-info" class="text-[13px] font-medium text-[#525252]"></div>
      <button id="next-btn" class="p-2.5 rounded-xl border border-[#E5E5E5] bg-white hover:border-[#171717] hover:text-[#171717] hover:shadow-sm disabled:opacity-30 disabled:cursor-not-allowed transition-all duration-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</Layout>

<style>
  .aihub-item.v-hidden {
    display: none !important;
  }
</style>

<script>
  import { initMultiFilter } from '../lib/multiFilter';
  import { initCardClick } from '../scripts/cardClick';

  initMultiFilter();
  initCardClick();

  const CONFIG = {
    pageSize: 30,
  };

  let state = {
    currentPage: 1,
    allCards: [],
    filteredCards: [],
  };

  function init() {
    // 获取所有卡片
    state.allCards = Array.from(document.querySelectorAll('#aihub-list .aihub-item'));
    state.filteredCards = [...state.allCards];

    const searchInput = document.getElementById('aihub-search');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    // 搜索事件
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.toLowerCase().trim();

        state.filteredCards = state.allCards.filter(card => {
          const title = card.getAttribute('data-aihub-name') || '';
          const introduction = card.getAttribute('data-introduction') || '';
          return title.includes(val) || introduction.includes(val);
        });

        state.currentPage = 1;
        render();
      });
    }

    // 监听侧边栏过滤事件
    document.addEventListener('filtersChanged', () => {
      // 根据当前可见的卡片更新 filteredCards
      state.filteredCards = state.allCards.filter(card => {
        return card.style.display !== 'none';
      });

      // 重置到第一页
      state.currentPage = 1;
      render();
    });

    // 翻页事件
    prevBtn.onclick = () => {
      if (state.currentPage > 1) {
        state.currentPage--;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };

    nextBtn.onclick = () => {
      const totalPages = Math.ceil(state.filteredCards.length / CONFIG.pageSize);
      if (state.currentPage < totalPages) {
        state.currentPage++;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };

    render();
  }

  function render() {
    const totalPages = Math.ceil(state.filteredCards.length / CONFIG.pageSize);
    const start = (state.currentPage - 1) * CONFIG.pageSize;
    const end = start + CONFIG.pageSize;

    // 1. 处理显隐
    state.allCards.forEach(card => card.classList.add('v-hidden'));
    state.filteredCards.slice(start, end).forEach(card => card.classList.remove('v-hidden'));

    // 2. 更新按钮状态
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    prevBtn.disabled = state.currentPage === 1;
    nextBtn.disabled = state.currentPage === totalPages || totalPages === 0;

    // 3. 更新页码显示
    const pageInfo = document.getElementById('page-info');
    if (pageInfo) {
      pageInfo.textContent = totalPages > 0
        ? `第 ${state.currentPage} / ${totalPages} 页（共 ${state.filteredCards.length} 个）`
        : '无结果';
    }
  }

  // 启动
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
