---
import Layout from '../layouts/Layout.astro';
import HubCard from '../components/HubCard.astro';
import Pagination from '../components/Pagination.astro';
import aihub from '../data/aihub.json';

// 从数据中提取唯一的 productType 值
const getProductTypes = (): string[] => {
  const values = new Set<string>();
  aihub.forEach(a => {
    if (Array.isArray(a.productType)) {
      a.productType.forEach(t => values.add(t));
    }
  });
  return Array.from(values).filter(t => !t.includes('Tier')).sort();
};

const productTypes = getProductTypes();
---

<Layout title="AI Hub - AI Links">
  <aside slot="sidebar" class="w-80 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <div class="flex flex-col gap-2.5 mb-7">
      <h4 class="text-[13px] font-bold text-[#A3A3A3] uppercase tracking-widest">产品类型</h4>
      <div class="flex flex-wrap gap-1.5" data-filter="producttype">
        {productTypes.map((type) => (
          <button
            data-producttype={type}
            class="filter-btn bg-white border border-[#E5E5E5] px-2.5 py-1.5 rounded-lg text-[12.5px] text-[#525252] font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 hover:border-[#171717] hover:text-[#171717] hover:shadow-sm active:scale-95"
          >
            <span>{type}</span>
            <span class="close-icon hidden ml-1 text-[#A3A3A3] hover:text-[#171717]">×</span>
          </button>
        ))}
      </div>
    </div>
  </aside>

  <div class="p-6">
    <div class="flex items-center gap-4 mb-6">
      <h2 class="text-2xl font-bold text-[#171717]">AI Hub</h2>

      <div class="relative w-full max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[16px] text-[#A3A3A3]">🔍</span>
        <input type="text" id="aihub-search" placeholder="按名称过滤..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/8 outline-none transition-all duration-200" />
      </div>

      <div class="flex-1"></div>
    </div>

    <div id="aihub-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-3 gap-x-4 gap-y-3">
      {aihub.map(a => {
        const productType = a.productType || [];

        return (
          <div
            class="aihub-item"
            data-aihub-name={a.aiProductName.toLowerCase()}
            data-producttype={JSON.stringify(productType).toLowerCase()}
            data-introduction={a.introduction.toLowerCase()}
          >
            <HubCard {...a} />
          </div>
        );
      })}
    </div>

    <Pagination itemTypeLabel="项目" />
  </div>
</Layout>

<style>
  .aihub-item.v-hidden {
    display: none !important;
  }
</style>

<script>
  import { initMultiFilter } from '../lib/multiFilter';
  import { initCardClick } from '../scripts/cardClick';
  import { initPagination } from '../lib/pagination';

  initMultiFilter();
  initCardClick();
  initPagination({
    listId: 'aihub-list',
    itemClass: 'aihub-item',
    searchId: 'aihub-search',
    pageSize: 30,
    itemTypeLabel: '项目',
    searchAttrs: ['data-aihub-name', 'data-introduction'],
  });
</script>