---
import { getCollection } from 'astro:content';
import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import agents from '../../data/agents.json';

export async function getStaticPaths() {
  const posts = await getCollection('agents');
  const agentUids = new Set(agents.map(a => a.uid));

  return posts
    .filter(entry => {
      // 嵌套路径：entry.slug 为 "20001000/20001000"，取第一部分作为 uid
      const uid = entry.slug.split('/')[0];
      return agentUids.has(uid);
    })
    .map(entry => {
      const uid = entry.slug.split('/')[0];
      const agent = agents.find(a => a.uid === uid);
      // 优先使用 slug，如果没有则使用 uid
      const urlSlug = agent?.slug && agent.slug.trim() !== '' ? agent.slug : uid;
      return {
        params: { slug: urlSlug },
        props: { entry, uid },
      };
    });
}

const { entry, uid } = Astro.props;
const { Content, headings } = await entry.render();

const agent = agents.find(a => a.uid === uid);

if (!agent) {
  return Astro.redirect('/404');
}

// 提取 productType 信息
const productType = agent.metrics?.productType;
const isProductTypeObject = productType && typeof productType === 'object' && !Array.isArray(productType);
const level1 = isProductTypeObject ? productType.level1 : null;
const level2 = isProductTypeObject ? productType.level2 : null;
const tags = isProductTypeObject ? productType.tags || [] : [];
---

<DetailPageLayout
  title={agent.aiProductName}
  logo={agent.logo}
  productName={agent.aiProductName}
  introduction={agent.introduction}
  company={agent.metrics?.company || '未知'}
  country={agent.metrics?.country || 'N/A'}
  websiteUrl={agent.websiteUrl}
  uid={agent.uid}
  uidLabel="Agent UID"
  level1={level1}
  level2={level2}
  tags={tags}
  content={Content}
  headings={headings}
/>