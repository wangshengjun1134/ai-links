---
// 详情页使用预渲染（SSG）
export const prerender = true;

import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import { marked } from 'marked';
import { getAgentBySlug, getAllAgentSlugs } from '../../lib/db';
import fs from 'fs';
import path from 'path';

// 构建时从数据库获取 slug 列表
export async function getStaticPaths() {
  const slugs = await getAllAgentSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

// 从数据库获取智能体信息
const a = await getAgentBySlug(slug);

if (!a) {
  return Astro.redirect('/404');
}

// 尝试读取 Markdown 正文内容
let detailContent = '';
const mdPath = path.join(process.cwd(), 'src', 'content', 'agents', a.uid, `${a.uid}.md`);
if (fs.existsSync(mdPath)) {
  detailContent = fs.readFileSync(mdPath, 'utf-8');
}

const agent = {
  uid: a.uid,
  slug: a.slug,
  logo: a.logo,
  aiProductName: a.aiProductName,
  introduction: a.introduction,
  websiteUrl: a.websiteUrl,
  detail: detailContent || a.introduction,
  metrics: a.metrics,
};

// 渲染 Markdown 正文为 HTML
const contentHtml = agent.detail
  ? await marked.parse(agent.detail)
  : `<p>${agent.introduction}</p>`;
---

<DetailPageLayout
  title={agent.aiProductName}
  logo={agent.logo}
  productName={agent.aiProductName}
  introduction={agent.introduction}
  company={agent.metrics?.company || '未知'}
  country={agent.metrics?.country || 'N/A'}
  websiteUrl={agent.websiteUrl}
  uid={agent.uid}
  uidLabel="Agent UID"
  level1={null}
  level2={null}
  tags={[]}
  contentHtml={contentHtml}
/>