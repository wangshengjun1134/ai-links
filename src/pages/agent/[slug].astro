---
import { getCollection } from 'astro:content';
import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import agents from '../../data/agents.json';

export async function getStaticPaths() {
  const posts = await getCollection('agents');
  const agentUids = new Set(agents.map(a => a.uid));
  return posts
    .filter(entry => agentUids.has(entry.data.uid))
    .map(entry => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const agentData = entry.data;

// 从 agents.json 中获取完整的 metrics 数据
const fullAgent = agents.find(a => a.uid === agentData.uid);
const metrics = fullAgent?.metrics;

// 提取 productType 信息
const productType = metrics?.productType;
const isProductTypeObject = productType && typeof productType === 'object' && !Array.isArray(productType);
const level1 = isProductTypeObject ? productType.level1 : null;
const level2 = isProductTypeObject ? productType.level2 : null;
const tags = isProductTypeObject ? productType.tags || [] : [];
---

<DetailPageLayout
  title={agentData.aiProductName}
  logo={agentData.logo}
  productName={agentData.aiProductName}
  introduction={agentData.introduction}
  company={agentData.company}
  country={agentData.country}
  modelLevel={agentData.modelLevel}
  websiteUrl={agentData.websiteUrl}
  uid={agentData.uid}
  uidLabel="Agent UID"
  level1={level1}
  level2={level2}
  tags={tags}
  content={Content}
  headings={headings}
/>