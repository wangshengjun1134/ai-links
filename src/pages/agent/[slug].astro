---
// 详情页使用预渲染（SSG）
export const prerender = true;

import { getCollection } from 'astro:content';
import DetailPageLayout from '../../layouts/DetailPageLayout.astro';
import { getAgentBySlug, getAllAgentSlugs } from '../../lib/db';

// 构建时从数据库获取 slug 列表
export async function getStaticPaths() {
  const slugs = await getAllAgentSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

// 从数据库获取智能体信息
const a = await getAgentBySlug(slug);

if (!a) {
  return Astro.redirect('/404');
}

// 通过 uid 找到对应的 Markdown 文件
// content collection 的 slug 格式是小写的 "uid/uid"
const posts = await getCollection('agents');
const uid = a.uid;
const lowerUid = uid.toLowerCase();
const entry = posts.find(e => e.slug === `${lowerUid}/${lowerUid}` || e.id === `${uid}/${uid}.md`);

// 获取 Content 组件和 headings
const { Content, headings } = entry ? await entry.render() : { Content: null, headings: [] };

const agent = {
  uid: a.uid,
  slug: a.slug,
  logo: a.logo,
  aiProductName: a.aiProductName,
  introduction: a.introduction,
  websiteUrl: a.websiteUrl,
  metrics: a.metrics,
};
---

<DetailPageLayout
  title={agent.aiProductName}
  logo={agent.logo}
  productName={agent.aiProductName}
  introduction={agent.introduction}
  company={agent.metrics?.company || '未知'}
  country={agent.metrics?.country || 'N/A'}
  websiteUrl={agent.websiteUrl}
  uid={agent.uid}
  uidLabel="Agent UID"
  level1={null}
  level2={null}
  tags={[]}
  content={Content}
  headings={headings}
/>