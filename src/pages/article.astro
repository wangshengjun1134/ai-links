---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleRankCard from '../components/ArticleRankCard.astro';
import articles from '../data/article.json';
import { sidebarFilters } from '../data/navigation';

const { types } = sidebarFilters.article;

// 排行榜数据
const rankData = [
  { rank: 1, title: "什么是大语言模型？全面解析 LLM 的工作原理", author: "AI Science", views: "12.5k" },
  { rank: 2, title: "Prompt Engineering 入门：如何与 AI 高效对话", author: "Prompt Master", views: "9.8k" },
  { rank: 3, title: "AI 绘画工具对比：Midjourney vs Stable Diffusion", author: "Art Tech", views: "8.2k" },
  { rank: 4, title: "如何本地部署开源大模型？完整教程", author: "DevOps Pro", views: "6.5k" },
  { rank: 5, title: "Transformer 架构详解：从原理到实现", author: "Deep Learning", views: "5.3k" },
];
---

<Layout 
  title="AI 科普文章 - AI Links"
  description="AI 入门教程、技术解析和科普文章，涵盖大语言模型、提示词工程、AI 绘画等主题，助你快速掌握 AI 知识"
  keywords={["AI 教程", "人工智能教程", "大语言模型", "LLM", "提示词工程", "AI 科普", "机器学习"]}
>
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <h3 class="text-[12.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-widest">分类专区</h3>
    <div class="space-y-1.5">
      <!-- 全部按钮 -->
      <button
        data-category="all"
        class="category-btn group flex items-center gap-3 px-3 py-2.5 text-[13px] text-[#525252] bg-[#171717]/10 rounded-xl transition-all duration-200 cursor-pointer w-full"
      >
        <span class="text-lg">📚</span> 全部
      </button>
      {types.map((item) => (
        <button
          data-category={item.name}
          class="category-btn group flex items-center gap-3 px-3 py-2.5 text-[13px] text-[#525252] hover:bg-[#171717] hover:text-white rounded-xl transition-all duration-200 cursor-pointer w-full"
        >
          <span class="text-lg group-hover:scale-110 transition-transform">{item.icon}</span> {item.name}
        </button>
      ))}
    </div>
  </aside>

  <div class="p-8 bg-[#F9FAFB] min-h-screen">
    <div class="flex items-center gap-4 mb-8">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#171717] to-[#525252] flex items-center justify-center text-xl shadow-lg shadow-[#171717]/20">🌱</div>
        <div>
          <h2 class="text-xl font-bold text-[#171717]">科普 & 教程</h2>
        </div>
      </div>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-[#A3A3A3]">🔍</span>
        <input type="text" placeholder="搜索教程..." class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] text-[#171717] placeholder-[#A3A3A3] focus:border-[#171717] focus:ring-5 focus:ring-[#171717]/10 outline-none transition-all duration-200" />
      </div>

      <div class="flex-1"></div>

      <button class="px-5 py-2.5 text-[13.5px] font-bold text-white bg-[#171717] rounded-full hover:bg-[#262626] hover:shadow-lg hover:shadow-[#171717]/20 transition-all duration-200 cursor-pointer">
        发布教程
      </button>
    </div>

    {articles.length > 0 ? (
      <div class="flex gap-8">
        <div class="flex-1">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="articles-grid">
            {articles.map(a => (
              <div
                data-category={a.category}
                class="article-card group relative p-5 rounded-2xl border border-[#F0F0F0] bg-white hover:border-[#171717]/30 hover:shadow-[0_8px_24px_-4px_rgba(0,0,0,0.08)] transition-all duration-300 hover:-translate-y-1 cursor-pointer"
              >
                <a href={`/article/${a.slug || a.uid}`} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-10"></a>

                <div class="flex items-start justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 text-[10px] font-bold text-[#171717] bg-[#F5F5F5] border border-[#E5E5E5] rounded-full uppercase tracking-wider">{a.category}</span>
                    <span class="flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-medium text-[#A3A3A3] bg-[#F9FAFB] rounded-full">
                      <span class="w-1 h-1 rounded-full bg-[#171717]"></span>
                      {a.readTime}
                    </span>
                  </div>
                </div>

                <h3 class="text-base font-bold text-[#171717] mb-2 group-hover:text-[#171717] transition-colors line-clamp-2">
                  {a.title}
                </h3>

                {a.titleEn && (
                  <p class="text-[13.5px] font-semibold text-[#525252] mb-2 line-clamp-1">
                    {a.titleEn}
                  </p>
                )}

                <p class="text-[13.5px] text-[#525252] mb-4 line-clamp-2">
                  {a.description}
                </p>

                <div class="flex items-center justify-between pt-3 border-t border-[#F0F0F0]">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-gradient-to-br from-[#171717] to-[#525252] flex items-center justify-center text-white text-[10px] font-bold shadow-md shadow-[#171717]/20">
                      {a.author.charAt(0)}
                    </div>
                    <span class="text-[12.5px] text-[#525252]">{a.author}</span>
                  </div>
                  <span class="text-[12.5px] text-[#A3A3A3]">{a.publishedAt}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="w-80 shrink-0">
          <div class="sticky top-20 space-y-6">
            <div class="bg-white border border-[#E5E5E5] rounded-2xl p-5 shadow-sm">
              <h3 class="text-[13px] font-bold text-[#171717] mb-4 flex items-center gap-2">
                <span class="text-lg">🔥</span> 阅读排行榜
              </h3>
              <div class="flex flex-col gap-2">
                {rankData.map(r => <ArticleRankCard {...r} />)}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="text-center py-20 rounded-2xl border border-[#E5E5E5] bg-white">
        <div class="text-6xl mb-4">📚</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无教程</h3>
        <p class="text-[#525252]">分享你的第一个 AI 教程！</p>
      </div>
    )}
  </div>
</Layout>

<script>
  // 分类过滤逻辑
  document.addEventListener('DOMContentLoaded', () => {
    const categoryBtns = document.querySelectorAll('.category-btn');
    const articleCards = document.querySelectorAll('.article-card');

    // 更新按钮样式
    function updateButtonStyles(activeCategory: string) {
      categoryBtns.forEach(btn => {
        const category = btn.getAttribute('data-category');
        if (category === activeCategory) {
          btn.className = 'category-btn group flex items-center gap-3 px-3 py-2.5 text-[13px] text-white bg-[#171717] rounded-xl transition-all duration-200 cursor-pointer w-full';
        } else {
          btn.className = 'category-btn group flex items-center gap-3 px-3 py-2.5 text-[13px] text-[#525252] hover:bg-[#171717] hover:text-white rounded-xl transition-all duration-200 cursor-pointer w-full';
        }
      });
    }

    // 过滤文章
    function filterArticles(category: string) {
      articleCards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        if (category === 'all' || cardCategory === category) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 绑定点击事件
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category') || 'all';
        updateButtonStyles(category);
        filterArticles(category);
      });
    });

    // 默认选中"全部"
    updateButtonStyles('all');
  });
</script>