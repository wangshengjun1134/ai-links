---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleRankCard from '../components/ArticleRankCard.astro';
import Pagination from '../components/Pagination.astro';
import { getArticlesPaginated, getArticlesCount, getArticleCategories } from '../lib/db';

// 解析 URL 参数
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const pageSize = 30;
const category = Astro.url.searchParams.get('category') || '';
const search = Astro.url.searchParams.get('search') || '';

// 数据库查询
const result = await getArticlesPaginated({
  page,
  pageSize,
  category: category || undefined,
  search: search || undefined,
});

const articles = result.items;
const total = result.total;
const totalPages = result.totalPages;

// 获取筛选列表和总数
const categories = await getArticleCategories();
const totalCount = await getArticlesCount();

// 排行榜数据（取前5条）
const rankData = articles.slice(0, 5).map((a, index) => ({
  rank: index + 1,
  title: a.title,
  author: a.author,
  views: `${(Math.floor(Math.random() * 20) + 5)}.${Math.floor(Math.random() * 9)}k`,
}));

// 动态 SEO 标题
let pageTitle = 'AI 科普文章 - AI Links';
let pageDescription = `探索 ${totalCount}+ AI 入门教程、技术解析和科普文章`;

if (search) {
  pageTitle = `搜索"${search}"的文章 - AI Links`;
} else if (category) {
  pageTitle = `${category}类文章 - AI Links`;
}

if (page > 1) {
  pageTitle += ` - 第${page}页`;
}

// 构建筛选 URL
const buildFilterUrl = (cat: string) => {
  const params = new URLSearchParams();
  if (search) params.set('search', search);

  if (category === cat) {
    // 取消选中
  } else {
    params.set('category', cat);
  }

  const queryString = params.toString();
  return queryString ? `/article?${queryString}` : '/article';
};

// 查询参数
const queryParams: Record<string, string | string[]> = {};
if (category) queryParams.category = category;
if (search) queryParams.search = search;
---

<Layout title={pageTitle} description={pageDescription} keywords={["AI 教程", "人工智能教程", "大语言模型", "LLM", "提示词工程", "AI 科普", category].filter(Boolean) as string[]}>
  <aside slot="sidebar" class="w-64 shrink-0 border-r border-[#E5E5E5] h-[calc(100vh-var(--sidebar-top-single))] sticky top-[var(--sidebar-top-single)] p-6 transition-all duration-200 bg-white/50 backdrop-blur-sm rounded-2xl overflow-y-auto">
    <h3 class="text-[12.5px] font-bold text-[#A3A3A3] mb-4 uppercase tracking-widest">分类专区</h3>
    <div class="space-y-1.5">
      <a
        href={buildFilterUrl('')}
        class={`category-btn group flex items-center gap-3 px-3 py-2.5 text-[13px] rounded-xl transition-all duration-200 ${
          !category
            ? 'text-white bg-[#171717]'
            : 'text-[#525252] hover:bg-[#171717] hover:text-white'
        }`}
      >
        <span class="text-lg">📚</span> 全部
      </a>
      {categories.map((cat) => {
        const isActive = category === cat;
        return (
          <a
            href={buildFilterUrl(cat)}
            class={`category-btn group flex items-center gap-3 px-3 py-2.5 text-[13px] rounded-xl transition-all duration-200 ${
              isActive
                ? 'text-white bg-[#171717]'
                : 'text-[#525252] hover:bg-[#171717] hover:text-white'
            }`}
          >
            <span class="text-lg group-hover:scale-110 transition-transform">📄</span> {cat}
          </a>
        );
      })}
    </div>
  </aside>

  <div class="p-8 bg-[#F9FAFB] min-h-screen">
    <div class="flex items-center gap-4 mb-8">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#171717] to-[#525252] flex items-center justify-center text-xl shadow-lg shadow-[#171717]/20">🌱</div>
        <div>
          <h2 class="text-xl font-bold text-[#171717]">科普 & 教程</h2>
        </div>
      </div>

      <div class="relative w-full max-w-md">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[14px] text-[#A3A3A3]">🔍</span>
        <form action="/article" method="get">
          {category && <input type="hidden" name="category" value={category} />}
          <input
            type="text"
            name="search"
            value={search}
            placeholder="搜索教程..."
            class="w-full bg-white border border-[#E5E5E5] rounded-full py-2.5 pl-11 pr-4 text-[13.5px] text-[#171717] placeholder-[#A3A3A3] focus:border-[#171717] outline-none"
          />
        </form>
      </div>

      <div class="flex-1"></div>
    </div>

    {articles.length > 0 ? (
      <div class="flex gap-8">
        <div class="flex-1">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="articles-grid">
            {articles.map(a => (
              <div
                data-category={a.category}
                class="article-card group relative p-5 rounded-2xl border border-[#F0F0F0] bg-white hover:border-[#171717]/30 hover:shadow-[0_8px_24px_-4px_rgba(0,0,0,0.08)] transition-all duration-300 hover:-translate-y-1 cursor-pointer"
              >
                <a href={`/article/${a.slug}`} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-10"></a>

                <div class="flex items-start justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 text-[10px] font-bold text-[#171717] bg-[#F5F5F5] border border-[#E5E5E5] rounded-full uppercase tracking-wider">{a.category}</span>
                    <span class="flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-medium text-[#A3A3A3] bg-[#F9FAFB] rounded-full">
                      <span class="w-1 h-1 rounded-full bg-[#171717]"></span>
                      {a.readTime}
                    </span>
                  </div>
                </div>

                <h3 class="text-base font-bold text-[#171717] mb-2 group-hover:text-[#171717] transition-colors line-clamp-2">
                  {a.title}
                </h3>

                {a.titleEn && (
                  <p class="text-[13.5px] font-semibold text-[#525252] mb-2 line-clamp-1">
                    {a.titleEn}
                  </p>
                )}

                <p class="text-[13.5px] text-[#525252] mb-4 line-clamp-2">
                  {a.description}
                </p>

                <div class="flex items-center justify-between pt-3 border-t border-[#F0F0F0]">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-gradient-to-br from-[#171717] to-[#525252] flex items-center justify-center text-white text-[10px] font-bold shadow-md shadow-[#171717]/20">
                      {a.author.charAt(0)}
                    </div>
                    <span class="text-[12.5px] text-[#525252]">{a.author}</span>
                  </div>
                  <span class="text-[12.5px] text-[#A3A3A3]">{a.publishedAt}</span>
                </div>
              </div>
            ))}
          </div>

          <Pagination
            currentPage={page}
            totalPages={totalPages}
            totalItems={total}
            pageSize={pageSize}
            itemTypeLabel="文章"
            baseUrl="/article"
            queryParams={queryParams}
          />
        </div>

        <div class="w-80 shrink-0">
          <div class="sticky top-20 space-y-6">
            <div class="bg-white border border-[#E5E5E5] rounded-2xl p-5 shadow-sm">
              <h3 class="text-[13px] font-bold text-[#171717] mb-4 flex items-center gap-2">
                <span class="text-lg">🔥</span> 阅读排行榜
              </h3>
              <div class="flex flex-col gap-2">
                {rankData.map(r => <ArticleRankCard {...r} />)}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="text-center py-20 rounded-2xl border border-[#E5E5E5] bg-white">
        <div class="text-6xl mb-4">📚</div>
        <h3 class="text-xl font-bold text-[#171717] mb-2">暂无教程</h3>
        <p class="text-[#525252]">当前筛选条件下暂无文章</p>
      </div>
    )}
  </div>
</Layout>